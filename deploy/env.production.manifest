# Contract for /etc/bengaluru-votes/.env.production, generated on every deploy
# from the GitHub `production` environment (scripts/ci/env-render.ts).
#
#   NAME  secret|var  required|optional
#
# `secret` values live in the environment's secrets, `var` values in its
# variables. A required key that is empty fails the deploy before the box is
# touched. Optional keys that are empty are left out of the file.
#
# OTP_TEST_SINK and SENDS_DISABLED are deliberately absent AND forbidden: the
# renderer refuses to deploy if either has a value (runbook, "Required
# environment variables").
#
# Adding a variable the app reads: add it here AND to the runbook table in the
# same PR, then set it in the environment (Settings -> Environments -> production).
# Keys found on the box on 2026-11-04 are marked "box"; the rest are documented
# in the runbook but not set today.

# --- Core ---
NODE_ENV                      var     required   # box
SITE_ORIGIN                   var     required   # box
DATABASE_URL                  secret  required   # box
POSTGRES_USER                 var     required   # box
POSTGRES_PASSWORD             secret  required   # box
POSTGRES_DB                   var     required   # box
SESSION_SECRET                secret  required   # box
MASTER_PASSWORD               secret  optional   # box; temporary until email OTP works

# --- Vendors ---
ANTHROPIC_API_KEY             secret  required   # box
GOOGLE_GEOCODING_API_KEY      secret  required   # box
GOOGLE_SEARCH_API_KEY         secret  required   # box
GOOGLE_SEARCH_CX              var     optional   # box (empty today)
GOOGLE_MAPS_BROWSER_KEY       var     required   # box; ships to browsers, referrer-restricted
GOOGLE_MAPS_MAP_ID            var     required   # box
MAPS_ENABLED                  var     required   # box
RECAPTCHA_SITE_KEY            var     required   # box; ships to browsers
RECAPTCHA_SECRET_KEY          secret  required   # box
FLAGS_ABUSE_SECRET            secret  required   # box
GA_MEASUREMENT_ID             var     required   # box

# --- Budgets and switches ---
GEOCODE_DAILY_BUDGET          var     required   # box
NEWS_QUERY_DAILY_BUDGET       var     required   # box
OTP_DAILY_SEND_BUDGET         var     required   # box
RETENTION_ENABLED             var     required   # box; must be false until legal sign-off
EPIC_DAILY_BUDGET             var     optional
ANONYMOUS_VOTE_DAILY_BUDGET   var     optional
FLAGS_SUBMISSIONS_PAUSED      var     optional
EXTRACTION_MODEL              var     optional
EXTRACTION_CONCURRENCY        var     optional
ELECTORAL_API_ORIGIN          var     optional
ELECTORAL_API_TIMEOUT_MS      var     optional

# --- Email and messaging (not set today; SendGrid is also the failure-alert mailer) ---
SENDGRID_API_KEY              secret  optional
SENDGRID_FROM_EMAIL           var     optional
SENDGRID_WEBHOOK_PUBLIC_KEY   secret  optional
TWILIO_ACCOUNT_SID            secret  optional
TWILIO_AUTH_TOKEN             secret  optional
TWILIO_WHATSAPP_FROM          var     optional
TWILIO_OTP_TEMPLATE_SID       var     optional

# --- Observability and backups (not set today) ---
SENTRY_DSN                    secret  optional
HEALTHCHECKS_URL              secret  optional
RESTIC_REPOSITORY             var     optional
RESTIC_PASSWORD               secret  optional
AWS_ACCESS_KEY_ID             secret  optional
AWS_SECRET_ACCESS_KEY         secret  optional
