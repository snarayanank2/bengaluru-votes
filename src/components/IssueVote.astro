---
import { t, type Lang } from '../i18n';
import Button from './Button.astro';
interface Props { lang: Lang; issues: Array<{ id: number; title: string }> }
const { lang, issues } = Astro.props;
---
<div class="inline-vote">
    <div data-vote-form-wrap>
      <form data-vote-form novalidate>
        <div data-vote-issue-options role="group" aria-label={t(lang, 'vote.modal.issuesLabel')}>
          {issues.map((issue) => <label class="vote-issue-option"><input type="checkbox" value={issue.id} /><span>{issue.title}</span></label>)}
        </div>
        <div class="vote-actions">
          <Button type="submit" variant="primary" lang={lang} data-vote-submit disabled>
            {t(lang, 'vote.modal.submitTemplate').replace('{n}', '0')}
          </Button>
          <Button type="button" variant="tertiary" lang={lang} data-vote-clear disabled>
            {t(lang, 'vote.modal.clear')}
          </Button>
        </div>
      </form>
    </div>
  <span hidden data-msg-rate-limit>{t(lang, 'vote.modal.rateLimited')}</span>
  <span hidden data-msg-generic-error>{t(lang, 'vote.modal.genericError')}</span>
  <span hidden data-msg-verification-error>{t(lang, 'vote.modal.verificationError')}</span>
  <span hidden data-msg-submit-template>{t(lang, 'vote.modal.submitTemplate')}</span>
  <p class="form-error" data-vote-rate-limit-error role="alert" hidden></p>
  <p class="form-error" data-vote-verification-error role="alert" hidden></p>
  <p class="form-error" data-vote-generic-error role="alert" hidden></p>
  <p data-vote-success role="status" tabindex="-1" hidden>{t(lang, 'vote.modal.success')}</p>
</div>
<style>
  .inline-vote { display: contents; }
  [data-vote-form] { display: grid; gap: var(--space-4); justify-items: start; }
  [data-vote-issue-options] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2) var(--space-4); width: 100%; }
  .vote-issue-option { position: relative; display: flex; align-items: center; min-height: 48px; padding: var(--space-3) var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius-sm); cursor: pointer; transition: background-color 0.12s, border-color 0.12s, color 0.12s; }
  .vote-issue-option:hover { border-color: var(--color-primary); }
  .vote-issue-option:has(input:checked) { border-color: var(--color-primary); background: var(--color-primary); color: var(--color-on-primary); font-weight: 600; }
  .vote-issue-option:has(input:focus-visible) { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .vote-issue-option:has(input:disabled:not(:checked)) { opacity: 0.55; cursor: default; }
  .vote-issue-option:has(input:disabled:not(:checked)):hover { border-color: var(--color-border); }
  /* The checkbox stays in the DOM for keyboard and screen-reader use; the whole tile shows the state. */
  input { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; opacity: 0; cursor: inherit; }
  .form-error { color: var(--color-danger); }
  [data-vote-success] { margin: 0; }
  @media (max-width: 767px) { [data-vote-issue-options] { grid-template-columns: minmax(0, 1fr); } }
</style>
<script>
  import { initIssueVote } from '../islands/IssueVote';
  initIssueVote();
</script>
