---
/**
 * One affidavit field as a curator corrects it: the field's structured
 * inputs, the required "publishes immediately" tick, and the button. A form
 * of its own, so a page may hold one (a flag) or several (the candidate
 * editor); `formAction` tells the route twin which was posted.
 *
 * After a refused save the caller passes `raw` (exactly what was posted)
 * and the form shows that instead of the published value.
 *
 * No box of its own inside a card: alone it is flat, and several in one card
 * (`embedded`) are told apart by a rule above each, not by nested borders
 * (design-system §7.5).
 */
import AffidavitFieldInputs from './AffidavitFieldInputs.astro';
import PublishConfirm from './PublishConfirm.astro';
import VerificationLabel from './VerificationLabel.astro';
import { t, type Lang } from '../i18n';
import { CSRF_FIELD_NAME } from '../lib/csrf';
import type { FieldError, RawField } from '../lib/affidavit-form';
import type { FixField } from '../lib/curator-fix';

interface Props {
  embedded?: boolean;
  lang: Lang;
  csrfToken: string;
  formAction: string;
  field: FixField;
  label: string;
  /** The public path the value appears on, named in the confirmation. */
  confirmPath: string;
  submitLabel: string;
  error?: FieldError;
  raw?: RawField;
}

const { embedded = false, lang, csrfToken, formAction, field, label, confirmPath, submitLabel, error, raw } = Astro.props;
const Wrapper = embedded ? 'div' : 'form';
---

<Wrapper method={embedded ? undefined : "post"}>
  {!embedded && <input type="hidden" name={CSRF_FIELD_NAME} value={csrfToken} />}
  {!embedded && <input type="hidden" name="formAction" value={formAction} />}
  <fieldset class:list={['field', { 'field--divided': embedded, 'field--error': error }]} data-field={field.key}>
    <legend>
      <span class="field-name">{label}</span>
      {(field.aiExtracted || field.checked) && <VerificationLabel lang={lang} aiExtracted={!field.checked} presentation="text" />}
    </legend>
    <AffidavitFieldInputs lang={lang} fieldKey={field.key} status={raw?.status ?? field.status} inputs={raw?.inputs ?? field.inputs} error={error} />
    {
      !embedded && (
        <PublishConfirm
          lang={lang}
          label={t(lang, 'curator.fix.confirm', { path: confirmPath })}
          hint={t(lang, 'curator.confirm.needsTick')}
          submitLabel={submitLabel}
        />
      )
    }
  </fieldset>
</Wrapper>

<style>
  form {
    min-width: 0;
  }

  .field {
    margin: 0;
    padding: 0;
    min-width: 0;
    border: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .field--divided {
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }

  .field--error {
    border-color: var(--color-danger);
  }

  .field legend {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0 var(--space-2);
    margin-left: calc(-1 * var(--space-2));
  }

  .field-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
  }
</style>
