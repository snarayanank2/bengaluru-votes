---
/**
 * Footer — design-system.md §7.2, information-architecture.md §1. Black
 * background with lime text, matching Open City's own footer
 * (opencity.in serves it as accent-3 on accent-2); the one dark surface in
 * the system. Footer is the only route to the trust/legal pages (About,
 * Check your registration, Voting guide, Data, Partner with us, Donate,
 * Press, Terms, Privacy), and carries
 * the Janaagraha + Oorvani Foundation partner lockup and Open City's
 * social links.
 *
 * Two columns in a 2:1 split at md and up (links left; partners and social
 * right), stacked on mobile.
 *
 * Both partner logos are dark-on-transparent PNGs, so each sits on its own
 * white chip rather than being recolored — a partner's mark is theirs, and
 * inverting it would drop Oorvani's red dot. Self-hosted under
 * `public/img/` (so `/img/janaagraha-logo.png`), never hot-linked: the CSP
 * is `img-src 'self'` (src/lib/csp.ts).
 *
 * The social icons are the same marks Open City uses in its own footer,
 * inlined as SVG (an <img> would be a second network hop for 24px of
 * artwork) and drawn in `currentColor` so they inherit the footer's lime.
 * Open City tints them sun-yellow; here yellow is reserved for statutory
 * deadlines and the AI-extracted badge (§7.6), so they take the footer's
 * own text color instead. These are the only external links in the footer;
 * they skip §7.4's external-link glyph because an icon-only link to a
 * platform's own mark is already unambiguous, and each carries an
 * `aria-label` naming the platform for screen readers.
 */
import { t, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const links = [
  { key: 'footer.about', path: '/about' },
  { key: 'footer.checkRegistration', path: '/check-registration' },
  { key: 'footer.votingGuide', path: '/voting-guide' },
  { key: 'footer.data', path: '/data' },
  { key: 'footer.partnerWithUs', path: '/partner-with-us' },
  { key: 'footer.donate', path: '/donate' },
  { key: 'footer.press', path: '/press' },
  { key: 'footer.terms', path: '/terms' },
  { key: 'footer.privacy', path: '/privacy' },
] as const;

/**
 * Open City's own accounts (the three linked from opencity.in's footer),
 * in that footer's order. `label` is a platform name — a proper noun in
 * both languages, so it isn't an i18n key; it's the accessible name of an
 * icon-only link. `d` is the icon's single SVG path on a 24×24 viewBox.
 */
const social = [
  {
    label: 'X',
    href: 'https://x.com/opencity_in',
    d: 'M13.982 10.622 20.54 3h-1.554l-5.693 6.618L8.745 3H3.5l6.876 10.007L3.5 21h1.554l6.012-6.989L15.868 21h5.245l-7.131-10.378Zm-2.128 2.474-.697-.997-5.543-7.93H8l4.474 6.4.697.996 5.815 8.318h-2.387l-4.745-6.787Z',
  },
  {
    label: 'LinkedIn',
    href: 'https://www.linkedin.com/company/74925255',
    d: 'M19.7,3H4.3C3.582,3,3,3.582,3,4.3v15.4C3,20.418,3.582,21,4.3,21h15.4c0.718,0,1.3-0.582,1.3-1.3V4.3 C21,3.582,20.418,3,19.7,3z M8.339,18.338H5.667v-8.59h2.672V18.338z M7.004,8.574c-0.857,0-1.549-0.694-1.549-1.548 c0-0.855,0.691-1.548,1.549-1.548c0.854,0,1.547,0.694,1.547,1.548C8.551,7.881,7.858,8.574,7.004,8.574z M18.339,18.338h-2.669 v-4.177c0-0.996-0.017-2.278-1.387-2.278c-1.389,0-1.601,1.086-1.601,2.206v4.249h-2.667v-8.59h2.559v1.174h0.037 c0.356-0.675,1.227-1.387,2.526-1.387c2.703,0,3.203,1.779,3.203,4.092V18.338z',
  },
  {
    label: 'Instagram',
    href: 'https://instagram.com/opencity.in',
    d: 'M12,4.622c2.403,0,2.688,0.009,3.637,0.052c0.877,0.04,1.354,0.187,1.671,0.31c0.42,0.163,0.72,0.358,1.035,0.673 c0.315,0.315,0.51,0.615,0.673,1.035c0.123,0.317,0.27,0.794,0.31,1.671c0.043,0.949,0.052,1.234,0.052,3.637 s-0.009,2.688-0.052,3.637c-0.04,0.877-0.187,1.354-0.31,1.671c-0.163,0.42-0.358,0.72-0.673,1.035 c-0.315,0.315-0.615,0.51-1.035,0.673c-0.317,0.123-0.794,0.27-1.671,0.31c-0.949,0.043-1.233,0.052-3.637,0.052 s-2.688-0.009-3.637-0.052c-0.877-0.04-1.354-0.187-1.671-0.31c-0.42-0.163-0.72-0.358-1.035-0.673 c-0.315-0.315-0.51-0.615-0.673-1.035c-0.123-0.317-0.27-0.794-0.31-1.671C4.631,14.688,4.622,14.403,4.622,12 s0.009-2.688,0.052-3.637c0.04-0.877,0.187-1.354,0.31-1.671c0.163-0.42,0.358-0.72,0.673-1.035 c0.315-0.315,0.615-0.51,1.035-0.673c0.317-0.123,0.794-0.27,1.671-0.31C9.312,4.631,9.597,4.622,12,4.622 M12,3 C9.556,3,9.249,3.01,8.289,3.054C7.331,3.098,6.677,3.25,6.105,3.472C5.513,3.702,5.011,4.01,4.511,4.511 c-0.5,0.5-0.808,1.002-1.038,1.594C3.25,6.677,3.098,7.331,3.054,8.289C3.01,9.249,3,9.556,3,12c0,2.444,0.01,2.751,0.054,3.711 c0.044,0.958,0.196,1.612,0.418,2.185c0.23,0.592,0.538,1.094,1.038,1.594c0.5,0.5,1.002,0.808,1.594,1.038 c0.572,0.222,1.227,0.375,2.185,0.418C9.249,20.99,9.556,21,12,21s2.751-0.01,3.711-0.054c0.958-0.044,1.612-0.196,2.185-0.418 c0.592-0.23,1.094-0.538,1.594-1.038c0.5-0.5,0.808-1.002,1.038-1.594c0.222-0.572,0.375-1.227,0.418-2.185 C20.99,14.751,21,14.444,21,12s-0.01-2.751-0.054-3.711c-0.044-0.958-0.196-1.612-0.418-2.185c-0.23-0.592-0.538-1.094-1.038-1.594 c-0.5-0.5-1.002-0.808-1.594-1.038c-0.572-0.222-1.227-0.375-2.185-0.418C14.751,3.01,14.444,3,12,3L12,3z M12,7.378 c-2.552,0-4.622,2.069-4.622,4.622S9.448,16.622,12,16.622s4.622-2.069,4.622-4.622S14.552,7.378,12,7.378z M12,15 c-1.657,0-3-1.343-3-3s1.343-3,3-3s3,1.343,3,3S13.657,15,12,15z M16.804,6.116c-0.596,0-1.08,0.484-1.08,1.08 s0.484,1.08,1.08,1.08c0.596,0,1.08-0.484,1.08-1.08S17.401,6.116,16.804,6.116z',
  },
] as const;
---

<footer class="site-footer">
  <div class="footer-inner">
    <nav aria-label="Footer">
      <ul role="list" class="footer-links">
        {
          links.map((link) => (
            <li>
              <a href={localePath(lang, link.path)}>{t(lang, link.key)}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="footer-partners">
      <p class="partners-label">{t(lang, 'footer.jointProject')}</p>
      <ul role="list" class="partner-logos">
        <li class="partner-chip">
          <img src="/img/janaagraha-logo.png" alt="Janaagraha" width="133" height="22" />
        </li>
        <li class="partner-chip">
          <img src="/img/oorvani-logo.png" alt="Oorvani Foundation" width="93" height="26" />
        </li>
      </ul>
      <ul role="list" class="social-links" aria-label="Open City on social media">
        {
          social.map((account) => (
            <li>
              <a
                href={account.href}
                aria-label={account.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
                  <path d={account.d} fill="currentColor" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-footer);
    color: var(--color-on-footer);
  }

  .footer-inner {
    max-width: var(--container-app);
    margin-inline: auto;
    padding: var(--space-8) var(--container-pad-x);
    display: grid;
    gap: var(--space-8);
  }

  /* 2:1 split at md (literal 768px — --bp-md can't be read in a query). */
  @media (min-width: 768px) {
    .footer-inner {
      grid-template-columns: 2fr 1fr;
      align-items: start;
    }
  }

  .footer-links {
    display: grid;
    gap: var(--space-3) var(--space-6);
  }

  /* Nine links read as a list, not a paragraph — two tidy columns once
     there's room for them (literal 480px = --bp-sm). Equal-width columns,
     so on desktop the pair spreads across the 2fr side instead of
     clumping at its left edge. */
  @media (min-width: 480px) {
    .footer-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .footer-links a {
    color: var(--color-on-footer);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    text-decoration: underline;
  }

  /* a11y floor (§10): dark surfaces use the sun-yellow focus outline. */
  .footer-links a:focus-visible,
  .social-links a:focus-visible {
    outline-color: var(--color-accent);
  }

  .partners-label {
    font-size: var(--text-xs);
    margin-bottom: var(--space-3);
  }

  .partner-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .partner-chip {
    display: inline-flex;
    align-items: center;
    background: var(--color-bg);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
  }

  .partner-chip img {
    display: block;
    height: auto;
    max-width: 100%;
  }

  .social-links {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin-top: var(--space-6);
    /* The 44px targets below center a 24px icon, so each carries 10px of
       dead space; pull the row back by exactly that, to line the icons up
       with the label and logo chips above rather than their tap boxes. */
    margin-left: -10px;
  }

  .social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    /* 44×44 minimum target (§7.3) around a 24px icon. */
    min-width: 44px;
    min-height: 44px;
    color: var(--color-on-footer);
  }

  .social-links a:hover {
    color: var(--color-bg);
  }
</style>
