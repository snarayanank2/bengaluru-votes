---
/**
 * The affidavit beside the form that is being filled from it: a link that
 * opens the PDF on its own, and the PDF itself. With `collapse`, a narrow
 * screen gets only the link (a phone cannot show a scan and a form at once).
 */
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  pdfUrl: string;
  collapse?: boolean;
  /** Lets a toggle elsewhere on the page point at this panel (`aria-controls`). */
  id?: string;
}

const { lang, pdfUrl, collapse = false, id } = Astro.props;
---

<section id={id} class:list={['scan', { 'scan--collapse': collapse }]} aria-label={t(lang, 'transcribe.reading.pdfTitle')}>
  <p class="scan-bar">
    <a href={pdfUrl} target="_blank" rel="noopener noreferrer">{t(lang, 'transcribe.reading.openPdf')}</a>
  </p>
  <iframe class="scan-frame" src={`${pdfUrl}#navpanes=0&view=FitH`} title={t(lang, 'transcribe.reading.pdfTitle')}></iframe>
</section>

<style>
  .scan {
    display: flex;
    flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .scan-bar {
    margin: 0;
    padding: 0 var(--space-4);
    font-size: var(--text-sm);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  /* Body link (design-system §7.4): forest and underlined, with a 44px target. */
  .scan-bar a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .scan-frame {
    flex: 1;
    width: 100%;
    min-height: 0;
    border: 0;
  }

  @media (max-width: 899px) {
    .scan--collapse {
      border-right: 0;
      border-bottom: 1px solid var(--color-border);
    }
    .scan--collapse .scan-frame {
      display: none;
    }
  }
</style>
