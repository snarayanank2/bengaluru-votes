---
/**
 * AppBar — design-system.md §7.1, information-architecture.md §1 (global
 * elements). Off-white, 80px, sticky. Left: the brand lockup — the
 * "Bengaluru Votes" text wordmark (the home link) followed by the OpenCity
 * and Janaagraha logos,
 * settling design-system.md §12's open question: wordmark asset, no
 * byline. Right: the EN | ಕನ್ನಡ language toggle and the Sign in control.
 *
 * Both marks show at EVERY width. Tablet and up gets the full wordmark;
 * below 768px it abbreviates to "BV" and the bar's spacing tightens, which
 * is what buys the room to keep the Open City mark on a phone. The
 * abbreviation is CSS-only (both spans always render) — see the stylesheet's
 * phone block for the width arithmetic.
 *
 * The partner marks sit OUTSIDE the home anchor deliberately: nesting them
 * would put them under that anchor's `aria-label="Bengaluru Votes"`, which
 * overrides descendant alt text. As sibling images they name themselves.
 *
 * Served from `public/img/` (so `/img/opencity-logo.png`), not imported
 * through `astro:assets` — this repo has no `sharp`, and Astro 5's default
 * image service needs it. Pre-trimmed and pre-scaled at 4x the 20px render
 * height; `width`/`height` are set to the RENDERED box so the reserved
 * space matches and the sticky bar never shifts while it loads.
 *
 * Cache-safety (architecture.md §5): this component never reads
 * cookies/session — the Sign in control always renders the anonymous
 * state server-side. Task 28's MeSlot island (src/islands/MeSlot.ts) finds
 * it via `data-me-slot` and swaps it client-side to an "Account" link for
 * signed-in visitors, so the server-rendered HTML stays identical for every
 * visitor and safe to cache. `data-msg-account` carries the already-
 * localized label MeSlot uses for that swap (same convention as
 * src/islands/WardLookup.ts's `data-msg-*` attributes — no client-side i18n
 * table import).
 */
import { t, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}

const { lang, path } = Astro.props;

// Fixed EN-then-ಕನ್ನಡ order regardless of current language (design-system.md
// §7.1: "EN | ಕನ್ನಡ", each label always in its own script). The current
// language renders as a styled, non-interactive segment; the other language
// renders as the link that navigates to the same page in that language.
const segments: Array<{ lang: Lang; label: string }> = [
  { lang: 'en', label: 'EN' },
  { lang: 'kn', label: 'ಕನ್ನಡ' },
];
---

<header class="app-bar">
  <div class="bar-inner">
    <div class="brand">
      <a class="logo" href={localePath(lang, '/')} aria-label="Bengaluru Votes">
        <span class="logo-full">Bengaluru Votes</span>
        <span class="logo-short">BV</span>
      </a>
      <span class="header-separator" aria-hidden="true"></span>
      <div class="partner-marks" aria-label="OpenCity and Janaagraha">
        <img class="oc-logo" src="/img/opencity-logo.png" alt="OpenCity" width="81" height="20" />
        <span class="header-star" aria-hidden="true">★</span>
        <img class="janaagraha-logo" src="/img/janaagraha-logo.png" alt="Janaagraha" width="133" height="22" />
      </div>
    </div>

    <div class="controls">
      <div class="lang-toggle" role="group" aria-label="Language">
        {
          segments.map((segment) =>
            segment.lang === lang ? (
              <span class="segment active" aria-current="true">
                {segment.label}
              </span>
            ) : (
              <a class="segment" href={localePath(segment.lang, path)}>
                {segment.label}
              </a>
            ),
          )
        }
      </div>

      <a class="sign-in" href={localePath(lang, '/login')} data-me-slot data-msg-account={t(lang, 'nav.account')}>
        {t(lang, 'nav.signIn')}
      </a>
    </div>
  </div>
</header>

<style>
  .app-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 80px;
    background: var(--color-header-bg);
    box-shadow: var(--shadow-sticky);
  }

  .bar-inner {
    max-width: var(--container-app);
    height: 100%;
    margin-inline: auto;
    padding-inline: var(--container-pad-x);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-width: 0;
  }

  .logo {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-primary);
    text-decoration: none;
    white-space: nowrap;
  }

  .partner-marks {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .header-separator {
    display: block;
    width: 1px;
    height: 28px;
    background: var(--color-border);
    flex-shrink: 0;
  }

  .oc-logo {
    display: block;
    width: auto;
    height: 20px;
  }

  .header-star {
    color: var(--color-primary);
    font-size: 14px;
    line-height: 1;
  }

  .janaagraha-logo {
    display: block;
    width: auto;
    height: 22px;
  }

  .logo-short {
    display: none;
  }

  .controls {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .segment {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-text);
    border-radius: var(--radius-full);
  }

  .segment.active {
    color: var(--color-primary);
    background: var(--color-primary-surface);
    font-weight: 700;
  }

  .sign-in {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
    /* Without this the EN label wraps to "Sign / in" on a 320px phone and
       the two-line button breaks out of the 56px bar. */
    white-space: nowrap;
    border: 1.5px solid var(--color-primary);
    border-radius: var(--radius-sm);
  }

  /* --- phones (below tokens.css's single 768px breakpoint) ---------------
     The 56px bar has to carry four things — brand wordmark, Open City mark,
     language toggle, Sign in — and at desktop spacing they need ~493px. A
     360px phone gives us 328px inside the padding, so every one of the
     savings below is load-bearing, not cosmetic:

       "Bengaluru Votes" -> "BV"     saves ~120px
       lockup gap + rule tightened    saves ~8px
       controls gap 16 -> 8           saves ~8px
       segment/Sign in x-padding      saves ~24px

     That lands the whole bar at ~250px, so both marks stay visible down to
     the ~320px floor. Only HORIZONTAL padding shrinks: `min-height` on
     `.segment` (32px) and `.sign-in` (44px) is untouched, so the touch
     targets still meet the a11y floor in design-system.md §10.

     The abbreviation is presentational only. `.logo`'s aria-label is
     "Bengaluru Votes" at every width and overrides its own text content for
     assistive tech, so a screen reader never hears "BV". */
  @media (max-width: 767px) {
    .bar-inner {
      gap: var(--space-2);
    }

    .brand {
      gap: var(--space-2);
    }

    .logo-full {
      display: none;
    }

    .logo-short {
      display: inline;
    }

    .partner-marks {
      gap: 4px;
    }

    .header-separator {
      height: 24px;
    }

    .oc-logo {
      height: 13px;
    }

    .janaagraha-logo {
      height: 14px;
    }

    .header-star {
      font-size: 11px;
    }

    .controls {
      gap: var(--space-2);
    }

    .segment {
      padding-inline: 4px;
    }

    .sign-in {
      padding-inline: var(--space-2);
    }
  }

  /* Keep the complete lockup usable at the 320px floor as well. */
  @media (max-width: 359px) {
    .brand {
      gap: 4px;
    }

    .logo {
      font-size: var(--text-base);
    }

    .partner-marks {
      gap: 3px;
    }

    .header-separator {
      height: 20px;
    }

    .oc-logo {
      height: 12px;
    }

    .janaagraha-logo {
      height: 12px;
    }

    .controls {
      gap: 4px;
    }
  }
</style>
