---
/**
 * Button — design-system.md §7.3. Five variants, min 44x44 target,
 * Manrope 700 16px. Renders an <a> styled as a button when `href` is
 * given (navigation), otherwise a real <button> (in-page action).
 *
 * Loading holds the button's width: the slotted label stays in the
 * layout and accessible name (opacity: 0, not removed) while a spinner + sr-only
 * "Loading" text sit on top of it in the same grid cell.
 */
import { t, type Lang } from '../i18n';
import '../styles/buttons.css';

export type ButtonVariant = 'primary' | 'secondary' | 'tertiary' | 'destructive' | 'light';

interface Props {
  variant: ButtonVariant;
  type?: 'button' | 'submit' | 'reset';
  href?: string;
  /** Anchor-only (ignored without `href`) — set alongside `rel` for external EC links (Task 21). */
  target?: '_blank';
  /** Anchor-only (ignored without `href`) — e.g. `"noopener noreferrer"` for external links. */
  rel?: string;
  disabled?: boolean;
  loading?: boolean;
  lang: Lang;
  /** Icon-only controls require a localized accessible label. */
  iconOnly?: boolean;
  label?: string;
  /**
   * Arbitrary `data-*` passthrough (e.g. `data-register-slot`,
   * `data-ward-id`) — needed so a later client-side island (WardMap's
   * register-for-updates slot swap, Task 27/28) can select this exact
   * rendered element without this component knowing about that feature.
   */
  [key: `data-${string}`]: string | number | boolean | undefined;
}

const {
  variant,
  type = 'button',
  href,
  target,
  rel,
  disabled = false,
  loading = false,
  iconOnly = false,
  label,
  lang,
  ...rest
} = Astro.props;

if (iconOnly && !label?.trim()) throw new Error('Icon-only buttons require an accessible label');
const className = `btn btn--${variant} btn-shared${iconOnly ? ' btn--icon' : ''}`;
---

{
  href ? (
    <a
      class={className}
      href={href}
      target={target}
      rel={rel}
      aria-label={label}
      aria-busy={loading ? 'true' : undefined}
      aria-disabled={disabled ? 'true' : undefined}
      {...rest}
    >
      <span class="btn-content">
        <span class="btn-label" aria-hidden={iconOnly ? 'true' : undefined} style={loading ? 'opacity:0' : undefined}>
          <slot />
        </span>
        {loading && (
          <>
            <span class="spinner" aria-hidden="true"></span>
            <span class="sr-only" role="status">{t(lang, 'common.loading')}</span>
          </>
        )}
      </span>
    </a>
  ) : (
    <button class={className} type={type} aria-label={label} disabled={disabled} aria-busy={loading ? 'true' : undefined} {...rest}>
      <span class="btn-content">
        <span class="btn-label" aria-hidden={iconOnly ? 'true' : undefined} style={loading ? 'opacity:0' : undefined}>
          <slot />
        </span>
        {loading && (
          <>
            <span class="spinner" aria-hidden="true"></span>
            <span class="sr-only" role="status">{t(lang, 'common.loading')}</span>
          </>
        )}
      </span>
    </button>
  )
}
