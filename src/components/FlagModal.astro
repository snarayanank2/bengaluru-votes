---
/**
 * Flag misinformation modal shell (Task 32,
 * design-system.md §7.9; architecture.md §7) — rendered ONCE per page (from Base.astro, same
 * convention as the other modal components), as a native
 * `<dialog>`. Purely markup/i18n — all behavior (anonymous submission,
 * the field/claim picker, the fetch call, success/error states) lives in
 * the client island `src/islands/FlagModal.ts`, which finds this exact
 * markup via `[data-flag-modal]` and its `data-flag-*`/`data-msg-*` hooks.
 *
 * The field PICKER is built client-side (the island injects one checkbox per
 * target — or just a label when there is only one, pre-selected — into
 * `[data-flag-target-options]`) because the set of flaggable targets differs
 * per page and isn't known until the "Flag an error" button that opened this
 * modal is clicked (its `data-flag-targets` JSON attribute). Each ticked
 * target shows its own correction block, cloned from the
 * `<template data-flag-block-template>` below (so its labels are rendered
 * and translated here, not in script). "Other" is a target like any other
 * that has no suggested-value input.
 *
 * Modal shell (Close button, Escape, focus trap/return, URL never changes)
 * comes from `ModalController` (src/islands/ModalShell.ts). This modal
 * holds a form, so it does NOT close on a scrim click.
 */
import { t, type Lang } from '../i18n';
import Button from './Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const recaptchaSiteKey = process.env.RECAPTCHA_SITE_KEY ?? '';
// The pages that open the modal: a candidate's page and a ward's comparison.
const isCandidate = /^\/(kn\/)?(candidate\/|ward\/\d+\/compare)/.test(Astro.url.pathname);
---

<dialog class="flag-modal" data-flag-modal data-recaptcha-site-key={recaptchaSiteKey} aria-labelledby="flag-modal-title">
  <div class="flag-modal-inner">
    <div class="flag-modal-head">
      <h2 id="flag-modal-title">{t(lang, 'flag.modal.title')}</h2>
      <Button variant="tertiary" iconOnly label={t(lang, 'flag.modal.close')} lang={lang} data-modal-close>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
      </Button>
    </div>

    <div class="flag-modal-body">
    <p class="flag-candidate" data-flag-candidate hidden></p>
    <p>{t(lang, 'flag.modal.explanation')}</p>
    <form data-flag-form novalidate>
      <fieldset class="form-field flag-picker">
        <legend class="form-label">{t(lang, 'flag.modal.targetLabel')}</legend>
        <div data-flag-target-options></div>
      </fieldset>

      <div class="flag-blocks" data-flag-blocks></div>

      <p class="form-error" data-flag-rate-limit-error role="alert" hidden></p>
      <p class="form-error" data-flag-generic-error role="alert" hidden></p>

      <Button type="submit" variant="primary" lang={lang} data-flag-submit>
        {t(lang, 'flag.modal.submit')}
      </Button>
    </form>
    </div>
  </div>

  <template data-flag-block-template>
    <fieldset class="flag-block" data-flag-block>
      <legend class="form-label" data-flag-block-title></legend>
      <p class="flag-block-help" data-flag-block-help hidden>{t(lang, 'flag.modal.otherHelp')}</p>
      <div class="form-field">
        <label class="form-label" data-flag-detail-label data-label-default={t(lang, 'flag.modal.detailLabel')} data-label-other={t(lang, 'flag.modal.otherDetailLabel')}></label>
        <textarea class="form-input" name="detail" rows="3" maxlength="2000" required></textarea>
        <p class="form-error" data-flag-detail-error hidden></p>
      </div>
      <div class="form-field">
        <label class="form-label" data-flag-source-label>{t(lang, 'flag.modal.sourceLabel')}</label>
        <input class="form-input" name="sourceUrl" type="url" maxlength="2048" />
        <p class="form-error" data-flag-source-error hidden></p>
      </div>
      <div class="form-field" data-flag-suggested-field>
        <label class="form-label" data-flag-suggested-label>{t(lang, 'flag.modal.suggestedLabel')}</label>
        <input class="form-input" name="suggestedValue" type="text" maxlength="1000" />
      </div>
    </fieldset>
  </template>

  <span hidden data-msg-rate-limit>{t(lang, 'flag.modal.rateLimited')}</span>
  <span hidden data-msg-source-invalid>{t(lang, 'flag.modal.sourceInvalid')}</span>
  <span hidden data-msg-generic-error>{t(lang, 'flag.modal.genericError')}</span>
  <span hidden data-msg-success>{t(lang, 'flag.modal.success')}</span>
  <span hidden data-msg-verification>{t(lang, 'flag.modal.verification')}</span>
  <span hidden data-msg-paused>{t(lang, 'flag.modal.paused')}</span>
  <span hidden data-msg-detail-required>{t(lang, 'flag.modal.detailRequired')}</span>
  <span hidden data-msg-select-one>{t(lang, 'flag.modal.selectAtLeastOne')}</span>
  <span hidden data-msg-not-added>{t(lang, 'flag.modal.notAdded')}</span>
  <span hidden data-msg-rate-limit-minute>{t(lang, 'flag.modal.rateLimitedMinute')}</span>
  <span hidden data-msg-rate-limit-minutes>{t(lang, 'flag.modal.rateLimitedMinutes')}</span>
  <span hidden data-msg-rate-limit-hour>{t(lang, 'flag.modal.rateLimitedHour')}</span>
  <span hidden data-msg-rate-limit-hours>{t(lang, 'flag.modal.rateLimitedHours')}</span>
</dialog>
{isCandidate && recaptchaSiteKey && <script is:inline src={`https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(recaptchaSiteKey)}`} async defer></script>}

<style>
  /* The dialog itself scrolls when it is taller than the viewport (the
     browser's modal default); the head below is sticky, so the title and
     Close stay in view whichever field has focus. */
  .flag-modal {
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-modal);
    max-width: 28rem;
    width: calc(100% - var(--space-8));
    max-height: calc(100dvh - var(--space-8));
    overflow-y: auto;
  }

  .flag-modal::backdrop {
    background: rgba(26, 26, 26, 0.5);
  }

  .flag-modal-head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-6) var(--space-6) var(--space-3);
    background: var(--color-bg);
  }

  .flag-modal-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: 0 var(--space-6) var(--space-6);
  }

  .flag-modal h2 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0;
  }

  /* Pull the 44px Close target's padding into the head's corner. */
  .flag-modal-head :global([data-modal-close]) {
    flex: none;
    margin-block-start: calc(-1 * var(--space-2));
    margin-inline-end: calc(-1 * var(--space-2));
  }

  .flag-candidate {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .flag-modal form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-label {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .form-input {
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .form-input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-color: var(--color-primary);
  }

  /* Invalid (§7.10): brick border plus the error text beneath. */
  :global(.flag-block .form-input[aria-invalid='true']) {
    border-color: var(--color-danger);
  }

  .form-error {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-danger);
  }

  .flag-picker {
    border: none;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  /* The browser gives a legend 2px of inline padding; zero it so the legend
     shares its left edge with the option rows below (§7.10). */
  .flag-picker legend {
    padding: 0;
  }

  :global([data-flag-target-options]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  :global(.flag-target-option) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 48px;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    cursor: pointer;
  }

  :global(.flag-target-option input) {
    width: 22px;
    height: 22px;
    flex: none;
    margin: 0;
    accent-color: var(--color-primary);
  }

  :global(.flag-target-option:has(input:checked)) {
    border-color: var(--color-primary);
    background: var(--color-surface);
  }

  :global(.flag-target-option:has(input:focus-visible)) {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
  }

  .flag-blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  :global(.flag-block) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    margin: 0;
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  :global(.flag-block[hidden]) {
    display: none;
  }

  :global(.flag-block legend) {
    padding-inline: var(--space-1);
  }

  :global(.flag-block-help) {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  :global(.flag-target-single) {
    margin: 0;
    font-size: var(--text-base);
  }

  /* Success toast (design-system.md §7.12) — created dynamically by
     src/islands/FlagModal.ts's showSuccessToast, outside this component's
     own scoped DOM (it must outlive the modal closing), so its styling
     lives here as a :global rule rather than inline styles (tests/unit/
     tokens.test.ts forbids hex literals outside tokens.css; this way the
     toast, like every other component, only ever references the semantic
     tokens). Mirrors src/components/Toast.astro's `.toast--success`. */
  :global(.flag-success-toast) {
    position: fixed;
    left: 50%;
    bottom: var(--space-6);
    transform: translateX(-50%);
    max-width: calc(100vw - var(--space-8));
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-modal);
    border-left: 4px solid var(--color-primary);
  }

  @media (max-width: 767px) {
    .flag-modal {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      max-width: 100%;
      width: 100%;
      margin: 0;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }
  }
</style>

<script>
  import { initFlagModal } from '../islands/FlagModal';
  initFlagModal();
</script>
