---
/**
 * Flag misinformation modal shell (Task 32,
 * design-system.md §7.9; architecture.md §7) — rendered ONCE per page (from Base.astro, same
 * convention as `src/components/RegisterLoginModal.astro`), as a native
 * `<dialog>`. Purely markup/i18n — all behavior (anonymous submission,
 * the field/claim picker, the fetch call, success/error states) lives in
 * the client island `src/islands/FlagModal.ts`, which finds this exact
 * markup via `[data-flag-modal]` and its `data-flag-*`/`data-msg-*` hooks.
 *
 * The field/claim PICKER is entirely built client-side (the island injects
 * radio inputs — or a single pre-selected hidden input, when there's only
 * one target — into `[data-flag-target-options]`) because the set of
 * flaggable targets differs per page/ward and isn't known until the
 * "Flag an error" button that opened this modal is clicked (its
 * `data-flag-targets` JSON attribute).
 *
 * Modal shell (Close button, scrim-tap, Escape, focus trap/return, URL
 * never changes) comes from `ModalController` (src/islands/ModalShell.ts).
 */
import { t, type Lang } from '../i18n';
import Button from './Button.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const recaptchaSiteKey = process.env.RECAPTCHA_SITE_KEY ?? '';
const isCandidate = /^\/(kn\/)?candidate\//.test(Astro.url.pathname);
---

<dialog class="flag-modal" data-flag-modal data-recaptcha-site-key={recaptchaSiteKey} aria-labelledby="flag-modal-title">
  <div class="flag-modal-inner">
    <Button variant="tertiary" iconOnly label={t(lang, 'flag.modal.close')} lang={lang} data-modal-close>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </Button>
    <h2 id="flag-modal-title">{t(lang, 'flag.modal.title')}</h2>

    <p>{t(lang, 'flag.modal.explanation')}</p>
    <form data-flag-form>
      <div class="form-field">
        <p class="form-label" id="flag-target-label">{t(lang, 'flag.modal.targetLabel')}</p>
        <div data-flag-target-options role="radiogroup" aria-labelledby="flag-target-label"></div>
      </div>

      <div class="form-field">
        <label class="form-label" for="flag-detail">{t(lang, 'flag.modal.detailLabel')}</label>
        <textarea id="flag-detail" class="form-input" name="detail" rows="3" maxlength="2000" required></textarea>
      </div>

      <div class="form-field">
        <label class="form-label" for="flag-source">{t(lang, 'flag.modal.sourceLabel')}</label>
        <input id="flag-source" class="form-input" name="sourceUrl" type="url" maxlength="2048" />
        <p class="form-error" data-flag-source-error hidden></p>
      </div>

      <div class="form-field">
        <label class="form-label" for="flag-suggested">{t(lang, 'flag.modal.suggestedLabel')}</label>
        <input id="flag-suggested" class="form-input" name="suggestedValue" type="text" maxlength="1000" />
      </div>

      <p class="form-error" data-flag-rate-limit-error role="alert" hidden></p>
      <p class="form-error" data-flag-generic-error role="alert" hidden></p>

      <Button type="submit" variant="primary" lang={lang} data-flag-submit>
        {t(lang, 'flag.modal.submit')}
      </Button>
    </form>
  </div>

  <span hidden data-msg-rate-limit>{t(lang, 'flag.modal.rateLimited')}</span>
  <span hidden data-msg-source-invalid>{t(lang, 'flag.modal.sourceInvalid')}</span>
  <span hidden data-msg-generic-error>{t(lang, 'flag.modal.genericError')}</span>
  <span hidden data-msg-success>{t(lang, 'flag.modal.success')}</span>
  <span hidden data-msg-verification>{t(lang, 'flag.modal.verification')}</span>
  <span hidden data-msg-paused>{t(lang, 'flag.modal.paused')}</span>
  <span hidden data-msg-already-reported>{t(lang, 'flag.modal.alreadyReported')}</span>
  <span hidden data-msg-already-reviewed>{t(lang, 'flag.modal.alreadyReviewed')}</span>
</dialog>
{isCandidate && recaptchaSiteKey && <script is:inline src={`https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(recaptchaSiteKey)}`} async defer></script>}

<style>
  .flag-modal {
    padding: 0;
    border: none;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-modal);
    max-width: 28rem;
    width: calc(100% - var(--space-8));
  }

  .flag-modal::backdrop {
    background: rgba(26, 26, 26, 0.5);
  }

  .flag-modal-inner {
    position: relative;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .flag-modal h2 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0;
    padding-right: var(--space-8);
  }

  .flag-modal-inner :global([data-modal-close]) {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
  }

  .flag-modal form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-label {
    margin: 0;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .form-input {
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .form-input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-color: var(--color-primary);
  }

  .form-error {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-danger);
  }

  :global([data-flag-target-options]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  :global(.flag-target-option) {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-base);
  }

  :global(.flag-target-single) {
    margin: 0;
    font-size: var(--text-base);
  }

  /* Success toast (design-system.md §7.12) — created dynamically by
     src/islands/FlagModal.ts's showSuccessToast, outside this component's
     own scoped DOM (it must outlive the modal closing), so its styling
     lives here as a :global rule rather than inline styles (tests/unit/
     tokens.test.ts forbids hex literals outside tokens.css; this way the
     toast, like every other component, only ever references the semantic
     tokens). Mirrors src/components/Toast.astro's `.toast--success`. */
  :global(.flag-success-toast) {
    position: fixed;
    left: 50%;
    bottom: var(--space-6);
    transform: translateX(-50%);
    max-width: calc(100vw - var(--space-8));
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg);
    color: var(--color-text);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-modal);
    border-left: 4px solid var(--color-primary);
  }

  @media (max-width: 767px) {
    .flag-modal {
      position: fixed;
      top: auto;
      bottom: 0;
      left: 0;
      right: 0;
      max-width: 100%;
      width: 100%;
      margin: 0;
      border-radius: var(--radius-md) var(--radius-md) 0 0;
    }
  }
</style>

<script>
  import { initFlagModal } from '../islands/FlagModal';
  initFlagModal();
</script>
