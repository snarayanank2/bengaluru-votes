---
/**
 * EmptyState — design-system.md §7.12. States a fact, then a next step —
 * no sad-face iconography on civic data. `fact` and `nextStep` are
 * already-resolved, caller-translated strings (not i18n keys) so this
 * component stays purely presentational. An optional default slot can add
 * a muted illustration or action (e.g. a Button).
 *
 * When the state IS the page (a 404 or 500 with nothing else on it) pass
 * `headingLevel={1}` so the fact becomes the page's H1; inside a list or
 * section it stays a paragraph.
 */
interface Props {
  fact: string;
  nextStep?: string;
  headingLevel?: 1 | 2 | 3;
}

const { fact, nextStep, headingLevel } = Astro.props;
const FactTag = headingLevel ? (`h${headingLevel}` as const) : 'p';
---

<div class="empty-state">
  <FactTag class="fact">{fact}</FactTag>
  {nextStep && <p class="next-step">{nextStep}</p>}
  <slot />
</div>

<style>
  .empty-state {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-8) var(--space-4);
    text-align: center;
  }

  .fact {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: var(--leading-lg);
    color: var(--color-text);
  }

  /* A page-level heading keeps the heading font and the page-title size. */
  h1.fact {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-2xl);
  }

  .next-step {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text-muted);
  }
</style>
