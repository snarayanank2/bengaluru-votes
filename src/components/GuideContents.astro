---
/**
 * GuideContents — the "On this page" list at the top of a long staff guide:
 * links to each section's id, so a reader can jump to the rule they need
 * (design-system.md §7.13, "Guides"). `items` carry already-translated labels.
 */
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  items: Array<{ id: string; label: string }>;
}

const { lang, items } = Astro.props;
---

<nav class="guide-contents" aria-label={t(lang, 'staff.guide.contents')}>
  <p class="guide-contents-title">{t(lang, 'staff.guide.contents')}</p>
  <ul>
    {items.map((item) => <li><a class="body-link" href={`#${item.id}`}>{item.label}</a></li>)}
  </ul>
</nav>

<style>
  .guide-contents {
    margin-top: var(--space-6);
    padding: var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .guide-contents-title {
    margin: 0 0 var(--space-1);
    font-weight: 700;
  }

  .guide-contents ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
