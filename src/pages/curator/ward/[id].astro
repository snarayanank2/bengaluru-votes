---
/**
 * `/curator/ward/{id}` — see src/features/pages/curator/WardEdit.astro for
 * the presentational side. This route twin owns the numeric-id existence
 * check (404) and no-store on every response — same conventions as
 * src/pages/curator/candidate/[id].astro. The page is read-only: there is
 * no ward sign-off (dropped 2026-08-15), so any POST is a 400.
 */
import WardEdit from '../../../features/pages/curator/WardEdit.astro';
import { loadCuratorLang, loadWardCandidates, loadWardForEdit } from '../../../lib/curator';

const session = Astro.locals.session!;

const idParam = Astro.params.id;
const wardId = Number(idParam);
if (!idParam || !Number.isInteger(wardId)) {
  return new Response(null, { status: 404, headers: { 'cache-control': 'no-store' } });
}

const ward = await loadWardForEdit(wardId);
if (!ward) {
  return new Response(null, { status: 404, headers: { 'cache-control': 'no-store' } });
}

if (Astro.request.method === 'POST') {
  return new Response(null, { status: 400, headers: { 'cache-control': 'no-store' } });
}

const [lang, wardCandidates] = await Promise.all([loadCuratorLang(session.userId), loadWardCandidates(ward.id)]);
Astro.response.headers.set('cache-control', 'no-store');
---

<WardEdit lang={lang} ward={ward} candidates={wardCandidates} />
