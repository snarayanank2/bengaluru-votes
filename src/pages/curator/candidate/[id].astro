---
/**
 * `/curator/candidate/{id}` — see
 * src/features/pages/curator/CandidateEdit.astro for the presentational
 * side. This route twin owns:
 *   - the numeric-id existence check (404 for a non-integer id or a row
 *     that doesn't exist — same pattern as src/pages/curator/queue/[id].astro);
 *   - dispatching the POSTs via the hidden `formAction` field (`fields`,
 *     with legacy single-field/ward corrections still supported), and the resulting
 *     redirect/re-render/400 status: a refused field save re-renders with
 *     400 and exactly what was typed;
 *   - no-store on every response.
 */
import CandidateEdit from '../../../features/pages/curator/CandidateEdit.astro';
import {
  handleCandidateFieldFix,
  handleCandidateWardFix,
  loadCandidateForEdit,
  loadCuratorLang,
  type EditFixOutcome,
} from '../../../lib/curator';
import StaffError from '../../../features/pages/StaffError.astro';
import type { FieldError, RawField } from '../../../lib/affidavit-form';
import { loadFixCandidate, saveCandidateChanges, type CandidateBatchRefusal, loadWardOptions } from '../../../lib/curator-fix';
import { AFFIDAVIT_FIELD_KEYS, type AffidavitFieldKey } from '../../../lib/affidavit-publish';

const session = Astro.locals.session!;
const actor = { userId: session.userId, role: session.role as 'curator' | 'admin' };

const idParam = Astro.params.id;
const candidateId = Number(idParam);
// An id that is not an integer or names no candidate renders the staff-shell not-found page, with a 404.
let candidate = idParam && Number.isInteger(candidateId) ? await loadCandidateForEdit(candidateId) : null;

const lang = await loadCuratorLang(session.userId);

let message: { kind: 'notice' | 'error'; key: string } | undefined;
let responseStatus = 200;
let batchRefused: CandidateBatchRefusal | undefined;
/** Which form was refused, and what was typed into it. */
let refused: { formAction: string; error?: FieldError; raw?: RawField } | undefined;

if (candidate && Astro.request.method === 'POST') {
  Astro.response.headers.set('cache-control', 'no-store');
  const form = await Astro.request.formData();
  const formAction = String(form.get('formAction') ?? '');

  if (formAction === 'core' || formAction === 'affidavit') {
    return new Response(null, { status: 403, headers: { 'cache-control': 'no-store' } });
  } else if (formAction === 'fields') {
    const outcome = await saveCandidateChanges(actor, (await loadFixCandidate(candidateId))!, form);
    if (outcome.kind === 'saved') {
      return new Response(null, { status: 302, headers: { Location: `/curator/candidate/${candidateId}`, 'cache-control': 'no-store' } });
    }
    batchRefused = outcome;
    message = { kind: 'error', key: outcome.key };
    responseStatus = 400;
  } else if (formAction.startsWith('field:') || formAction === 'ward') {
    let outcome: EditFixOutcome;
    if (formAction === 'ward') {
      outcome = await handleCandidateWardFix(candidate, form);
    } else {
      const fieldKey = formAction.slice('field:'.length);
      if (!(AFFIDAVIT_FIELD_KEYS as readonly string[]).includes(fieldKey)) {
        return new Response(null, { status: 400, headers: { 'cache-control': 'no-store' } });
      }
      outcome = await handleCandidateFieldFix(actor, candidate, fieldKey as AffidavitFieldKey, form);
    }
    if (outcome.kind === 'saved') {
      return new Response(null, {
        status: 302,
        headers: { Location: `/curator/candidate/${candidateId}`, 'cache-control': 'no-store' },
      });
    }
    message = { kind: 'error', key: outcome.key };
    refused = { formAction, error: outcome.error, raw: outcome.raw };
    responseStatus = 400;
  } else {
    return new Response(null, { status: 400, headers: { 'cache-control': 'no-store' } });
  }

  candidate = (await loadCandidateForEdit(candidateId))!;
}


const wards = !candidate?.pdfUrl ? [] : await loadWardOptions();

Astro.response.headers.set('cache-control', 'no-store');
Astro.response.status = candidate ? responseStatus : 404;
---

{
  candidate ? (
    <CandidateEdit
      lang={lang}
      csrfToken={Astro.locals.csrfToken}
      wardId={candidate.wardId}
      wardNameEn={candidate.wardNameEn}
      wardNameKn={candidate.wardNameKn}
      candidate={candidate}
      wards={wards}
      message={message}
      refused={refused}
      batchRefused={batchRefused}
    />
  ) : (
    <StaffError lang={lang} status={404} area="curator" />
  )
}
