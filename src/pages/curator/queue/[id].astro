---
/**
 * `/curator/queue/{id}` — see src/features/pages/curator/QueueItem.astro
 * for the presentational side. This route twin owns:
 *   - the numeric-id existence check (404 for a non-integer id or a row
 *     that doesn't exist — same pattern as src/pages/ward/[id].astro);
 *   - dispatching the POST by its hidden `formAction` field (`fix` or
 *     `reject`; anything else is a 400), and the resulting redirect or
 *     re-render: a refused fix re-renders with 400 and what was typed (a fix
 *     that changes nothing re-renders with a 200 and a notice);
 *   - no-store on every response.
 */
import { markFlagSpam } from '../../../lib/flags';
import QueueItem from '../../../features/pages/curator/QueueItem.astro';
import StaffError from '../../../features/pages/StaffError.astro';
import { handleFlagFix, handleReject, loadCuratorLang, loadQueueItem } from '../../../lib/curator';
import { loadWardOptions, refusalPresentation, type WardOption } from '../../../lib/curator-fix';
import type { FieldError, RawField } from '../../../lib/affidavit-form';

const session = Astro.locals.session!;
const actor = { userId: session.userId, role: session.role as 'curator' | 'admin' };

const idParam = Astro.params.id;
const itemId = Number(idParam);

const page = Math.max(1,Math.min(10000,Math.trunc(Number(Astro.url.searchParams.get('page')))||1));
// An id that is not an integer or names no flag renders the staff-shell not-found page, with a 404.
let item = idParam && Number.isInteger(itemId) ? await loadQueueItem(itemId, page) : null;

const lang = await loadCuratorLang(session.userId);

let message: { kind: 'notice' | 'error'; key: string } | undefined;
let fixError: FieldError | undefined;
let fixRaw: RawField | undefined;
let status = 200;

if (item && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const formAction = String(form.get('formAction') ?? '');
  if (formAction === 'spam') {
    try {
      await markFlagSpam(actor,itemId,form.getAll('submissionId').map(Number),String(form.get('reason') ?? ''));
      return Astro.redirect(`/curator/queue/${itemId}?page=${page}`,303);
    } catch (error) {
      const resolved = error instanceof Error && error.message === 'flag_already_resolved';
      message = {kind:resolved ? 'notice' : 'error',key:resolved ? 'curator.queueItem.alreadyResolved' : 'flag.review.invalidSelection'};
      item = (await loadQueueItem(itemId,page))!;
      status = resolved ? 409 : 400;
    }
  } else {
  if (formAction !== 'fix'  && formAction !== 'reject') {
    return new Response(null, { status: 400, headers: { 'cache-control': 'no-store' } });
  }

  const outcome = formAction === 'fix' ? await handleFlagFix(actor, item, form) : await handleReject(actor, item.id, form);

  if (outcome.kind === 'accepted' || outcome.kind === 'rejected') {
    return new Response(null, {
      status: 302,
      headers: { Location: `/curator/queue?resolved=${outcome.kind}`, 'cache-control': 'no-store' },
    });
  }

  if (outcome.kind === 'already_resolved') {
    message = { kind: 'notice', key: 'curator.queueItem.alreadyResolved' };
    item = (await loadQueueItem(itemId))!;
  } else {
    // "Nothing changed" is a notice with a 200; every other refusal is an error with a 400.
    const presentation = refusalPresentation(outcome.key);
    message = { kind: presentation.kind, key: outcome.key };
    status = presentation.status;
    if (outcome.kind === 'refused') {
      fixError = outcome.error;
      fixRaw = outcome.raw;
    }
  }
  }
}

// Every ward is listed only where it is chosen from: a pending flag on the ward.
const wards: WardOption[] = item && item.status === 'pending' && item.fix.kind === 'ward' ? await loadWardOptions() : [];

Astro.response.headers.set('cache-control', 'no-store');
Astro.response.status = item ? status : 404;
---

{
  item ? (
    <QueueItem lang={lang} csrfToken={Astro.locals.csrfToken} item={item} wards={wards} message={message} fixError={fixError} fixRaw={fixRaw} />
  ) : (
    <StaffError lang={lang} status={404} area="curator" />
  )
}
