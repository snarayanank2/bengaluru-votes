---
/**
 * `/transcribe/{assignment-id}` — see
 * src/features/pages/transcribe/Reading.astro. This route twin owns:
 *   - the 404 for anything that is not the caller's own open, unexpired
 *     assignment. It is a 404 and not a 403, for an admin too, so an
 *     assignment id never confirms that someone else's work exists;
 *   - the three form actions (`save`, `release`, `report`), all handled by
 *     src/lib/transcribe.ts, and the redirect back to `/transcribe`;
 *   - the 400 re-render that keeps what the transcriber typed;
 *   - no-store on every response.
 */
import Reading from '../../features/pages/transcribe/Reading.astro';
import {
  loadAssignment,
  releaseAssignment,
  reportWrongDocument,
  submitAssignment,
  type AssignmentView,
  type FieldError,
  type RawForm,
} from '../../lib/transcribe';
import type { AffidavitFieldKey } from '../../lib/affidavit-publish';
import { loadCuratorLang } from '../../lib/curator';

const session = Astro.locals.session!;

function notFound(): Response {
  return new Response(null, { status: 404, headers: { 'cache-control': 'no-store' } });
}

function redirect(location: string): Response {
  return new Response(null, { status: 302, headers: { Location: location, 'cache-control': 'no-store' } });
}

const idParam = Astro.params.id ?? '';
if (!/^[1-9]\d{0,9}$/.test(idParam)) return notFound();
const assignmentId = Number(idParam);

let raw: RawForm | undefined;
let errors: Partial<Record<AffidavitFieldKey, FieldError>> = {};
let formErrorKey: string | undefined;
let reportNote = '';
let responseStatus = 200;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const formAction = String(form.get('formAction') ?? '');

  if (formAction === 'save') {
    const outcome = await submitAssignment(session.userId, assignmentId, form);
    if (outcome.kind === 'saved') return redirect('/transcribe?saved=1');
    if (outcome.kind === 'expired') return redirect('/transcribe?expired=1');
    raw = outcome.raw;
    errors = outcome.errors;
    formErrorKey = outcome.formError ? `transcribe.error.${outcome.formError}` : 'transcribe.error.summary';
    responseStatus = 400;
  } else if (formAction === 'release') {
    await releaseAssignment(session.userId, assignmentId);
    return redirect('/transcribe?released=1');
  } else if (formAction === 'report') {
    reportNote = String(form.get('note') ?? '');
    const outcome = await reportWrongDocument(session.userId, assignmentId, reportNote);
    if (outcome === 'reported') return redirect('/transcribe?reported=1');
    if (outcome === 'not_found') return redirect('/transcribe?expired=1');
    formErrorKey = 'transcribe.error.noteRequired';
    responseStatus = 400;
  } else {
    return new Response(null, { status: 400, headers: { 'cache-control': 'no-store' } });
  }
}

const view: AssignmentView | null = await loadAssignment(session.userId, assignmentId);
if (!view) return notFound();

const lang = await loadCuratorLang(session.userId);

Astro.response.headers.set('cache-control', 'no-store');
Astro.response.status = responseStatus;
---

<Reading
  lang={lang}
  csrfToken={Astro.locals.csrfToken}
  view={view}
  raw={raw}
  errors={errors}
  formErrorKey={formErrorKey}
  reportNote={reportNote}
/>
