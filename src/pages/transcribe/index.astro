---
/**
 * `/transcribe` — see src/features/pages/transcribe/Start.astro. This route
 * twin owns the one form action, `start`, which draws the caller's next
 * assignment (src/lib/transcribe.ts) and redirects to it, and no-store on
 * every response.
 *
 * src/middleware.ts has already admitted only a transcriber or an admin
 * and checked the CSRF token.
 */
import Start from '../../features/pages/transcribe/Start.astro';
import { countSubmittedToday, countWaiting, currentAssignment, drawAssignment, recentNotices } from '../../lib/transcribe';
import { loadCuratorLang } from '../../lib/curator';

const session = Astro.locals.session!;

// @ts-ignore TS6133: Astro's checker drops the expression of a top-level `return` in frontmatter, so a local used only there looks unread.
function redirect(location: string): Response {
  return new Response(null, { status: 302, headers: { Location: location, 'cache-control': 'no-store' } });
}

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('formAction') ?? '') !== 'start') {
    return new Response(null, { status: 400, headers: { 'cache-control': 'no-store' } });
  }
// @ts-ignore TS6133: Astro's checker drops the expression of a top-level `return` in frontmatter, so a local used only there looks unread.
  const assignmentId = await drawAssignment(session.userId);
  return redirect(assignmentId === null ? '/transcribe?empty=1' : `/transcribe/${assignmentId}`);
}

const NOTICES = ['saved', 'released', 'reported', 'expired', 'empty'] as const;
const asked = NOTICES.find((kind) => Astro.url.searchParams.get(kind) === '1');

const [lang, openAssignmentId, waiting, doneToday, honest] = await Promise.all([
  loadCuratorLang(session.userId),
  currentAssignment(session.userId),
  countWaiting(),
  countSubmittedToday(session.userId),
  recentNotices(session.userId),
]);
// A typed or bookmarked query string must not claim an outcome that did not just happen.
const notice = asked === 'empty' ? (waiting === 0 ? asked : undefined) : asked && honest.has(asked) ? asked : undefined;

Astro.response.headers.set('cache-control', 'no-store');
---

<Start
  lang={lang}
  csrfToken={Astro.locals.csrfToken}
  openAssignmentId={openAssignmentId}
  waiting={waiting}
  doneToday={doneToday}
  notice={notice}
/>
