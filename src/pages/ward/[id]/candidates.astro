---
/**
 * Legacy candidate-list URL. Candidate lists now live on the ward page;
 * keep shared links working with a permanent redirect.
 */
import { db } from '../../../db/client';
import { wards } from '../../../db/schema';
import { eq } from 'drizzle-orm';

const idParam = Astro.params.id;
const wardId = Number(idParam);

if (!idParam || !Number.isInteger(wardId)) {
  return new Response(null, { status: 404 });
}

const [exists] = await db.select({ id: wards.id }).from(wards).where(eq(wards.id, wardId));
if (!exists) {
  return new Response(null, { status: 404 });
}

return new Response(null, { status: 308, headers: { Location: `/ward/${wardId}` } });
---
