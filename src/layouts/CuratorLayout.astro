---
/**
 * CuratorLayout — the document shell for `/curator/*` (Task 34,
 * design-system.md §7.13 "Curator and admin surfaces"). Deliberately NOT
 * src/layouts/Base.astro: Base's AppBar renders a language-toggle link via
 * `localePath(otherLang, path)`, which assumes a real `/kn/<path>` route
 * exists for every page it's used on — true for every PUBLIC page (each
 * has a route twin), but NOT true here (see src/lib/curator.ts's module
 * docstring: curator/admin routes have no `/kn/` twin at all, and render
 * bilingual UI strings driven by the signed-in user's saved
 * `users.language` instead). Reusing Base would render a toggle link
 * pointing at a URL like `/kn/curator` that 404s.
 *
 * Also skips Base's canonical/hreflang tags (nothing to alternate between —
 * there is only ever one URL for a given curator screen) and the
 * anonymous-visitor widgets Base mounts for every public page
 * (the Flag modal) — none of those apply to an
 * already-authenticated curator/admin session.
 *
 * `noindex` is unconditional here (every curator/admin page always is —
 * src/middleware.ts also stamps `X-Robots-Tag: noindex` as a second layer).
 */
import '../styles/global.css';
import SkipLink from '../components/SkipLink.astro';
import StaffAccountLinks from '../components/StaffAccountLinks.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;
// The section the page belongs to marks its link with aria-current (design-system §7.13).
const path = Astro.url.pathname;
const NAV = [
  { href: '/curator/queue', key: 'curator.layout.nav.queue' },
  { href: '/curator/matching', key: 'curator.layout.nav.matching' },
  { href: '/curator/guide', key: 'curator.layout.nav.guide' },
];
const inSection = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    {/* Same self-hosted Open City icon set as Base.astro. */}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/img/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/img/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
  </head>
  <body>
    <SkipLink lang={lang} />
    <header class="curator-bar">
      <a class="wordmark" href="/curator">{t(lang, 'curator.layout.wordmark')}</a>
      <nav class="curator-nav" aria-label={t(lang, 'curator.layout.nav.label')}>
        {NAV.map((item) => <a href={item.href} aria-current={inSection(item.href) ? 'page' : undefined}>{t(lang, item.key)}</a>)}
      </nav>
      <StaffAccountLinks lang={lang} />
    </header>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>

<style>
  /* Exactly 56px from 600px up: CuratorSplit sizes itself against this height
     (it only does so from 900px). Below 600px the bar wraps to a second row
     for the section links, so the account controls always fit. */
  .curator-bar {
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-inline: var(--container-pad-x);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  .curator-nav {
    flex: none;
    display: flex;
    gap: var(--space-4);
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  .curator-nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--color-primary);
  }

  /* The current section: bold with a 4px underline, never color alone (§7.15). */
  .curator-nav a[aria-current='page'] {
    font-weight: 700;
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-underline-offset: 6px;
  }

  .wordmark {
    flex: 0 1 auto;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-primary);
    text-decoration: none;
  }

  @media (max-width: 599px) {
    .curator-bar {
      flex-wrap: wrap;
      gap: 0 var(--space-3);
    }

    .wordmark {
      flex: 1 1 0;
    }

    .curator-nav {
      order: 3;
      flex: 1 0 100%;
      gap: var(--space-3);
    }

    .wordmark {
      font-size: var(--text-base);
      white-space: normal;
      overflow: visible;
      text-overflow: clip;
    }
  }
</style>
