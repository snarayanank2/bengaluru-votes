---
/**
 * Ward result (`/ward/{id}`, `/kn/ward/{id}`) — information-architecture.md
 * §3.2, PRD §5.1. The hub page for a single GBA ward: name/number/
 * corporation, the boundary map, the register-for-updates slot, the ward's
 * candidate list and comparison entry point, issue voting, and candidate
 * questions.
 *
 * Existence check lives in the route twins (src/pages/ward/[id].astro,
 * src/pages/kn/ward/[id].astro), not here — only a page-level frontmatter
 * script can end an Astro request early with a custom HTTP status, so an
 * unknown wardId never actually reaches this component in production. The
 * `ward` lookup below is guarded anyway (renders a minimal not-found
 * fallback rather than throwing) purely as a defensive belt-and-braces
 * measure, not a path any test exercises.
 *
 * CACHE-SAFETY (architecture.md §5, binding): this component never reads
 * cookies/session. The register-for-updates slot below always renders the
 * ANONYMOUS "Register for updates" control, in its full enabled style
 * (design-system.md §7.8 — gated actions never render disabled) — the same
 * markup for every visitor regardless of auth state. Task 28's MeSlot
 * island (src/islands/MeSlot.ts) finds it via `data-register-slot`/
 * `data-ward-id` and swaps it client-side to "Receiving updates" (own home
 * ward, using the `data-msg-receiving-updates` label below) or removes it
 * (any other ward) — see IA §3.2 and PRD §5.1.
 *
 * Boundary map URL (spec §4, §8): the map container's `data-boundary-url`
 * points at this ward's own `GET /ward/<id>/boundary.json`
 * (src/pages/ward/[id]/boundary.json.ts), which serves one GeoJSON Feature
 * looked up by `wards.boundaryRef` server-side — NOT the 3.5MB
 * `/data/gba.geojson` collection the MapLibre-era island fetched and
 * filtered client-side. This page needs no geo.ts entry point at all for
 * that reason — it formats the URL from the `wards` row it already has.
 *
 * The container itself, and its `data-maps-key`/`data-maps-map-id`
 * attributes carrying the Google Maps Platform browser key and Map ID
 * (`src/lib/maps-config.ts`), render ONLY when `mapsConfig().enabled` —
 * the `MAPS_ENABLED` kill switch AND a configured browser key, both. When
 * disabled, the container renders with no `data-ward-map` hook at all, so
 * no island mounts and the browser key is never present in the response
 * (there is none to leak: `maps.browserKey` is simply never read in that
 * branch).
 *
 * PLACE JSON-LD (architecture §8/§13, Task 56): `src/lib/seo.ts#placeLd`
 * builds this ward's `AdministrativeArea` (name, id, page URL,
 * `containedInPlace` Bengaluru) from data this page already loaded, passed
 * to Base.astro's `jsonLd` prop.
 */
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import Button from '../../components/Button.astro';
import EmptyState from '../../components/EmptyState.astro';
import CandidateRow from '../../components/CandidateRow.astro';
import type { CandidateRowCandidate } from '../../components/CandidateRow.astro';
import { t, localePath, type Lang } from '../../i18n';
import { db } from '../../db/client';
import {
  candidates,
  media,
  wardCandidateQuestions,
  wardIssues,
  wardKeyAreas,
  wardOldWardOverlaps,
  wards,
} from '../../db/schema';
import { and, asc, eq, isNotNull } from 'drizzle-orm';
import { placeLd } from '../../lib/seo';
import { mapsConfig } from '../../lib/maps-config';
import { getKnownSetting } from '../../lib/settings';

interface Props {
  lang: Lang;
  wardId: number;
}

const { lang, wardId } = Astro.props;

const [ward] = await db.select().from(wards).where(eq(wards.id, wardId));
const questions = ward
  ? await db
      .select()
      .from(wardCandidateQuestions)
      .where(eq(wardCandidateQuestions.wardId, wardId))
      .orderBy(asc(wardCandidateQuestions.position))
  : [];
const candidateRows = ward
  ? await db
      .select({
        id: candidates.id,
        slug: candidates.slug,
        nameEn: candidates.nameEn,
        nameKn: candidates.nameKn,
        partyEn: candidates.partyEn,
        partyKn: candidates.partyKn,
        photoMediaId: candidates.photoMediaId,
        photoHash: media.sha256,
        status: candidates.status,
      })
      .from(candidates)
      .leftJoin(media, eq(media.id, candidates.photoMediaId))
      .where(eq(candidates.wardId, wardId))
  : [];
const sortedCandidates: (CandidateRowCandidate & { id: number; status: string })[] = candidateRows
  .map((candidate) => ({
    id: candidate.id,
    slug: candidate.slug,
    nameEn: candidate.nameEn,
    nameKn: candidate.nameKn,
    partyEn: candidate.partyEn,
    partyKn: candidate.partyKn,
    photoUrl:
      candidate.photoMediaId != null && candidate.photoHash
        ? `/media/${candidate.photoMediaId}/${candidate.photoHash.slice(0, 16)}`
        : null,
    status: candidate.status,
  }))
  .sort((a, b) => a.nameEn.localeCompare(b.nameEn) || a.id - b.id);
const isCandidateListProvisional = (await getKnownSetting('withdrawals_closed')) !== 'true';
const notificationDate = await getKnownSetting('notification_date');
const candidateEmptyFact = notificationDate
  ? t(lang, 'ward.candidates.empty.fact', { date: notificationDate })
  : t(lang, 'ward.candidates.empty.awaited');
const cityIssues = ward
  ? await db.select({ id: wardIssues.id, titleEn: wardIssues.titleEn, titleKn: wardIssues.titleKn })
      .from(wardIssues)
      .where(and(eq(wardIssues.wardId, wardId), isNotNull(wardIssues.catalogKey)))
      .orderBy(asc(wardIssues.position), asc(wardIssues.id))
  : [];
const [oldWardOverlaps, keyAreas] = ward
  ? await Promise.all([
      db.select().from(wardOldWardOverlaps)
        .where(eq(wardOldWardOverlaps.wardId, wardId))
        .orderBy(asc(wardOldWardOverlaps.position)),
      db.select().from(wardKeyAreas)
        .where(eq(wardKeyAreas.wardId, wardId))
        .orderBy(asc(wardKeyAreas.position)),
    ])
  : [[], []];
const voteIssues = JSON.stringify(cityIssues.map((issue) => ({
  id: issue.id,
  title: lang === 'kn' ? (issue.titleKn ?? issue.titleEn ?? '') : (issue.titleEn ?? issue.titleKn ?? ''),
})));
const recaptchaSiteKey = process.env.RECAPTCHA_SITE_KEY ?? '';

// `wards.id` is a collision-free route/database key: corporation_id * 1000
// + the per-corporation ward number. Citizens should see the latter (49 for
// route id 3049), because ward numbers repeat across corporations.
const wardNumber = wardId % 1000;
const wardNameRaw = ward ? (lang === 'kn' ? ward.nameKn : ward.nameEn) : '';
const wardName = wardNameRaw.replace(/^\d+\s*-\s*/, '');
const corporationLabel = ward ? t(lang, `ward.corporation.${ward.corporation}`) : '';
const numberFormatter = new Intl.NumberFormat(lang === 'kn' ? 'kn-IN' : 'en-IN');

// Boundary geometry now comes from this ward's own URL rather than the
// 3.5MB full collection (spec §4). `wards.boundaryRef` is still the source
// of truth for which feature this is — the route resolves it server-side —
// so this page no longer formats a fragment URL from the row.
const maps = mapsConfig();
const boundaryUrl = ward ? `/ward/${wardId}/boundary.json` : null;

const pagePath = `/ward/${wardId}`;
const title = ward ? t(lang, 'ward.meta.title', { wardName, wardNumber }) : t(lang, 'ward.notFound.fact');
const description = ward ? t(lang, 'ward.meta.description', { wardName, wardNumber }) : t(lang, 'ward.notFound.fact');

const wardJsonLd = ward ? [placeLd({ id: wardId, name: wardName, path: localePath(lang, pagePath) })] : [];
---

<Base lang={lang} title={title} description={description} path={pagePath} jsonLd={wardJsonLd}>
  {
    ward ? (
      <div class="ward">
        <header class="ward-header">
          <p class="ward-number">{t(lang, 'ward.heading.wardNumber', { wardNumber })}</p>
          <h1>{wardName}</h1>
          <dl class="ward-details">
            <div>
              <dt>{t(lang, 'ward.detail.corporation')}</dt>
              <dd>{corporationLabel}</dd>
            </div>
            <div>
              <dt>{t(lang, 'ward.detail.zone')}</dt>
              <dd>{ward.zone}</dd>
            </div>
            {ward.assemblyNumber != null && (
              <div>
                <dt>{t(lang, 'ward.detail.assembly')}</dt>
                <dd>
                  {lang === 'kn' ? ward.assemblyNameKn : ward.assemblyNameEn}
                  {' · '}{numberFormatter.format(ward.assemblyNumber)}
                </dd>
              </div>
            )}
          </dl>

          <section class="ward-overview">
            <div class="overview-grid">
              {(ward.reservationEn || ward.reservationKn) && (
                <dl class="overview-panel overview-reservation">
                  <dt>{t(lang, 'ward.overview.reservation')}</dt>
                  <dd>{lang === 'kn' ? ward.reservationKn : ward.reservationEn}</dd>
                </dl>
              )}
              {oldWardOverlaps.length > 0 && (
                <section class="overview-panel overview-old-wards">
                  <h3>{t(lang, 'ward.overview.oldWards')}</h3>
                  <ul>
                    {oldWardOverlaps.map((item) => (
                      <li>
                        {item.oldWardNumber != null && `${numberFormatter.format(item.oldWardNumber)} — `}
                        {lang === 'kn' ? item.oldWardNameKn : item.oldWardNameEn}
                        <strong>{numberFormatter.format(item.publishedOverlapBasisPoints / 100)}%</strong>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
              <section class="overview-panel overview-key-areas">
                <h3>{t(lang, 'ward.overview.keyAreas')}</h3>
                {keyAreas.length > 0 ? (
                  <ul class="key-areas">
                    {keyAreas.map((item) => <li>{lang === 'kn' ? item.nameKn : item.nameEn}</li>)}
                  </ul>
                ) : (
                  <p>{t(lang, 'ward.overview.notAvailable')}</p>
                )}
              </section>
            </div>
          </section>
        </header>

        <nav class="ward-section-nav" aria-label={t(lang, 'ward.nav.label')} data-ward-section-nav>
          <a href="#ward-overview" data-ward-section-tab="ward-overview" aria-current="page">{t(lang, 'ward.nav.overview')}</a>
          <a href="#ward-candidates" data-ward-section-tab="ward-candidates">{t(lang, 'ward.nav.candidates')}</a>
          <a href="#ward-issues" data-ward-section-tab="ward-issues">{t(lang, 'ward.nav.issues')}</a>
          <a href="#ward-questions" data-ward-section-tab="ward-questions">{t(lang, 'ward.nav.questions')}</a>
        </nav>

        <section id="ward-overview" class="ward-section" aria-label={t(lang, 'ward.map.label')}>
          {maps.enabled ? (
            <div
              class="map-container"
              data-ward-map
              data-boundary-url={boundaryUrl}
              data-ward-id={wardId}
              data-maps-key={maps.browserKey}
              data-maps-map-id={maps.mapId}
            >
              <p class="map-fallback">{t(lang, 'ward.map.fallback')}</p>
            </div>
          ) : (
            <div class="map-container">
              <p class="map-fallback">{t(lang, 'ward.map.fallback')}</p>
            </div>
          )}
        </section>

        <section class="register-slot">
          <Button
            variant="primary"
            href={localePath(lang, '/login')}
            lang={lang}
            data-register-slot
            data-ward-id={wardId}
            data-msg-receiving-updates={t(lang, 'common.receivingUpdates')}
          >
            {t(lang, 'common.registerForUpdates')}
          </Button>
        </section>

        <section id="ward-candidates" class="ward-section ward-candidates" aria-labelledby="ward-candidates-heading">
          <h2 id="ward-candidates-heading">{t(lang, 'ward.links.candidates')}</h2>
          {sortedCandidates.length === 0 ? (
            <p class="candidate-empty">{candidateEmptyFact}</p>
          ) : (
            <>
              {isCandidateListProvisional && <p class="provisional-marker">{t(lang, 'candidate.provisionalMarker')}</p>}
              <ul class="candidate-list" aria-label={t(lang, 'ward.candidates.list.label')}>
                {sortedCandidates.map((candidate) => (
                  <li class="candidate-item">
                    <CandidateRow candidate={candidate} lang={lang} />
                    {(candidate.status === 'withdrawn' || candidate.status === 'rejected') && (
                      <span class="status-label">
                        {t(lang, `candidate.status.${candidate.status}` as `candidate.status.${string}`)}
                      </span>
                    )}
                  </li>
                ))}
              </ul>
              <div class="candidate-actions">
                <Button variant="secondary" href={localePath(lang, `/ward/${wardId}/compare`)} lang={lang}>
                  {t(lang, 'candidate.links.compare')}
                </Button>
              </div>
            </>
          )}
        </section>

        {cityIssues.length > 0 && (
          <section
            id="ward-issues"
            class="ward-section issue-vote"
            aria-labelledby="issue-vote-heading"
            data-issue-vote-zone
            data-ward-id={wardId}
            data-vote-issues={voteIssues}
            data-recaptcha-site-key={recaptchaSiteKey}
            data-msg-voted-elsewhere={t(lang, 'ward.vote.votedElsewhere')}
          >
            <h2 id="issue-vote-heading">{t(lang, 'ward.vote.heading')}</h2>
            <p>{t(lang, 'ward.vote.instructions')}</p>
            <div class="issue-vote-actions">
              <Button variant="primary" type="button" lang={lang} data-vote-action>
                {t(lang, 'common.voteTop3')}
              </Button>
              <span data-show-results-wrap hidden>
                <Button variant="secondary" type="button" lang={lang} data-show-results>
                  {t(lang, 'ward.vote.showResults')}
                </Button>
              </span>
            </div>
            <p data-voted-elsewhere hidden></p>
            <ol class="issue-vote-results" data-vote-results hidden aria-live="polite"></ol>
          </section>
        )}

        {questions.length > 0 && (
          <section id="ward-questions" class="ward-section candidate-questions" aria-labelledby="candidate-questions-heading">
            <h2 id="candidate-questions-heading">{t(lang, 'ward.questions.heading')}</h2>
            <ol>
              {questions.map((question) => (
                <li>
                  <Card>
                    <p>{lang === 'kn' ? question.questionKn : question.questionEn}</p>
                  </Card>
                </li>
              ))}
            </ol>
          </section>
        )}
      </div>
    ) : (
      <EmptyState fact={t(lang, 'ward.notFound.fact')} />
    )
  }

  <script>
    import { initWardMap } from '../../islands/WardMap';
    import { initWardSectionNav } from '../../islands/WardSectionNav';
    initWardMap();
    initWardSectionNav();
  </script>
  {recaptchaSiteKey && <script is:inline src={`https://www.google.com/recaptcha/api.js?render=${encodeURIComponent(recaptchaSiteKey)}`} async defer></script>}
</Base>

<style>
  .ward {
    max-width: var(--container-app);
    margin-inline: auto;
    padding: var(--space-8) var(--container-pad-x);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .ward-section-nav {
    position: sticky;
    top: 80px;
    z-index: 60;
    display: flex;
    gap: var(--space-1);
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    margin-top: calc(-1 * var(--space-12));
    padding: var(--space-2) max(var(--container-pad-x), calc((100vw - var(--container-app)) / 2 + var(--container-pad-x)));
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    background: var(--color-header-bg);
    isolation: isolate;
    border-bottom: 1px solid var(--color-border);
    scrollbar-width: none;
  }

  .ward-section-nav::-webkit-scrollbar {
    display: none;
  }

  .ward-section-nav a {
    flex: 0 0 auto;
    position: relative;
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .ward-section-nav a:hover,
  .ward-section-nav a:focus-visible {
    color: var(--color-text);
  }

  .ward-section-nav a[aria-current='page'] {
    color: var(--color-primary);
  }

  .ward-section-nav a[aria-current='page']::after {
    position: absolute;
    right: 0;
    bottom: calc(-1 * var(--space-2) - 1px);
    left: 0;
    height: 4px;
    background: var(--color-primary);
    content: '';
  }

  .ward-section-nav a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: -2px;
  }

  .ward-section {
    scroll-margin-top: calc(80px + var(--space-12));
  }

  .ward-header h1 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: var(--leading-3xl);
    margin: 0;
    color: var(--color-on-hero);
  }

  .ward-header {
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding: var(--space-12) max(var(--container-pad-x), calc((100vw - var(--container-app)) / 2 + var(--container-pad-x)));
    background: var(--color-hero-bg);
    color: var(--color-on-hero);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .ward-number {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-full);
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .ward-details,
  .overview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
  }

  .ward-details {
    width: 100%;
    margin: 0;
  }

  .ward-details div {
    display: grid;
    gap: 2px;
  }

  .ward-details dt,
  .overview-panel dt,
  .overview-panel h3 {
    color: var(--color-hero-muted);
    font-size: var(--text-xs);
    line-height: inherit;
  }

  .ward-details dd,
  .overview-panel dd {
    margin: 0;
    color: var(--color-on-hero);
    font-size: var(--text-base);
    font-weight: 400;
    line-height: inherit;
  }

  .map-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .map-container {
      aspect-ratio: 16 / 7;
    }
  }

  .ward-overview {
    display: grid;
    width: 100%;
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px solid rgba(242, 234, 217, 0.22);
  }

  .ward-overview h2,
  .ward-overview h3,
  .ward-overview p,
  .ward-overview ul,
  .overview-panel {
    margin: 0;
  }

  .ward-overview h2 {
    margin: 0;
    color: var(--color-hero-muted);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .overview-panel {
    display: grid;
    align-content: start;
    gap: 2px;
    min-width: 0;
  }

  .overview-panel h3 {
    font-family: inherit;
    font-weight: 400;
    line-height: inherit;
  }

  .overview-reservation dd {
    font-weight: 400;
  }

  .overview-panel p,
  .overview-panel li {
    color: var(--color-on-hero);
  }

  .key-areas {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-4);
  }

  .overview-old-wards ul {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
  }

  .overview-old-wards li {
    display: flex;
    justify-content: flex-start;
    gap: var(--space-3);
  }

  .overview-old-wards strong {
    flex: none;
    font-weight: 700;
  }

  @media (max-width: 760px) {
    .ward-details,
    .overview-grid {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }

  .map-fallback {
    margin: 0;
    color: var(--color-text-muted);
    text-align: center;
    padding: var(--space-4);
  }

  .register-slot {
    display: flex;
  }

  .ward-candidates {
    display: grid;
    gap: var(--space-4);
  }

  .ward-candidates h2,
  .candidate-empty,
  .provisional-marker {
    margin: 0;
  }

  .ward-candidates h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
  }

  .ward-candidates :global(.candidate-row .name) {
    font-size: var(--text-lg);
  }

  .candidate-empty,
  .provisional-marker,
  .status-label {
    color: var(--color-text-muted);
  }

  .provisional-marker {
    font-size: var(--text-sm);
    font-style: italic;
  }

  .candidate-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-6);
  }

  .candidate-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .status-label {
    flex: none;
    font-size: var(--text-sm);
  }

  .candidate-actions {
    display: flex;
    margin-top: var(--space-2);
  }

  .candidate-questions h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0 0 var(--space-4);
  }

  .candidate-questions ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .candidate-questions p {
    margin: 0;
  }

  .issue-vote {
    display: grid;
    gap: var(--space-4);
  }

  .issue-vote h2,
  .issue-vote > p {
    margin: 0;
  }

  .issue-vote h2 {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
  }

  .issue-vote > p {
    color: var(--color-text-muted);
  }

  .issue-vote-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  [data-show-results-wrap]:not([hidden]) {
    display: contents;
  }

  .issue-vote-results {
    list-style: none;
    margin: var(--space-2) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  :global(.issue-result) {
    display: grid;
    gap: var(--space-2);
  }

  :global(.issue-result-header) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
  }

  :global(.issue-result-title) {
    font-weight: 700;
  }

  :global(.issue-result-percentage) {
    flex: none;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  :global(.issue-result-track) {
    height: var(--space-3);
    overflow: hidden;
    border-radius: var(--radius-full);
    background: var(--color-surface);
