---
/**
 * Public candidate profile (docs/architecture.md §4). Anonymous visitors see the
 * same nine fields in both languages. Every populated value is labelled as
 * AI-extracted or checked by a person; the affidavit value links to the
 * newest stored PDF. This component never reads session state, preserving
 * the public-page caching invariant in architecture.md §5.
 */
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import AffidavitScan from '../../components/AffidavitScan.astro';
import CandidateProfileField from '../../components/CandidateProfileField.astro';
import EmptyState from '../../components/EmptyState.astro';
import { t, localePath, type Lang } from '../../i18n';
import { db } from '../../db/client';
import { candidateIdentitySelection } from '../../lib/candidate-identity';
import { candidates, candidateFields, candidateAffidavits, wards, media } from '../../db/schema';
import { desc, eq } from 'drizzle-orm';
import {
  CANDIDATE_PROFILE_FIELD_KEYS,
  CANDIDATE_PROFILE_LABEL_KEYS,
  FLAGGABLE_FIELD_KEYS,
  pickCandidateValue,
} from '../../lib/candidate-profile';
import { personLd, breadcrumbLd } from '../../lib/seo';
import { isTestCandidate } from '../../lib/demo-data';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props as Props;

const [row] = await db
  .select({
    id: candidates.id,
    slug: candidates.slug,
    wardId: candidates.wardId,
    wardNameEn: wards.nameEn,
    wardNameKn: wards.nameKn,
    ...candidateIdentitySelection(),
    status: candidates.status,
  })
  .from(candidates)
  .innerJoin(wards, eq(wards.id, candidates.wardId))
  .where(eq(candidates.slug, slug));

const candidateName = row ? (lang === 'kn' && row.nameKn ? row.nameKn : row.nameEn) : '';
const partyName = row ? (lang === 'kn' && row.partyKn ? row.partyKn : row.partyEn) : '';
// Same place label as the ward and comparison breadcrumbs: public number plus the
// localized name, with any "N - " prefix in the stored name dropped (never the
// composite route id).
const wardName = row ? (lang === 'kn' ? row.wardNameKn : row.wardNameEn).replace(/^\d+\s*-\s*/, '') : '';
const wardLabel = row ? t(lang, 'nav.ward', { wardNumber: row.wardId % 1000, wardName }) : '';

// Neutral initials placeholder — same derivation as
// CandidateRow.astro: first letter of up to the first two words of the
// English name. Never a fake/stock image.
const initials = row
  ? row.nameEn
      .trim()
      .split(/\s+/)
      .slice(0, 2)
      .map((word) => word[0]?.toUpperCase() ?? '')
      .join('')
  : '';

const fieldRows = row ? await db.select().from(candidateFields).where(eq(candidateFields.candidateId, row.id)) : [];
const fieldByKey = new Map(fieldRows.map((f) => [f.fieldKey, f]));
const [affidavit] = row
  ? await db
      .select({ mediaId: candidateAffidavits.mediaId, sha256: media.sha256 })
      .from(candidateAffidavits)
      .innerJoin(media, eq(media.id, candidateAffidavits.mediaId))
      .where(eq(candidateAffidavits.candidateId, row.id))
      .orderBy(desc(candidateAffidavits.createdAt), desc(candidateAffidavits.id))
      .limit(1)
  : [];
const affidavitUrl = affidavit ? `/media/${affidavit.mediaId}/${affidavit.sha256.slice(0, 16)}` : null;

const profileFields = CANDIDATE_PROFILE_FIELD_KEYS.map((key) => {
  const f = fieldByKey.get(key);
  const canonicalValue =
    key === 'full_name'
      ? candidateName
      : key === 'ward'
        ? wardLabel
        : key === 'party'
          ? partyName
          : key === 'ec_affidavit' && affidavitUrl
            ? t(lang, 'candidate.affidavit.view')
            : null;
  return {
    key,
    label: t(lang, CANDIDATE_PROFILE_LABEL_KEYS[key]),
    value: canonicalValue ?? pickCandidateValue(lang, f?.valueEn, f?.valueKn),
    valueUrl: key === 'ec_affidavit' ? affidavitUrl : null,
    notDeclared: f?.notDeclared ?? false,
    unreadable: (f?.unreadable ?? false) && canonicalValue === null,
    aiExtracted: f?.aiExtracted ?? false,
  };
});

const showStatusBanner = row?.status === 'withdrawn' || row?.status === 'rejected';

const pagePath = `/candidate/${slug}`;
const title = row
  ? t(lang, 'candidate.meta.title', { name: candidateName, wardName })
  : t(lang, 'candidate.notFound.fact');
const description = row
  ? t(lang, 'candidate.meta.description', { name: candidateName, party: partyName, wardName })
  : t(lang, 'candidate.notFound.fact');

// Flag misinformation — eight of the nine profile fields are flaggable targets;
// the affidavit document is not. The
// same anonymous-safe markup renders for every visitor; the client island
// applies the authentication gate when the action is used.
const flagTargets = row
  ? JSON.stringify(
      FLAGGABLE_FIELD_KEYS.map((key) => ({
        targetType: 'candidate_field',
        targetRef: `candidate:${row.id}:${key}`,
        label: t(lang, CANDIDATE_PROFILE_LABEL_KEYS[key]),
      })),
    )
  : '[]';

// Person + Breadcrumb JSON-LD (architecture §8/§13, Task 56) — built from
// data this page already loaded, via the shared src/lib/seo.ts builders.
// The breadcrumb's "Home" node uses the static, untranslated "Bengaluru
// Votes" brand string — same convention AppBar.astro's own logo text/
// aria-label already uses (never machine-translated), avoiding a new i18n
// key for a nice-to-have trail.
const candidateJsonLd = row
  ? [
      personLd({ name: candidateName, party: partyName || null, path: localePath(lang, pagePath) }),
      breadcrumbLd([
        { name: 'Bengaluru Votes', url: localePath(lang, '/') },
        { name: wardName, url: localePath(lang, `/ward/${row.wardId}`) },
        { name: candidateName, url: localePath(lang, pagePath) },
      ]),
    ]
  : [];
---

<Base lang={lang} title={title} description={description} path={pagePath} jsonLd={candidateJsonLd} noindex={isTestCandidate({ slug, nameEn: row?.nameEn })}>
  {
    row ? (
      <div class="candidate">

        {showStatusBanner && (
          <Banner kind="notice" lang={lang}>
            {t(lang, `candidate.statusBanner.${row.status as 'withdrawn' | 'rejected'}`)}
          </Banner>
        )}

        <header class="candidate-hero">
          <div class="candidate-container hero-content">
            <Breadcrumbs lang={lang} items={[
              { label: t(lang, 'nav.home'), href: localePath(lang, '/') },
              { label: wardLabel, href: localePath(lang, `/ward/${row.wardId}`) },
              { label: candidateName },
            ]} />
            <div class="candidate-header">
              <span class="photo photo--placeholder" aria-hidden="true">
                {initials}
              </span>
              <div class="identity">
                <h1 class="name">{candidateName}</h1>
                <p class="party">{partyName}</p>
                <p class="ec-source-note">{t(lang, 'candidate.header.sourceEcNomination')}</p>
              </div>
            </div>
          </div>
        </header>

        <div class="candidate-container candidate-body">
        <div class="candidate-actions">
          <Button variant="secondary" href={localePath(lang, `/ward/${row.wardId}/compare`)} lang={lang}>
            {t(lang, 'candidate.links.compare')}
          </Button>
          <Button
            variant="tertiary"
            type="button"
            lang={lang}
            data-flag-action
            data-ward-id={row.wardId}
            data-flag-targets={flagTargets}
          >
            {t(lang, 'common.flagError')}
          </Button>
        </div>

        <div class:list={['report-layout', { 'report-layout--with-pdf': affidavitUrl }]}>
          <div class="report-fields">
            <Card>
              <div class="field-rows">
                {profileFields.map((field) => (
                  <CandidateProfileField
                    label={field.label}
                    value={field.value}
                    valueUrl={field.valueUrl}
                    notDeclared={field.notDeclared}
                    unreadable={field.unreadable}
                    aiExtracted={field.aiExtracted}
                    showVerification={field.key !== 'ec_affidavit'}
                    lang={lang}
                  />
                ))}
              </div>
            </Card>
          </div>
          {affidavitUrl && (
            <aside class="report-pdf" aria-label={t(lang, 'transcribe.reading.pdfTitle')}>
              <AffidavitScan lang={lang} pdfUrl={affidavitUrl} />
            </aside>
          )}
        </div>

        </div>
      </div>
    ) : (
      <EmptyState fact={t(lang, 'candidate.notFound.fact')} />
    )
  }
</Base>

<style>
  .candidate {
    display: flex;
    flex-direction: column;
  }

  .candidate-container {
    width: 100%;
    max-width: var(--container-app);
    margin-inline: auto;
    padding-inline: var(--container-pad-x);
    box-sizing: border-box;
  }

  /* Dark identity band (design-system §6.4, §7.15): breadcrumbs above the identity. */
  .candidate-hero {
    padding-block: var(--space-8);
    background: var(--color-hero-bg);
    color: var(--color-on-hero);
  }

  .hero-content {
    display: grid;
    gap: var(--space-4);
  }

  .candidate-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .candidate-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .report-fields {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .report-pdf {
    display: none;
  }

  @media (min-width: 768px) {
    .candidate-hero {
      padding-block: var(--space-12);
    }

    .report-layout--with-pdf {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-6);
      align-items: start;
    }

    .report-pdf {
      display: flex;
      position: sticky;
      top: calc(80px + var(--space-4));
      height: calc(100dvh - 80px - var(--space-8));
      min-width: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      overflow: hidden;
    }

    .report-pdf :global(.scan) {
      width: 100%;
      border-right: 0;
    }
  }

  .candidate-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .photo {
    flex: none;
    width: 96px;
    height: 96px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
  }

  .photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-2xl);
    color: var(--color-text-muted);
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .name {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: var(--leading-3xl);
    margin: 0;
    color: var(--color-on-hero);
  }

  .party {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-on-hero);
  }

  .ec-source-note {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-hero-muted);
  }

  .field-rows {
    display: flex;
    flex-direction: column;
  }

  .field-rows > :global(*:not(:last-child)) {
    border-bottom: 1px solid var(--color-border);
  }
</style>
