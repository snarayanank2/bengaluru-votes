---
/**
 * Public candidate profile (milestones.md §5). Anonymous visitors see the
 * same nine fields in both languages. Every populated value is labelled as
 * AI-extracted or checked by a person; the affidavit value links to the
 * newest stored PDF. This component never reads session state, preserving
 * the public-page caching invariant in architecture.md §5.
 */
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import Button from '../../components/Button.astro';
import Card from '../../components/Card.astro';
import CandidateProfileField from '../../components/CandidateProfileField.astro';
import EmptyState from '../../components/EmptyState.astro';
import { t, localePath, type Lang } from '../../i18n';
import { db } from '../../db/client';
import { candidates, candidateFields, candidateAffidavits, wards, media } from '../../db/schema';
import { desc, eq } from 'drizzle-orm';
import {
  CANDIDATE_PROFILE_FIELD_KEYS,
  CANDIDATE_PROFILE_LABEL_KEYS,
  pickCandidateValue,
} from '../../lib/candidate-profile';
import { getKnownSetting } from '../../lib/settings';
import { personLd, breadcrumbLd } from '../../lib/seo';

interface Props {
  lang: Lang;
  slug: string;
}

const { lang, slug } = Astro.props as Props;

const [row] = await db
  .select({
    id: candidates.id,
    slug: candidates.slug,
    wardId: candidates.wardId,
    wardNameEn: wards.nameEn,
    wardNameKn: wards.nameKn,
    nameEn: candidates.nameEn,
    nameKn: candidates.nameKn,
    partyEn: candidates.partyEn,
    partyKn: candidates.partyKn,
    photoMediaId: candidates.photoMediaId,
    photoHash: media.sha256,
    status: candidates.status,
  })
  .from(candidates)
  .innerJoin(wards, eq(wards.id, candidates.wardId))
  .leftJoin(media, eq(media.id, candidates.photoMediaId))
  .where(eq(candidates.slug, slug));

const candidateName = row ? (lang === 'kn' && row.nameKn ? row.nameKn : row.nameEn) : '';
const partyName = row ? (lang === 'kn' && row.partyKn ? row.partyKn : row.partyEn) : '';
const wardName = row ? (lang === 'kn' ? row.wardNameKn : row.wardNameEn) : '';
const photoUrl = row?.photoMediaId != null && row.photoHash ? `/media/${row.photoMediaId}/${row.photoHash.slice(0, 16)}` : null;

// Neutral initials placeholder (no photo) — same derivation as
// CandidateRow.astro: first letter of up to the first two words of the
// English name. Never a fake/stock image.
const initials = row
  ? row.nameEn
      .trim()
      .split(/\s+/)
      .slice(0, 2)
      .map((word) => word[0]?.toUpperCase() ?? '')
      .join('')
  : '';

const fieldRows = row ? await db.select().from(candidateFields).where(eq(candidateFields.candidateId, row.id)) : [];
const fieldByKey = new Map(fieldRows.map((f) => [f.fieldKey, f]));
const [affidavit] = row
  ? await db
      .select({ mediaId: candidateAffidavits.mediaId, sha256: media.sha256 })
      .from(candidateAffidavits)
      .innerJoin(media, eq(media.id, candidateAffidavits.mediaId))
      .where(eq(candidateAffidavits.candidateId, row.id))
      .orderBy(desc(candidateAffidavits.createdAt), desc(candidateAffidavits.id))
      .limit(1)
  : [];
const affidavitUrl = affidavit ? `/media/${affidavit.mediaId}/${affidavit.sha256.slice(0, 16)}` : null;

const profileFields = CANDIDATE_PROFILE_FIELD_KEYS.map((key) => {
  const f = fieldByKey.get(key);
  const canonicalValue =
    key === 'full_name'
      ? candidateName
      : key === 'ward'
        ? wardName
        : key === 'party'
          ? partyName
          : key === 'ec_affidavit' && affidavitUrl
            ? t(lang, 'candidate.affidavit.view')
            : null;
  return {
    key,
    label: t(lang, CANDIDATE_PROFILE_LABEL_KEYS[key]),
    value: canonicalValue ?? pickCandidateValue(lang, f?.valueEn, f?.valueKn),
    valueUrl: key === 'ec_affidavit' ? affidavitUrl : null,
    notDeclared: f?.notDeclared ?? false,
    aiExtracted: f?.aiExtracted ?? false,
  };
});

const withdrawalsClosedSetting = await getKnownSetting('withdrawals_closed');
const isProvisional = withdrawalsClosedSetting !== 'true';

const showStatusBanner = row?.status === 'withdrawn' || row?.status === 'rejected';

const pagePath = `/candidate/${slug}`;
const title = row
  ? t(lang, 'candidate.meta.title', { name: candidateName, wardName })
  : t(lang, 'candidate.notFound.fact');
const description = row
  ? t(lang, 'candidate.meta.description', { name: candidateName, party: partyName, wardName })
  : t(lang, 'candidate.notFound.fact');

// Flag misinformation — all nine profile fields are flaggable targets. The
// same anonymous-safe markup renders for every visitor; the client island
// applies the authentication gate when the action is used.
const flagTargets = row
  ? JSON.stringify(
      CANDIDATE_PROFILE_FIELD_KEYS.map((key) => ({
        targetType: 'candidate_field',
        targetRef: `candidate:${row.id}:${key}`,
        label: t(lang, CANDIDATE_PROFILE_LABEL_KEYS[key]),
      })),
    )
  : '[]';

// Person + Breadcrumb JSON-LD (architecture §8/§13, Task 56) — built from
// data this page already loaded, via the shared src/lib/seo.ts builders.
// The breadcrumb's "Home" node uses the static, untranslated "Bengaluru
// Votes" brand string — same convention AppBar.astro's own logo text/
// aria-label already uses (never machine-translated), avoiding a new i18n
// key for a nice-to-have trail.
const candidateJsonLd = row
  ? [
      personLd({ name: candidateName, party: partyName || null, path: localePath(lang, pagePath) }),
      breadcrumbLd([
        { name: 'Bengaluru Votes', url: localePath(lang, '/') },
        { name: wardName, url: localePath(lang, `/ward/${row.wardId}`) },
        { name: candidateName, url: localePath(lang, pagePath) },
      ]),
    ]
  : [];
---

<Base lang={lang} title={title} description={description} path={pagePath} jsonLd={candidateJsonLd}>
  {
    row ? (
      <div class="candidate">
        {isProvisional && <p class="provisional-marker">{t(lang, 'candidate.provisionalMarker')}</p>}

        {showStatusBanner && (
          <Banner kind="notice" lang={lang}>
            {t(lang, `candidate.statusBanner.${row.status as 'withdrawn' | 'rejected'}`)}
          </Banner>
        )}

        <header class="candidate-header">
          {photoUrl ? (
            <img class="photo" src={photoUrl} width="96" height="96" alt="" loading="lazy" />
          ) : (
            <span class="photo photo--placeholder" aria-hidden="true">
              {initials}
            </span>
          )}
          <div class="identity">
            <h1 class="name">{candidateName}</h1>
            <p class="party">{partyName}</p>
            <p class="ward-line">
              <a href={localePath(lang, `/ward/${row.wardId}`)}>{wardName}</a>
            </p>
          </div>
        </header>
        <p class="ec-source-note">{t(lang, 'candidate.header.sourceEcNomination')}</p>

        <Button
          variant="tertiary"
          type="button"
          lang={lang}
          data-flag-action
          data-ward-id={row.wardId}
          data-flag-targets={flagTargets}
        >
          {t(lang, 'common.flagError')}
        </Button>

        <Card>
          <div class="field-rows">
            {profileFields.map((field) => (
              <CandidateProfileField
                label={field.label}
                value={field.value}
                valueUrl={field.valueUrl}
                notDeclared={field.notDeclared}
                aiExtracted={field.aiExtracted}
                showVerification={field.key !== 'ec_affidavit'}
                lang={lang}
              />
            ))}
          </div>
        </Card>

        <nav class="candidate-links" aria-label={t(lang, 'candidate.links.label')}>
          <a href={localePath(lang, `/ward/${row.wardId}/compare`)}>{t(lang, 'candidate.links.compare')}</a>
        </nav>
      </div>
    ) : (
      <EmptyState fact={t(lang, 'candidate.notFound.fact')} />
    )
  }
</Base>

<style>
  .candidate {
    max-width: var(--container-app);
    margin-inline: auto;
    padding: var(--space-8) var(--container-pad-x);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .provisional-marker {
    margin: 0;
    font-size: var(--text-sm);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .candidate-header {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .photo {
    flex: none;
    width: 96px;
    height: 96px;
    border-radius: var(--radius-full);
    object-fit: cover;
    background: var(--color-surface);
  }

  .photo--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-2xl);
    color: var(--color-text-muted);
  }

  .identity {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .name {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: var(--leading-3xl);
    margin: 0;
  }

  .party {
    margin: 0;
    font-size: var(--text-base);
    color: var(--color-text);
  }

  .ward-line {
    margin: 0;
    font-size: var(--text-sm);
  }

  .ward-line a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .ward-line a:hover,
  .ward-line a:focus-visible {
    text-decoration: underline;
  }

  .ec-source-note {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .field-rows {
    display: flex;
    flex-direction: column;
  }

  .field-rows > :global(*:not(:last-child)) {
    border-bottom: 1px solid var(--color-border);
  }

  .candidate-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .candidate-links a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }

  .candidate-links a:hover,
  .candidate-links a:focus-visible {
    text-decoration: underline;
  }
</style>
