---
/**
 * `/login` (`/kn/login`) — staff sign-in. Citizens never sign in.
 *
 * One server-rendered email + password form, posted with a standard POST.
 * Purely presentational: the POST is handled by src/lib/login-flow.ts
 * (`handleLoginPost`), called by the route twins (src/pages/login.astro,
 * src/pages/kn/login.astro) — a redirect on success can only happen at the
 * page level (see src/pages/ward/[id].astro's header comment for why).
 *
 * The password is the account's own (src/lib/staff-login.ts), set by an admin.
 * An account without one, like any wrong pair, fails with the same generic error.
 *
 * noindex: true belt-and-braces (src/middleware.ts already sends
 * X-Robots-Tag: noindex for every /login response).
 */
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Banner from '../../components/Banner.astro';
import { t, type Lang } from '../../i18n';
import type { LoginRenderState } from '../../lib/login-flow';

interface Props {
  lang: Lang;
  state: LoginRenderState;
}

const { lang, state } = Astro.props;
const errorText = state.error ? t(lang, state.error) : undefined;
const noticeText = !errorText && state.notice ? t(lang, state.notice) : undefined;
---

<Base
  lang={lang}
  title={t(lang, 'auth.password.meta.title')}
  description={t(lang, 'auth.password.meta.description')}
  path="/login"
  noindex={true}
>
  <div class="login-page">
    <h1>{t(lang, 'auth.password.heading')}</h1>

    {
      errorText && (
        <div class="login-banner">
          <Banner kind="error" lang={lang}>
            {errorText}
          </Banner>
        </div>
      )
    }

    {
      noticeText && (
        <div class="login-banner">
          <Banner kind="notice" lang={lang}>
            {noticeText}
          </Banner>
        </div>
      )
    }

    <form method="post" novalidate>
      <input type="hidden" name="next" value={state.next} />
      <div class="form-field">
        <label class="form-label" for="login-destination">
          {t(lang, 'auth.password.contactLabel')}
        </label>
        <input
          id="login-destination"
          class="form-input"
          name="destination"
          type="text"
          autocomplete="username"
          value={state.destination ?? ''}
          required
        />
      </div>
      <div class="form-field">
        <label class="form-label" for="login-password">
          {t(lang, 'auth.password.passwordLabel')}
        </label>
        <input
          id="login-password"
          class="form-input"
          name="password"
          type="password"
          autocomplete="current-password"
          required
        />
      </div>
      <Button type="submit" variant="primary" lang={lang}>
        {t(lang, 'auth.password.submit')}
      </Button>
    </form>
  </div>
</Base>

<style>
  .login-page {
    max-width: var(--container-prose);
    margin-inline: auto;
    padding-block: var(--space-8);
    padding-inline: var(--container-pad-x);
  }

  .login-page h1 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0 0 var(--space-6);
  }

  /* Same width as the form beneath it, with the field-to-field gap below. */
  .login-banner {
    max-width: 24rem;
    margin-block-end: var(--space-4);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 24rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .form-input {
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .form-input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-color: var(--color-primary);
  }

  .helper {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .consent {
    margin: 0;
    font-size: var(--text-sm);
  }

  .checkbox {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
</style>
