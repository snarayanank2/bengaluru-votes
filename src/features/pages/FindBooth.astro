---
/**
 * Find your polling booth (`/voting-guide/find-booth`,
 * `/kn/voting-guide/find-booth`).
 *
 * INPUT IS A VOTER ID (EPIC) NUMBER since 2026-08-19. The page used to take
 * an address and resolve it against a local `booths` table that was never
 * populated, so every real visitor got "we don't have booth data yet" — see
 * `src/pages/api/booth-lookup.ts` for the full account. Booth data now comes
 * from the BBMP electoral API, which answers an EPIC with the citizen's
 * polling station, their serial number on its roll, and the ward.
 *
 * Mirrors Home.astro's no-JS-first pattern: the form is a real
 * `<form method="post">` that, with JS disabled, POSTs back to this page and
 * the branch below server-renders the result using the SAME function
 * `/api/booth-lookup` uses (`lookupBoothByEpic` — imported directly, never
 * fetched). With JS enabled, `src/islands/BoothLookup.ts` intercepts the
 * submit and paints the result inline. The home page's booth card posts
 * HERE, so a no-JS visitor who starts there finishes on this page.
 *
 * The form and its result markup live in `src/components/BoothLookupForm.astro`
 * because this page and the home card render the same thing.
 *
 * ALWAYS-VISIBLE GUIDED LINK-OUT: a card linking to the official
 * EC/CEO Karnataka booth finder renders unconditionally below the form — not
 * only after a failed lookup. Our lookup depends on a third-party government
 * API we do not run and cannot fix, so the alternative has to be on the page
 * before it is needed, and every failure message points back to it.
 *
 * CACHE-SAFETY: the GET render never reads cookies/session, only
 * app_settings (`booth_lookup_url`) — safe under the anonymous-page
 * micro-cache. The POST branch is a per-request lookup carrying the voter's
 * own name and EPIC and is explicitly `cache-control: no-store`, mirroring
 * Home.astro exactly. Nothing about a POST may leak into the GET render.
 */
import Prose from '../../layouts/Prose.astro';
import BoothLookupForm from '../../components/BoothLookupForm.astro';
import ExternalLinkOut from '../../components/ExternalLinkOut.astro';
import Card from '../../components/Card.astro';
import { t, type Lang } from '../../i18n';
import { getPageContent } from '../../i18n/content';
import { renderContentHtml, splitMarkdownSections } from '../../lib/render-content';
import { getSettings } from '../../lib/settings';
import { lookupBoothByEpic, type BoothLookupResult } from '../../lib/booth-lookup';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = getPageContent(lang, 'find-booth');
if (!content) {
  throw new Error('FindBooth: missing content/pages/en/find-booth.md');
}

const sections = splitMarkdownSections(content.body);
// [ "## How do I find my polling booth?", "## What if my voter ID isn't found?" ]
const introSection = sections[0] ?? '';
const fallbackSection = sections.slice(1).join('');

let postResult: BoothLookupResult | null = null;

// No-JS fallback path (see file header). Only ever runs for a POST; the GET
// render below is unaffected and stays cacheable.
if (Astro.request.method === 'POST') {
  Astro.response.headers.set('cache-control', 'no-store');

  const form = await Astro.request.formData();
  const epic = String(form.get('epic') ?? '').trim();

  if (epic.length > 0) {
    postResult = await lookupBoothByEpic(epic);
  } else {
    // Defensive only — the input carries `required`. Reported as "no such
    // record" rather than an outage: nothing failed, there was nothing to
    // look up.
    postResult = { result: 'not_found' };
  }
}

const settings = await getSettings(['booth_lookup_url']);
---

<Prose lang={lang} title={content.title} description={content.description} path="/voting-guide/find-booth">
  <div set:html={renderContentHtml(introSection, lang)} />

  <BoothLookupForm lang={lang} result={postResult} />

  <Card>
    <h2>{t(lang, 'findBooth.linkOut.heading')}</h2>
    <ExternalLinkOut lang={lang} href={settings.booth_lookup_url} label={t(lang, 'findBooth.linkOut.label')} />
  </Card>

  <div set:html={renderContentHtml(fallbackSection, lang)} />

  <script>
    import { initBoothLookup } from '../../islands/BoothLookup';
    initBoothLookup();
  </script>
</Prose>
