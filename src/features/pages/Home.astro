---
/**
 * Home (`/`, `/kn/`) — information-architecture.md §3.1, PRD §5.1/§5.7.
 *
 * Renders through Base with a reference-style hero for the ward lookup and a
 * separate full-width booth lookup section below it. The two forms share no
 * machinery; they are simply two ways to find where to vote.
 *
 * The ward form is a REAL `<form method="post">` — with JS disabled it POSTs back to
 * this same page and this file's `Astro.request.method === 'POST'` branch
 * below server-renders the result using the SAME resolution function the
 * `/api/ward-lookup` endpoint uses (`lookupWardByAddress` — imported
 * directly, never fetched). With JS enabled, `src/islands/WardLookup.ts`
 * intercepts the submit and calls the API instead, painting the result
 * inline without a page reload.
 *
 * The booth card is `src/components/BoothLookupForm.astro`, handled by the
 * JavaScript island through /api/booth-lookup. Its legacy form action is
 * retained, but the old guide route has been removed. This file has no
 * booth POST branch; public booth lookup requires JavaScript.
 *
 * CACHE-SAFETY: the GET render below never reads cookies/session and reads
 * app_settings only (src/lib/settings.ts — safe under the anonymous-page
 * micro-cache, see that file's header). The POST branch is a per-request
 * geocode lookup and is explicitly marked `cache-control: no-store`; it
 * never touches the GET response. The booth card adds nothing to this: it
 * never POSTs here, so no personal data from a booth lookup can ever reach
 * this page's cacheable render.
 */
import { eq } from 'drizzle-orm';
import Base from '../../layouts/Base.astro';
import Card from '../../components/Card.astro';
import BoothLookupForm from '../../components/BoothLookupForm.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
import { t, localePath, type Lang } from '../../i18n';
import { lookupWardByAddress } from '../../lib/geocode';
import { mapsConfig } from '../../lib/maps-config';
import { db } from '../../db/client';
import { wards } from '../../db/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type WardRow = { id: number; nameEn: string; nameKn: string; corporation: string };

type LookupResult =
  | { result: 'ward'; ward: WardRow }
  | { result: 'out_of_coverage' }
  | { result: 'ambiguous' }
  | { result: 'unavailable'; reason: 'budget' | 'failed' };

let postResult: LookupResult | null = null;

// No-JS fallback path (see file header). Only ever runs for a POST; the GET
// render below is unaffected and stays cacheable.
//
// Address is the only input mode — pincode lookup was removed 2026-08-14.
// The reasoning, and the consequence (no fallback when geocoding is
// unavailable), is in the header of src/pages/api/ward-lookup.ts. This
// branch must keep mirroring that endpoint's result kinds exactly, since
// the two render the same four states.
if (Astro.request.method === 'POST') {
  Astro.response.headers.set('cache-control', 'no-store');

  const form = await Astro.request.formData();
  const query = String(form.get('query') ?? '').trim();

  if (query.length > 0) {
    const lookup = await lookupWardByAddress(query);
    switch (lookup.kind) {
      case 'ward': {
        const [row] = await db.select().from(wards).where(eq(wards.id, lookup.wardId));
        postResult = row ? { result: 'ward', ward: row } : { result: 'unavailable', reason: 'failed' };
        break;
      }
      case 'out_of_coverage':
        postResult = { result: 'out_of_coverage' };
        break;
      case 'ambiguous':
        postResult = { result: 'ambiguous' };
        break;
      case 'budget_exhausted':
        postResult = { result: 'unavailable', reason: 'budget' };
        break;
      case 'failed':
        postResult = { result: 'unavailable', reason: 'failed' };
        break;
    }
  } else {
    // Defensive only — the input carries `required`, so an empty query
    // should never reach here from a real browser submit.
    postResult = { result: 'unavailable', reason: 'failed' };
  }
}

// Places Autocomplete on the lookup input (src/islands/WardLookup.ts). Same
// runtime-config discipline as the ward map: read here, handed over as a data
// attribute, never a build-time PUBLIC_* var — see src/lib/maps-config.ts.
// When maps are off the attribute is `undefined`, which Astro omits entirely,
// so the key never reaches the HTML and the island does nothing.
const maps = mapsConfig();

function wardHref(id: number): string {
  return localePath(lang, `/ward/${id}`);
}

function wardName(ward: WardRow): string {
  return lang === 'kn' ? ward.nameKn : ward.nameEn;
}
---

<Base
  lang={lang}
  title={t(lang, 'home.meta.title')}
  description={t(lang, 'home.meta.description')}
  path="/"
>
  <div class="home">
    <section class="home-hero">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="hero-eyebrow eyebrow">{t(lang, 'home.hero.eyebrow')}</p>
          <h1>{t(lang, 'home.hero.heading')}</h1>
          <p class="hero-subheading">{t(lang, 'home.hero.subheading')}</p>

          <form
            method="post"
            action={localePath(lang, '/')}
            class="hero-form"
            data-ward-lookup
            data-lang={lang}
            data-msg-ambiguous={t(lang, 'home.result.ambiguous')}
            data-msg-out-of-coverage={t(lang, 'home.result.outOfCoverage')}
            data-msg-unavailable={t(lang, 'home.result.unavailable')}
            data-msg-use-location={t(lang, 'home.form.useLocation')}
            data-msg-locating={t(lang, 'home.form.locating')}
            data-msg-location-approximate={t(lang, 'home.result.locationApproximate')}
            data-msg-location-denied={t(lang, 'home.result.locationDenied')}
            data-msg-location-unavailable={t(lang, 'home.result.locationUnavailable')}
            data-maps-key={maps.enabled ? maps.browserKey : undefined}
          >
            <div class="hero-query">
              <FormField
                label={t(lang, 'home.form.label')}
                name="query"
                type="search"
                placeholder={t(lang, 'home.form.placeholder')}
                helper={t(lang, 'home.form.helper')}
                required
                lang={lang}
              />
            </div>
            <Button type="submit" variant="secondary" lang={lang}>
              {t(lang, 'home.form.submit')}
            </Button>

            <div
              class={postResult?.result === 'ward' ? 'ward-result ward-result--success' : 'ward-result'}
              data-ward-result
              data-result-state={postResult?.result ?? undefined}
              aria-live="polite"
            >
              {postResult?.result === 'ward' && (
                <p>
                  <a href={wardHref(postResult.ward.id)}>{wardName(postResult.ward)}</a>
                </p>
              )}
              {postResult?.result === 'out_of_coverage' && <p>{t(lang, 'home.result.outOfCoverage')}</p>}
              {postResult?.result === 'ambiguous' && <p>{t(lang, 'home.result.ambiguous')}</p>}
              {postResult?.result === 'unavailable' && <p>{t(lang, 'home.result.unavailable')}</p>}
            </div>
          </form>
        </div>

        <div class="hero-stats" aria-label="Key election facts">
          <div class="hero-stat"><strong>369</strong><span>{t(lang, 'home.hero.stats.wards')}</span></div>
          <div class="hero-stat"><strong>05</strong><span>{t(lang, 'home.hero.stats.corporations')}</span></div>
          <div class="hero-stat"><strong>01</strong><span>{t(lang, 'home.hero.stats.councillor')}</span></div>
          <div class="hero-stat hero-stat--accent"><strong>10</strong><span>{t(lang, 'home.hero.stats.years')}</span></div>
        </div>
      </div>
    </section>

    <section class="why-vote-section" aria-labelledby="why-vote-title">
      <div class="why-vote-inner">
        <div class="why-vote-heading">
          <div class="why-vote-kicker">
            <span class="why-vote-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 10h16v9a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z" />
                <path d="M4 10l3-6h10l3 6" />
                <path d="m9.5 13.5 2 2 4-4" />
              </svg>
            </span>
            <span class="why-vote-eyebrow eyebrow">{t(lang, 'home.whyVote.eyebrow')}</span>
          </div>
          <h2 id="why-vote-title">{t(lang, 'home.whyVote.title')}</h2>
        </div>

        <div class="why-vote-content">
          <p>{t(lang, 'home.whyVote.paragraph1')}</p>
          <p>{t(lang, 'home.whyVote.paragraph2')}</p>
          <p>{t(lang, 'home.whyVote.paragraph3')}</p>
          <p>{t(lang, 'home.whyVote.paragraph4')}</p>
          <p>{t(lang, 'home.whyVote.paragraph5')}</p>
          <p><strong>{t(lang, 'home.whyVote.closing')}</strong></p>

          <div class="why-vote-pills" aria-label={t(lang, 'home.whyVote.title')}>
            <span>{t(lang, 'home.whyVote.tag.roads')}</span>
            <span>{t(lang, 'home.whyVote.tag.parks')}</span>
            <span>{t(lang, 'home.whyVote.tag.sanitation')}</span>
            <span>{t(lang, 'home.whyVote.tag.drainage')}</span>
            <span>{t(lang, 'home.whyVote.tag.streetlights')}</span>
          </div>
        </div>
      </div>
    </section>

    <section class="basics-section" aria-labelledby="basics-title">
      <div class="basics-inner">
        <div class="basics-heading">
          <p class="basics-eyebrow eyebrow">{t(lang, 'home.basics.eyebrow')}</p>
          <h2 id="basics-title">{t(lang, 'home.basics.title')}</h2>
        </div>

        <div class="basics-list">
          <details class="basics-item" open>
            <summary><span class="basics-number">01</span>{t(lang, 'home.basics.item1.title')}<span class="basics-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg></span></summary>
            <p>{t(lang, 'home.basics.item1.body')}</p>
          </details>
          <details class="basics-item">
            <summary><span class="basics-number">02</span>{t(lang, 'home.basics.item2.title')}<span class="basics-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg></span></summary>
            <p>{t(lang, 'home.basics.item2.body')}</p>
          </details>
          <details class="basics-item">
            <summary><span class="basics-number">03</span>{t(lang, 'home.basics.item3.title')}<span class="basics-chevron" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6" /></svg></span></summary>
            <p>{t(lang, 'home.basics.item3.body')}</p>
          </details>
        </div>
      </div>
    </section>

    <section class="booth-section">
      <div class="booth-inner">
        <Card>
        <h2>{t(lang, 'home.shortcuts.findBooth.title')}</h2>
        <p class="subheading">{t(lang, 'home.shortcuts.findBooth.description')}</p>
        <BoothLookupForm lang={lang} />
        </Card>
      </div>
    </section>

  </div>

  <script>
    import { initWardLookup } from '../../islands/WardLookup';
    import { initBoothLookup } from '../../islands/BoothLookup';
    initWardLookup();
    // Homepage booth lookup uses the API and renders the result in place.
    initBoothLookup();
  </script>
</Base>

<style>
.home {
  display: flex;
  flex-direction: column;
  gap: 0;
}

  .home-hero {
    width: 100%;
    background: var(--color-hero-bg);
    color: var(--color-on-hero);
  }

  .hero-inner,
  .why-vote-inner,
  .booth-inner {
    max-width: var(--container-app);
    margin-inline: auto;
    padding-inline: var(--container-pad-x);
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 260px;
    align-items: center;
    gap: var(--space-8);
    padding-block: var(--space-12);
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    margin: 0 0 var(--space-4);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-full);
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .hero-copy h1 {
    max-width: 34ch;
    margin: 0 0 var(--space-3);
    color: var(--color-on-hero);
    font-family: var(--font-heading);
    font-size: var(--text-4xl);
    line-height: var(--leading-4xl);
  }

  .hero-subheading {
    max-width: 64ch;
    margin: 0 0 var(--space-6);
    color: var(--color-hero-muted);
    font-size: var(--text-base);
    line-height: var(--leading-lg);
  }

  .hero-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: end;
    gap: var(--space-2);
    max-width: 54rem;
  }

  .hero-query {
    min-width: 0;
    grid-column: 1;
  }

  .hero-form :global(.form-label),
  .hero-form :global(.form-helper) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .hero-form :global(.form-input) {
    width: 100%;
    min-height: 48px;
    background: var(--color-bg);
    border-color: var(--color-bg);
  }

  .hero-form :global(.btn) {
    grid-column: 2;
    min-height: 48px;
    white-space: nowrap;
    font-family: Manrope, 'PT Sans', system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-hero-button-text);
    transition: transform 0.18s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.18s, background-color 0.18s, filter 0.18s;
  }

  .hero-form :global(.btn:hover) {
    transform: translateY(-1px);
    box-shadow: var(--shadow-hero-button-hover);
    background: var(--hero-button-hover);
  }

  .hero-form :global(.ward-locate) {
    grid-column: 3;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    min-height: 48px;
    padding: var(--space-2) var(--space-4);
    border: 1.5px solid var(--color-bg);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
  }

  .hero-form :global(.ward-locate-label) {
    display: none;
  }

  .hero-form :global(.ward-locate:hover),
  .hero-form :global(.ward-locate:focus-visible) {
    background: var(--color-surface);
  }

  .hero-form .ward-result {
    grid-column: 1 / -1;
    grid-row: 2;
    align-self: start;
    color: var(--color-on-hero);
  }

  .hero-form .ward-result[data-result-state]:not([data-result-state="success"]) {
    grid-column: 1;
    width: 100%;
  }

  .hero-form .ward-result:has(> *) {
    width: fit-content;
    max-width: 100%;
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-3);
    border-left: 3px solid var(--color-accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    background: var(--color-hero-surface);
  }

  .hero-form .ward-result :global(p) {
    margin: 0;
    color: var(--color-hero-muted);
    line-height: var(--leading-md);
  }

  .hero-form .ward-result :global(a) {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-weight: 700;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .hero-form .ward-result :global(a:hover),
  .hero-form .ward-result :global(a:focus-visible) {
    color: var(--color-on-hero);
  }

  .hero-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }

  .hero-stat {
    min-height: 86px;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--color-hero-surface);
  }

  .hero-stat strong,
  .hero-stat span {
    display: block;
  }

  .hero-stat strong {
    margin-bottom: var(--space-2);
    color: var(--color-on-hero);
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    line-height: 1;
  }

  .hero-stat span {
    color: var(--color-hero-muted);
    font-size: var(--text-xs);
  }

  .hero-stat--accent {
    background: var(--color-hero-alert);
  }

  .why-vote-section {
    background: var(--color-why-vote-bg);
    color: var(--color-why-vote-text);
  }

  .why-vote-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-8);
    padding-block: var(--space-8);
  }

  .why-vote-heading {
    min-width: 0;
  }

  .why-vote-kicker {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-block-end: var(--space-3);
  }

  .why-vote-icon {
    display: inline-flex;
    color: var(--color-why-vote-text);
  }

  .why-vote-eyebrow {
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .why-vote-heading h2 {
    max-width: 22ch;
    margin: 0;
    color: var(--color-why-vote-ink);
    font-family: var(--font-heading);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .why-vote-content {
    min-width: 0;
  }

  .why-vote-content p {
    margin: 0 0 var(--space-3);
    color: var(--color-why-vote-ink);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .why-vote-content p:last-of-type {
    margin-block-end: var(--space-4);
  }

  .why-vote-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .why-vote-pills span {
    padding: 3px 10px;
    border-radius: var(--radius-full);
    background: var(--color-why-vote-pill);
    color: var(--color-why-vote-ink);
    font-size: var(--text-xs);
    font-weight: 700;
    line-height: 1.5;
  }

  .basics-section {
    padding-block: var(--space-8);
    background: var(--color-bg);
    color: var(--color-why-vote-ink);
  }

  .basics-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-8);
    max-width: var(--container-app);
    margin-inline: auto;
    padding-inline: var(--container-pad-x);
  }

  .basics-eyebrow {
    margin: 0 0 var(--space-2);
    color: var(--color-hero-alert);
    font-family: var(--font-heading);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .basics-heading h2 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .basics-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .basics-item {
    padding: var(--space-4);
    border: 1px solid var(--color-basics-border);
    border-radius: 11px;
    background: var(--color-bg);
    transition: box-shadow 0.18s;
  }

  .basics-item[open] {
    box-shadow: var(--shadow-hero-button-hover);
  }

  .basics-item summary {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-why-vote-ink);
    font-weight: 600;
    line-height: 1.5;
    cursor: pointer;
    list-style: none;
  }

  .basics-item summary::-webkit-details-marker {
    display: none;
  }

  .basics-number {
    flex: 0 0 auto;
    color: var(--color-hero-alert);
    font-family: var(--font-heading);
    font-size: 0.85rem;
    font-weight: 800;
  }

  .basics-chevron {
    display: inline-flex;
    flex: 0 0 auto;
    margin-inline-start: auto;
    color: var(--color-basics-muted);
    transition: transform 0.18s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .basics-item[open] .basics-chevron {
    transform: rotate(180deg);
  }

  .basics-item p {
    margin: 10px 0 2px;
    color: var(--color-why-vote-ink);
    font-size: 1rem;
    line-height: 1.5;
  }

  .booth-section {
    padding-block: var(--space-8);
    background: var(--color-methodology-bg);
    color: var(--color-methodology-text);
  }

  .booth-inner :global(.card) {
    max-width: none;
    margin-inline: auto;
    background: transparent;
    border-color: transparent;
    padding: 0;
  }

  .booth-inner h2 {
    margin-block-start: 0;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    line-height: 1.2;
  }

  .booth-inner :global(.booth-form) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    max-width: none;
    margin-block: var(--space-6) 0;
    gap: var(--space-2);
  }

  .booth-inner :global(.booth-form .form-label),
  .booth-inner :global(.booth-form .form-helper) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .booth-inner :global(.booth-form .form-input) {
    width: 100%;
    min-height: 48px;
    background: var(--color-bg);
    border-color: var(--color-bg);
  }

  .booth-inner :global(.booth-form .btn) {
    min-height: 48px;
    background: var(--color-bg);
    border-color: var(--color-bg);
    color: var(--color-hero-button-text);
    font-family: Manrope, 'PT Sans', system-ui, -apple-system, Roboto, Helvetica, Arial, sans-serif;
