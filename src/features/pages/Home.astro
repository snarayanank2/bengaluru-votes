---
/**
 * Home (`/`, `/kn/`) — information-architecture.md §3.1, PRD §5.1/§5.7.
 *
 * Renders through Base with TWO lookups side by side (`.finders`, stacked
 * below `md`): find your ward from an address, and find your polling booth
 * from a voter ID. They are boxed as a pair because they answer the same
 * question from whichever the citizen happens to have to hand — not because
 * they share any machinery; they share none.
 *
 * The ward form is a REAL `<form method="post">` — with JS disabled it POSTs back to
 * this same page and this file's `Astro.request.method === 'POST'` branch
 * below server-renders the result using the SAME resolution function the
 * `/api/ward-lookup` endpoint uses (`lookupWardByAddress` — imported
 * directly, never fetched). With JS enabled, `src/islands/WardLookup.ts`
 * intercepts the submit and calls the API instead, painting the result
 * inline without a page reload.
 *
 * The booth card is `src/components/BoothLookupForm.astro`, shared with
 * `/voting-guide/find-booth`. It is deliberately NOT a second mode of the
 * ward form beside it — one control, one question. Its `action` points at
 * `/voting-guide/find-booth`, so a no-JS submit finishes on that page rather
 * than here, and this file has no POST branch for it.
 *
 * CACHE-SAFETY: the GET render below never reads cookies/session and reads
 * app_settings only (src/lib/settings.ts — safe under the anonymous-page
 * micro-cache, see that file's header). The POST branch is a per-request
 * geocode lookup and is explicitly marked `cache-control: no-store`; it
 * never touches the GET response. The booth card adds nothing to this: it
 * never POSTs here, so no personal data from a booth lookup can ever reach
 * this page's cacheable render.
 */
import { eq } from 'drizzle-orm';
import Base from '../../layouts/Base.astro';
import Banner from '../../components/Banner.astro';
import DeadlineBanner from '../../components/DeadlineBanner.astro';
import Card from '../../components/Card.astro';
import BoothLookupForm from '../../components/BoothLookupForm.astro';
import FormField from '../../components/FormField.astro';
import Button from '../../components/Button.astro';
import { t, localePath, type Lang } from '../../i18n';
import { getSettings } from '../../lib/settings';
import { lookupWardByAddress } from '../../lib/geocode';
import { mapsConfig } from '../../lib/maps-config';
import { db } from '../../db/client';
import { wards } from '../../db/schema';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type WardRow = { id: number; nameEn: string; nameKn: string; corporation: string };

type LookupResult =
  | { result: 'ward'; ward: WardRow }
  | { result: 'out_of_coverage' }
  | { result: 'ambiguous' }
  | { result: 'unavailable'; reason: 'budget' | 'failed' };

let postResult: LookupResult | null = null;

// No-JS fallback path (see file header). Only ever runs for a POST; the GET
// render below is unaffected and stays cacheable.
//
// Address is the only input mode — pincode lookup was removed 2026-08-14.
// The reasoning, and the consequence (no fallback when geocoding is
// unavailable), is in the header of src/pages/api/ward-lookup.ts. This
// branch must keep mirroring that endpoint's result kinds exactly, since
// the two render the same four states.
if (Astro.request.method === 'POST') {
  Astro.response.headers.set('cache-control', 'no-store');

  const form = await Astro.request.formData();
  const query = String(form.get('query') ?? '').trim();

  if (query.length > 0) {
    const lookup = await lookupWardByAddress(query);
    switch (lookup.kind) {
      case 'ward': {
        const [row] = await db.select().from(wards).where(eq(wards.id, lookup.wardId));
        postResult = row ? { result: 'ward', ward: row } : { result: 'unavailable', reason: 'failed' };
        break;
      }
      case 'out_of_coverage':
        postResult = { result: 'out_of_coverage' };
        break;
      case 'ambiguous':
        postResult = { result: 'ambiguous' };
        break;
      case 'budget_exhausted':
        postResult = { result: 'unavailable', reason: 'budget' };
        break;
      case 'failed':
        postResult = { result: 'unavailable', reason: 'failed' };
        break;
    }
  } else {
    // Defensive only — the input carries `required`, so an empty query
    // should never reach here from a real browser submit.
    postResult = { result: 'unavailable', reason: 'failed' };
  }
}

const settings = await getSettings(['notification_date', 'election_date', 'roll_deadline']);

// Places Autocomplete on the lookup input (src/islands/WardLookup.ts). Same
// runtime-config discipline as the ward map: read here, handed over as a data
// attribute, never a build-time PUBLIC_* var — see src/lib/maps-config.ts.
// When maps are off the attribute is `undefined`, which Astro omits entirely,
// so the key never reaches the HTML and the island does nothing.
const maps = mapsConfig();
const notificationDate = settings.notification_date;
const electionDate = settings.election_date;
const rollDeadline = settings.roll_deadline;

const rollDeadlineActive = rollDeadline
  ? new Date(`${rollDeadline}T23:59:59Z`).getTime() >= Date.now()
  : false;

function wardHref(id: number): string {
  return localePath(lang, `/ward/${id}`);
}

function wardName(ward: WardRow): string {
  return lang === 'kn' ? ward.nameKn : ward.nameEn;
}
---

<Base
  lang={lang}
  title={t(lang, 'home.meta.title')}
  description={t(lang, 'home.meta.description')}
  path="/"
>
  <div class="home">
    <section class="finders">
      <Card>
        <h1>{t(lang, 'home.hero.heading')}</h1>
        <p class="subheading">{t(lang, 'home.hero.subheading')}</p>

        <form
          method="post"
          action={localePath(lang, '/')}
          class="ward-form"
          data-ward-lookup
          data-lang={lang}
          data-msg-ambiguous={t(lang, 'home.result.ambiguous')}
          data-msg-out-of-coverage={t(lang, 'home.result.outOfCoverage')}
          data-msg-unavailable={t(lang, 'home.result.unavailable')}
          data-msg-use-location={t(lang, 'home.form.useLocation')}
          data-msg-locating={t(lang, 'home.form.locating')}
          data-msg-location-approximate={t(lang, 'home.result.locationApproximate')}
          data-msg-location-denied={t(lang, 'home.result.locationDenied')}
          data-msg-location-unavailable={t(lang, 'home.result.locationUnavailable')}
          data-maps-key={maps.enabled ? maps.browserKey : undefined}
        >
          <FormField
            label={t(lang, 'home.form.label')}
            name="query"
            type="text"
            helper={t(lang, 'home.form.helper')}
            required
            lang={lang}
          />
          <Button type="submit" variant="primary" lang={lang}>
            {t(lang, 'home.form.submit')}
          </Button>

          <div class="ward-result" data-ward-result aria-live="polite">
            {postResult?.result === 'ward' && (
              <p>
                <a href={wardHref(postResult.ward.id)}>{wardName(postResult.ward)}</a>
              </p>
            )}
            {postResult?.result === 'out_of_coverage' && <p>{t(lang, 'home.result.outOfCoverage')}</p>}
            {postResult?.result === 'ambiguous' && <p>{t(lang, 'home.result.ambiguous')}</p>}
            {postResult?.result === 'unavailable' && <p>{t(lang, 'home.result.unavailable')}</p>}
          </div>
        </form>
      </Card>

      <Card>
        <h2>{t(lang, 'home.shortcuts.findBooth.title')}</h2>
        <p class="subheading">{t(lang, 'home.shortcuts.findBooth.description')}</p>
        <BoothLookupForm lang={lang} />
      </Card>
    </section>

    <section class="election-status">
      {!notificationDate ? (
        <Banner kind="notice" lang={lang}>
          {t(lang, 'home.election.awaited')}
        </Banner>
      ) : (
        notificationDate &&
        electionDate && (
          <Banner kind="notice" lang={lang}>
            {t(lang, 'home.election.status', { notificationDate, electionDate })}
          </Banner>
        )
      )}

      {rollDeadlineActive && rollDeadline && <DeadlineBanner deadlineISO={rollDeadline} lang={lang} />}
    </section>

    <section class="shortcuts">
      <Card>
        <h2>{t(lang, 'home.shortcuts.checkRegistration.title')}</h2>
        <p>{t(lang, 'home.shortcuts.checkRegistration.description')}</p>
        <Button href={localePath(lang, '/check-registration')} variant="secondary" lang={lang}>
          {t(lang, 'home.shortcuts.checkRegistration.title')}
        </Button>
      </Card>
      <Card>
        <h2>{t(lang, 'home.shortcuts.votingGuide.title')}</h2>
        <p>{t(lang, 'home.shortcuts.votingGuide.description')}</p>
        <Button href={localePath(lang, '/voting-guide')} variant="secondary" lang={lang}>
          {t(lang, 'home.shortcuts.votingGuide.title')}
        </Button>
      </Card>
    </section>
  </div>

  <script>
    import { initWardLookup } from '../../islands/WardLookup';
    import { initBoothLookup } from '../../islands/BoothLookup';
    initWardLookup();
    // The booth card's form (src/components/BoothLookupForm.astro). With JS
    // off it posts to /voting-guide/find-booth, which renders the same
    // result server-side.
    initBoothLookup();
  </script>
</Base>

<style>
  .home {
    max-width: var(--container-app);
    margin-inline: auto;
    padding: var(--space-8) var(--container-pad-x);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* The page's two entry points, side by side from `md` up and stacked
     below it (design-system §6.2: layouts are single-column below md). Equal
     columns, and the default `align-items: stretch` keeps the two boxes the
     same height so they read as one row of choices rather than two unrelated
     blocks — which is what they are: same question ("where do I vote, and
     what is my ward?"), two different things the citizen might have to hand,
     an address or their voter ID card. */
  .finders {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .finders {
      grid-template-columns: 1fr 1fr;
    }
  }

  .finders h1,
  .finders h2 {
    font-family: var(--font-heading);
    font-size: var(--text-3xl);
    line-height: var(--leading-3xl);
    margin: 0 0 var(--space-2);
  }

  .subheading {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }

  .ward-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* BoothLookupForm carries block margins for its own standalone page
     (/voting-guide/find-booth), where it sits between prose sections. In this
     card the heading above it supplies that spacing already. */
  .finders :global(.booth-form) {
    margin-block: 0;
  }

  /* Only paint the surface once there's an actual result. The container is
     a permanent aria-live region, and Astro leaves an indentation-whitespace
     text node inside it when the SSR result slots render nothing — so it is
     never truly `:empty`. Key off an element child instead (renderResult in
     WardLookup.ts always `replaceChildren`s in a <p>/<ul>/<a>), which the
     stray whitespace node doesn't satisfy. */
  .ward-result:has(> *) {
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  /* The two elements below are created by WardLookup.ts, not by this
     template, so they never carry Astro's scope attribute — `:global()` is
     what lets a scoped stylesheet reach them. Both mirror design-system.md
     §7.3's tertiary button and muted body text rather than inventing a look;
     they can't use Button.astro/its classes, since those are scoped too. */
  .ward-form :global(.ward-locate) {
    align-self: flex-start;
    min-height: 44px;
    padding: var(--space-2);
    border: 1.5px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-primary);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-base);
    cursor: pointer;
  }

  .ward-form :global(.ward-locate:hover),
  .ward-form :global(.ward-locate:focus-visible) {
    text-decoration: underline;
  }

  .ward-form :global(.ward-locate[disabled]) {
    color: var(--color-text-muted);
    cursor: not-allowed;
    text-decoration: none;
  }

  .ward-result :global(.ward-note) {
    margin: var(--space-2) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .election-status {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .shortcuts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
  }

  /* Shortcut-card contents (slotted into Card, so still in this component's
     scope). The card title sits a step below the hero h1 (text-xl vs
     text-3xl), and the heading/description/button get explicit vertical
     rhythm — Card itself is a bare container with no internal spacing. */
  .shortcuts h2 {
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
    margin: 0 0 var(--space-2);
  }

  .shortcuts p {
    margin: 0 0 var(--space-4);
  }
</style>
