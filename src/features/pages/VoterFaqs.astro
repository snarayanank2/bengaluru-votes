---
/**
 * Voter FAQs (`/voter-faqs`, `/kn/voter-faqs`) — the single public hub for
 * registration questions and the first-time voter checklist.
 */
import Prose from '../../layouts/Prose.astro';
import DeadlineBanner from '../../components/DeadlineBanner.astro';
import ExternalLinkOut from '../../components/ExternalLinkOut.astro';
import Card from '../../components/Card.astro';
import { localePath, t, type Lang } from '../../i18n';
import { getPageContent } from '../../i18n/content';
import { renderContentHtml, splitMarkdownSections } from '../../lib/render-content';
import { getSettings } from '../../lib/settings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const content = getPageContent(lang, 'voter-faqs');
if (!content) {
  throw new Error('VoterFaqs: missing content/pages/en/voter-faqs.md');
}

const sections = splitMarkdownSections(content.body);
const beforeLinkOut = sections.slice(0, 3).join('');
const afterLinkOut = sections.slice(3).join('');

const settings = await getSettings(['roll_deadline', 'roll_lookup_url']);
const rollDeadline = settings.roll_deadline;
const rollDeadlineActive = rollDeadline
  ? new Date(`${rollDeadline}T23:59:59Z`).getTime() >= Date.now()
  : false;

const steps: Array<{ labelKey: string; path: string }> = [
  { labelKey: 'votingGuide.steps.checkRoll', path: '/voter-faqs' },
  { labelKey: 'votingGuide.steps.enrolOrTransfer', path: '/voter-faqs#registration' },
  { labelKey: 'votingGuide.steps.findWard', path: '/' },
  { labelKey: 'votingGuide.steps.readCandidates', path: '/' },
  { labelKey: 'votingGuide.steps.findBooth', path: '/voter-faqs#polling-booth' },
  { labelKey: 'votingGuide.steps.vote', path: '/voter-faqs#voting-day' },
];
---

<Prose lang={lang} title={content.title} description={content.description} path="/voter-faqs">
  {rollDeadlineActive && rollDeadline && <DeadlineBanner deadlineISO={rollDeadline} lang={lang} />}

  <div class="faq-content" set:html={renderContentHtml(beforeLinkOut, lang)} />

  <ExternalLinkOut lang={lang} href={settings.roll_lookup_url} label={t(lang, 'checkRegistration.linkOut.label')} />

  <div class="faq-content" set:html={renderContentHtml(afterLinkOut, lang)} />

  <section class="steps" aria-labelledby="steps-heading">
    <h2 id="steps-heading">{t(lang, 'votingGuide.steps.heading')}</h2>

    <ol class="step-list">
      {steps.map((step, index) => (
        <li>
          <Card>
            <a href={localePath(lang, step.path)}>
              <span class="step-number" aria-hidden="true">{index + 1}</span>
              {t(lang, step.labelKey)}
            </a>
          </Card>
        </li>
      ))}
    </ol>
  </section>
</Prose>

<style>
  .faq-content :global(span[id]) {
    display: block;
    scroll-margin-top: 7rem;
  }

  .steps {
    margin-block-start: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .step-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }

  .step-list a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    font-weight: 700;
  }

  .step-number {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 28px;
    min-height: 28px;
    border-radius: var(--radius-full);
    background: var(--color-primary-surface);
    color: var(--color-primary);
    font-family: var(--font-heading);
  }
</style>
