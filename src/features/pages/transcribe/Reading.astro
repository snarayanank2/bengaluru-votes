---
/**
 * `/transcribe/{assignment-id}` — the reading screen.
 * The affidavit scan sits on the left and stays in view; the form on
 * the right scrolls. DESKTOP ONLY: the two must be side by side, so there
 * is no stacked layout for a phone.
 *
 * One group per field, with one explicit confirmation for the whole form.
 * All fields are validated and published together after confirmation.
 *
 * THE WARD IS READ-ONLY. A transcriber who could move a candidate could
 * choose their ward's work; a wrong ward goes to an admin through the
 * report section at the bottom.
 *
 * After a refused save the route twin passes `raw` — exactly what was
 * posted — and the form shows that instead of the published values, so
 * nothing the transcriber typed is lost.
 *
 * Works without JavaScript. src/islands/TranscribeForm.ts adds the running
 * assets total, greys out inputs when the answer is not a value, disables
 * Save until the confirmation is ticked (src/islands/GatedSubmit.ts; the
 * server re-checks the tick, and without the script the button stays usable
 * so nobody is locked out), counts down the hold with a warning at five
 * minutes and returns to Start on expiry.
 */
import TranscriberLayout from '../../../layouts/TranscriberLayout.astro';
import Banner from '../../../components/Banner.astro';
import Button from '../../../components/Button.astro';
import PublishConfirm from '../../../components/PublishConfirm.astro';
import VerificationLabel from '../../../components/VerificationLabel.astro';
import AffidavitFieldInputs from '../../../components/AffidavitFieldInputs.astro';
import AffidavitScan from '../../../components/AffidavitScan.astro';
import { t, type Lang } from '../../../i18n';
import { CSRF_FIELD_NAME } from '../../../lib/csrf';
import { CANDIDATE_PROFILE_LABEL_KEYS } from '../../../lib/candidate-profile';
import type { AffidavitFieldKey } from '../../../lib/affidavit-publish';
import { FIELD_INPUTS } from '../../../lib/affidavit-form';
import type { AssignmentView, FieldError, RawForm } from '../../../lib/transcribe';

interface Props {
  lang: Lang;
  csrfToken: string;
  view: AssignmentView;
  /** What was posted, after a refused save. */
  raw?: RawForm;
  errors: Partial<Record<AffidavitFieldKey, FieldError>>;
  formErrorKey?: string;
  reportNote: string;
}

const { lang, csrfToken, view, raw, errors, formErrorKey, reportNote } = Astro.props;

const action = `/transcribe/${view.assignmentId}`;
// Ward names are stored with their number in front ("11 - Old Baiyappanahalli"); it is shown once, beside the name.
const wardName = (lang === 'kn' ? view.ward.nameKn : view.ward.nameEn).replace(/^\d+\s*-\s*/, '');
const wardNumber = view.ward.id % 1000;
const minutesLeft = Math.max(0, Math.ceil((view.expiresAt.getTime() - Date.now()) / 60000));

const fields = view.fields.map((field) => {
  const status = raw?.status[field.key] ?? field.status;
  const inputs = Object.fromEntries(FIELD_INPUTS[field.key].map((name) => [name, raw?.inputs[name] ?? field.inputs[name] ?? '']));
  return {
    ...field,
    status,
    inputs,
    error: errors[field.key],
    label: t(lang, CANDIDATE_PROFILE_LABEL_KEYS[field.key]),
  };
});
---

<TranscriberLayout lang={lang} title={t(lang, 'transcribe.reading.meta.title')} description={t(lang, 'transcribe.reading.meta.description')}>
  <div class="reading">
    <AffidavitScan lang={lang} pdfUrl={view.pdfUrl} skipTo="work-panel" />

    <section class="panel" id="work-panel" tabindex="-1">
      <h1>{t(lang, 'transcribe.reading.heading')}</h1>

      <dl class="facts">
        <div>
          <dt>{t(lang, 'transcribe.reading.ward')}</dt>
          <dd>{t(lang, 'nav.ward', { wardNumber, wardName })}</dd>
        </div>
        <div>
          <dt>{t(lang, 'transcribe.reading.confidence')}</dt>
          <dd>{view.confidence === null ? t(lang, 'transcribe.reading.confidenceUnknown') : `${view.confidence}%`}</dd>
        </div>
        <div>
          <dt id="time-left-label">{t(lang, 'transcribe.reading.timeLeft')}</dt>
          <dd role="timer" aria-labelledby="time-left-label" data-expires-at={view.expiresAt.toISOString()} data-minutes-template={t(lang, 'transcribe.reading.minutes', { minutes: '{minutes}' })}>
            {t(lang, 'transcribe.reading.minutes', { minutes: minutesLeft })}
          </dd>
        </div>
      </dl>
      <p class="timer-warning" data-timer-warning data-warning-template={t(lang, 'transcribe.reading.timerWarning', { minutes: '{minutes}' })} hidden></p>
      <div class="sr-only" role="status" data-timer-announce></div>

      <p class="instructions">{t(lang, 'transcribe.reading.instructions')}</p>

      {
        formErrorKey && (
          <Banner kind="error" lang={lang}>
            {t(lang, formErrorKey)}
          </Banner>
        )
      }

      <form method="post" action={action} class="fields" id="transcribe-form" data-transcribe-form novalidate>
        <input type="hidden" name={CSRF_FIELD_NAME} value={csrfToken} />
        <input type="hidden" name="formAction" value="save" />

        {
          fields.map((field) => (
            <fieldset class:list={['field', { 'field--error': field.error }]} data-field={field.key}>
              <legend>
                <span class="field-name">{field.label}</span>
                <VerificationLabel lang={lang} aiExtracted={!field.checked} presentation="text" />
              </legend>

              <AffidavitFieldInputs lang={lang} fieldKey={field.key} status={field.status} inputs={field.inputs} error={field.error}>
                {field.note && (
                  <p class="ai-note">
                    <strong>{t(lang, 'transcribe.reading.aiNote')}</strong> {field.note}
                  </p>
                )}
              </AffidavitFieldInputs>
            </fieldset>
          ))
        }

      </form>

      <div class="other-actions">
        <form method="post" action={action} class="release">
          <input type="hidden" name={CSRF_FIELD_NAME} value={csrfToken} />
          <input type="hidden" name="formAction" value="release" />
          <Button type="submit" variant="secondary" lang={lang}>
            {t(lang, 'transcribe.reading.release')}
          </Button>
          <span class="help">{t(lang, 'transcribe.reading.releaseHelp')}</span>
        </form>

        <details class="disclosure report" open={reportNote !== '' || formErrorKey === 'transcribe.error.noteRequired'}>
          <summary>{t(lang, 'transcribe.reading.report.summary')}</summary>
          <div class="disclosure-body">
          <p class="help">{t(lang, 'transcribe.reading.report.help')}</p>
          <form method="post" action={action} class="report-form">
            <input type="hidden" name={CSRF_FIELD_NAME} value={csrfToken} />
            <input type="hidden" name="formAction" value="report" />
            <label class="input">
              <span>{t(lang, 'transcribe.reading.report.label')}</span>
              <textarea name="note" rows="3" maxlength="500">{reportNote}</textarea>
            </label>
            <Button type="submit" variant="secondary" lang={lang}>
              {t(lang, 'transcribe.reading.report.submit')}
            </Button>
          </form>
          </div>
        </details>
      </div>
    </section>
    <div class="save-bar">
      <PublishConfirm
        form="transcribe-form"
        lang={lang}
        compact
        name="confirmChecked"
        checked={raw?.confirmed ?? false}
        label={t(lang, 'transcribe.reading.tick')}
        hint={t(lang, 'transcribe.reading.saveNeedsTick')}
        submitLabel={t(lang, 'transcribe.reading.save')}
      />
    </div>
  </div>

  <script>
    import { initTranscribeForm } from '../../../islands/TranscribeForm';
    initTranscribeForm();
  </script>
</TranscriberLayout>

<style>
  /* Scan and form side by side, filling the viewport below the 56px bar.
     The page itself does not scroll: the scan stays put and only the form
     column scrolls, so a value being typed is always beside the page it is
     read from. The form column never drops below a workable width. */
  .reading {
    display: grid;
    grid-template-columns: minmax(0, 58fr) minmax(26rem, 42fr);
    /* The save bar spans both columns beneath them. */
    grid-template-rows: minmax(0, 1fr) auto;
    height: calc(100vh - 56px);
  }

  .panel {
    padding: var(--space-4) var(--space-4) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    min-width: 0;
    min-height: 0;
    overflow-y: auto;
  }

  /* A skip-link target: it takes focus so the next Tab lands on the first field. */
  .panel:focus {
    outline: none;
  }

  .panel h1 {
    margin: 0;
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
  }

  .facts {
    display: grid;
    /* The ward name is the long one. */
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-3);
    margin: 0;
  }

  .facts div {
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .timer-warning {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    background: var(--color-accent-surface);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .facts dt {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .facts dd {
    margin: 0;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .instructions {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .field {
    margin: 0;
    padding: var(--space-4);
    min-width: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .field--error {
    border-color: var(--color-danger);
  }

  .field legend {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0 var(--space-2);
    margin-left: calc(-1 * var(--space-2));
  }

  .field-name {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-lg);
  }

  .input {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .input > span {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .input input,
  .input select,
  .input textarea {
    min-height: 44px;
    width: 100%;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .input input:focus-visible,
  .input select:focus-visible,
  .input textarea:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 1px;
    border-color: var(--color-primary);
  }

  .input input:disabled,
  .input select:disabled {
    background: var(--color-surface);
    color: var(--color-text-muted);
  }

  .help {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .ai-note {
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
    font-size: var(--text-sm);
    overflow-wrap: anywhere;
  }

  /* Stays in view however long the form is. */
  /* A bar across the whole screen under the scan and the form, so the
     confirmation and Save share one row even where the form column is narrow. */
  .save-bar {
    grid-column: 1 / -1;
    padding: var(--space-1) var(--space-4);
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .other-actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .release {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .report .help {
    margin-top: var(--space-2);
  }

  .report-form {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .report-form .input {
    width: 100%;
  }
</style>
