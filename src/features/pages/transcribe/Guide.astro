---
/**
 * `/transcribe/guide` — what a transcriber is asked to do and the standard
 * they work to (docs/milestones.md §10.3, "a transcriber onboarding page").
 * Short on purpose: it is read once before the first shift and again when
 * a case is unclear.
 */
import TranscriberLayout from '../../../layouts/TranscriberLayout.astro';
import { t, type Lang } from '../../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const STEPS = ['1', '2', '3', '4', '5'];
const RULES = ['value', 'notDeclared', 'unreadable'];
---

<TranscriberLayout lang={lang} title={t(lang, 'transcribe.guide.meta.title')} description={t(lang, 'transcribe.guide.meta.description')}>
  <article class="guide">
    <p><a href="/transcribe">{t(lang, 'transcribe.guide.back')}</a></p>
    <h1>{t(lang, 'transcribe.guide.heading')}</h1>
    <p class="lead">{t(lang, 'transcribe.guide.lead')}</p>

    <h2>{t(lang, 'transcribe.guide.steps.heading')}</h2>
    <ol>
      {STEPS.map((step) => <li>{t(lang, `transcribe.guide.steps.${step}`)}</li>)}
    </ol>

    <h2>{t(lang, 'transcribe.guide.rules.heading')}</h2>
    <ul>
      {RULES.map((rule) => <li>{t(lang, `transcribe.guide.rules.${rule}`)}</li>)}
    </ul>

    <section class="never">
      <h2>{t(lang, 'transcribe.guide.never.heading')}</h2>
      <p>{t(lang, 'transcribe.guide.never.body')}</p>
    </section>

    <h2>{t(lang, 'transcribe.guide.assets.heading')}</h2>
    <p>{t(lang, 'transcribe.guide.assets.body')}</p>

    <h2>{t(lang, 'transcribe.guide.wrong.heading')}</h2>
    <p>{t(lang, 'transcribe.guide.wrong.body')}</p>
  </article>
</TranscriberLayout>

<style>
  .guide {
    max-width: 44rem;
    margin-inline: auto;
    padding-block: var(--space-8);
    padding-inline: var(--container-pad-x);
  }

  .guide h1 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: var(--space-2) 0 0;
  }

  .guide h2 {
    font-size: var(--text-lg);
    margin: var(--space-8) 0 var(--space-2);
  }

  .lead {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .guide li + li {
    margin-top: var(--space-2);
  }

  .never {
    margin-top: var(--space-8);
    padding: var(--space-4);
    background: var(--color-accent-surface);
    border-left: 4px solid var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .never h2 {
    margin-top: 0;
  }

  .never p {
    margin: 0;
  }
</style>
