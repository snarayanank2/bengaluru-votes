---
/**
 * Candidate corrections share one confirmation and atomic save for changed
 * report-card fields and ward. Status and affidavit ingestion live outside
 * this page; the affidavit remains visible alongside the inputs.
 */
import CuratorLayout from '../../../layouts/CuratorLayout.astro';
import Card from '../../../components/Card.astro';
import Banner from '../../../components/Banner.astro';
import Button from '../../../components/Button.astro';
import CuratorSplit from '../../../components/CuratorSplit.astro';
import CuratorFieldForm from '../../../components/CuratorFieldForm.astro';
import type { CandidateBatchRefusal } from '../../../lib/curator-fix';
import { t, type Lang } from '../../../i18n';
import { CSRF_FIELD_NAME } from '../../../lib/csrf';
import { CANDIDATE_PROFILE_LABEL_KEYS } from '../../../lib/candidate-profile';
import type { FieldError, RawField } from '../../../lib/affidavit-form';
import type { CandidateEditData } from '../../../lib/curator';
import type { WardOption } from '../../../lib/curator-fix';

interface Props {
  lang: Lang;
  csrfToken: string;
  wardId: number;
  wardNameEn: string;
  wardNameKn: string;
  candidate: CandidateEditData;
  /** Every ward, for the ward select; empty when there is no stored affidavit. */
  wards?: WardOption[];
  message?: { kind: 'notice' | 'error'; key: string };
  /** The form that was refused and what was posted into it. */
  refused?: { formAction: string; error?: FieldError; raw?: RawField };
  batchRefused?: CandidateBatchRefusal;
}

const { lang, csrfToken, wardId, wardNameEn, wardNameKn, candidate, wards = [], message, refused, batchRefused } = Astro.props;
const wardName = lang === 'kn' ? wardNameKn : wardNameEn;
const messageText = message ? t(lang, message.key) : undefined;

const confirmPath = `/ward/${wardId}`;

const pageHeading = t(lang, 'curator.candidateEdit.heading', { name: candidate.nameEn });
const pageTitle = t(lang, 'curator.candidateEdit.meta.title');
const pageDescription = t(lang, 'curator.candidateEdit.meta.description');
---

<CuratorLayout lang={lang} title={pageTitle} description={pageDescription}>
  <CuratorSplit lang={lang} pdfUrl={candidate.pdfUrl}>
    <p><a href="/curator">{t(lang, 'curator.candidateEdit.backToDashboard')}</a></p>
    <h1>{pageHeading}</h1>
    <p class="ward-line">{t(lang, 'curator.candidateEdit.wardLine', { ward: wardName })}</p>

    {
      messageText && (
        <Banner kind={message!.kind === 'error' ? 'error' : 'notice'} lang={lang}>
          {messageText}
        </Banner>
      )
    }

    {
      (
        <Card>
          <h2>{t(lang, 'curator.candidateEdit.fields.heading')}</h2>
          {candidate.pdfUrl ? (
            <form method="post" class="field-cards">
              <input type="hidden" name={CSRF_FIELD_NAME} value={csrfToken} />
              <input type="hidden" name="formAction" value="fields" />
              {candidate.fields.map((field) => {
                const formAction = `field:${field.key}`;
                const own = refused?.formAction === formAction;
                return (
                  <CuratorFieldForm
                    embedded
                    lang={lang}
                    csrfToken={csrfToken}
                    formAction={formAction}
                    field={field}
                    label={t(lang, CANDIDATE_PROFILE_LABEL_KEYS[field.key])}
                    confirmPath={confirmPath}
                    submitLabel={t(lang, 'curator.candidateEdit.field.submit')}
                    error={batchRefused?.errors[field.key] ?? (own ? refused?.error : undefined)}
                    raw={batchRefused?.raw[field.key] ?? (own ? refused?.raw : undefined)}
                  />
                );
              })}
              <div class="form-field">
                <label class="form-label" for="fix-ward">{t(lang, 'curator.fix.wardLabel')}</label>
                <select id="fix-ward" name="wardId" class="form-input" required>
                  {wards.map((ward) => <option value={ward.id} selected={String(ward.id) === (batchRefused?.wardId ?? String(candidate.wardId))}>{ward.label}</option>)}
                </select>
              </div>
              <label class="batch-confirm">
                <input type="checkbox" name="confirmPublish" required />
                <span>{t(lang, 'curator.candidateEdit.confirmChanges')}</span>
              </label>
              <Button type="submit" variant="primary" lang={lang}>{t(lang, 'curator.candidateEdit.field.submit')}</Button>
            </form>
          ) : candidate.waitingAffidavitId !== null ? (
            <p class="placeholder-note">
              {t(lang, 'curator.fix.affidavitWaiting')} <a href={`/curator/matching/${candidate.waitingAffidavitId}`}>{t(lang, 'curator.fix.affidavitWaitingLink')}</a>
            </p>
          ) : (
            <p class="placeholder-note">{t(lang, 'curator.candidateEdit.fields.needAffidavit')}</p>
          )}
        </Card>
      )
    }

  </CuratorSplit>
</CuratorLayout>

<style>
  .batch-confirm { display: flex; align-items: flex-start; gap: var(--space-2); font-weight: 700; cursor: pointer; }
  .batch-confirm input { width: 20px; height: 20px; flex: none; accent-color: var(--color-primary); }

  h1 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0;
  }

  h2 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
  }

  h3 {
    font-size: var(--text-base);
    margin: 0 0 var(--space-1);
  }

  .ward-line {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .meta {
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .form-helper {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .form-input {
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .field-cards {
    max-width: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .placeholder-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-style: italic;
  }

</style>
