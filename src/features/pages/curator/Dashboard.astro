---
/**
 * `/curator` (Task 34) — a curator's
 * home: the city-wide review-queue count, and how many affidavits wait to
 * be matched to a candidate and ward.
 *
 * No `/kn/` twin — curator/admin routes are internal tooling (noindex, see
 * src/middleware.ts), rendered in the signed-in user's OWN saved
 * `users.language` rather than derived from the URL (there is no `/kn/`
 * curator route to derive it from). See src/lib/curator.ts's
 * `loadCuratorLang`.
 *
 * SEARCH ("quick entry to edit candidates"): a GET form on `?q=` finds a
 * candidate by name and links to its editor.
 */
import CuratorLayout from '../../../layouts/CuratorLayout.astro';
import Button from '../../../components/Button.astro';
import Card from '../../../components/Card.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { wardLabel } from '../../../lib/ward-label';
import { t, type Lang } from '../../../i18n';
import { SEARCH_CAP, type DashboardData, type CuratorSearch } from '../../../lib/curator';

interface Props {
  lang: Lang;
  data: DashboardData;
  /** The query as typed, echoed back into the search box. */
  q: string;
  /** `undefined` = no search made, `null` = query too short. */
  search: CuratorSearch | null | undefined;
}

const { lang, data, q, search } = Astro.props;
const { queueCount, matchCount } = data;
---

<CuratorLayout lang={lang} title={t(lang, 'curator.dashboard.meta.title')} description={t(lang, 'curator.dashboard.meta.description')}>
  <div class="curator-page">
    <h1>{t(lang, 'curator.dashboard.heading')}</h1>

    <Card>
      <h2>{t(lang, 'curator.dashboard.queueHeading')}</h2>
      <p class="queue-count">{queueCount === 1 ? t(lang, 'curator.dashboard.queueCountOne') : t(lang, 'curator.dashboard.queueCount', { count: queueCount })}</p>
      <a class="body-link" href="/curator/queue">{t(lang, 'curator.dashboard.queueLink')}</a>
    </Card>

    <Card>
      <h2>{t(lang, 'curator.dashboard.matchHeading')}</h2>
      <p class="queue-count">{t(lang, 'curator.dashboard.matchCount', { count: matchCount })}</p>
      <a class="body-link" href="/curator/matching">{t(lang, 'curator.dashboard.matchLink')}</a>
    </Card>

    <Card>
      <h2>{t(lang, 'curator.dashboard.search.heading')}</h2>
      <form method="get" action="/curator" role="search" class="search-form">
        <label for="curator-search-q">{t(lang, 'curator.dashboard.search.label')}</label>
        <div class="search-row">
          <input id="curator-search-q" type="search" name="q" value={q} maxlength="100" class="form-input" />
          <Button type="submit" variant="primary" lang={lang}>{t(lang, 'curator.dashboard.search.submit')}</Button>
        </div>
      </form>

      {search === null && <p class="search-note">{t(lang, 'curator.dashboard.search.tooShort')}</p>}
      {search && search.candidates.length === 0 && <EmptyState fact={t(lang, 'curator.dashboard.search.none', { q: q.trim() })} />}
      {
        search && search.candidates.length > 0 && (
          <section class="search-results">
            <h3>{t(lang, 'curator.dashboard.search.candidates')}</h3>
            <ul>
              {search.candidates.map((c) => (
                <li>
                  <a class="body-link" href={`/curator/candidate/${c.id}`}>{c.nameEn}</a>
                  <span class="search-note">
                    {t(lang, 'curator.dashboard.search.candidateLine', {
                      party: c.partyEn,
                      ward: wardLabel(lang, { id: c.wardId, nameEn: c.wardNameEn, nameKn: c.wardNameKn }),
                      status: t(lang, `curator.candidateEdit.core.status.${c.status}`),
                    })}
                  </span>
                </li>
              ))}
            </ul>
            {search.capped && <p class="search-note">{t(lang, 'curator.dashboard.search.capped', { count: SEARCH_CAP })}</p>}
          </section>
        )
      }
    </Card>

    <p><a class="body-link" href="/curator/guide">{t(lang, 'curator.dashboard.guideLink')}</a></p>
  </div>
</CuratorLayout>

<style>
  .curator-page {
    max-width: var(--container-app);
    margin-inline: auto;
    padding-block: var(--space-8);
    padding-inline: var(--container-pad-x);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .curator-page h1 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0;
  }

  .curator-page h2 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
  }

  .queue-count {
    font-size: var(--text-xl);
    font-weight: 700;
    margin: 0 0 var(--space-2);
  }

  .search-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .search-row {
    display: flex;
    gap: var(--space-2);
  }

  .search-row input {
    flex: 1;
    min-width: 0;
  }

  .search-results h3 {
    font-size: var(--text-base);
    margin: var(--space-4) 0 var(--space-2);
  }

  .search-results ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .search-note {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .search-results li .search-note {
    margin-inline-start: var(--space-2);
  }
</style>
