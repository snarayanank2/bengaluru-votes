---
/**
 * `/curator/queue/{id}` — one flag, seen against the affidavit. The stored
 * PDF is on the left and stays in view (`CuratorSplit`); on the right, top
 * to bottom: what was flagged, what each citizen said, what is published
 * now, the fix, and the dismissal.
 *
 * THE FIX depends on the flagged field (`item.fix`): one of the seven
 * affidavit fields gets that field's structured inputs, the ward gets a
 * select of every ward, and anything else (a candidate with no stored
 * affidavit, a kind of flag that is no longer taken) can only be dismissed.
 * A candidate whose affidavit a transcriber sent back has none published:
 * the page points to it in Matching instead of asking for it again.
 * Dismissal is always offered on a pending item.
 *
 * CONFIRMATION (design-system.md §7.13: "destructive and publish actions
 * get confirmation dialogs stating scope"): both fix forms carry a required
 * checkbox naming the public path the change appears on — a no-JS
 * confirmation step, checked again server-side.
 *
 * After a refused fix the route twin passes `fixRaw` — exactly what was
 * posted — and the form shows that instead of the published value.
 */
import CuratorLayout from '../../../layouts/CuratorLayout.astro';
import Card from '../../../components/Card.astro';
import Badge from '../../../components/Badge.astro';
import type { BadgeVariant } from '../../../components/Badge.astro';
import Banner from '../../../components/Banner.astro';
import Button from '../../../components/Button.astro';
import CuratorSplit from '../../../components/CuratorSplit.astro';
import CuratorFieldForm from '../../../components/CuratorFieldForm.astro';
import CuratorWardForm from '../../../components/CuratorWardForm.astro';
import { t, type Lang } from '../../../i18n';
import { CSRF_FIELD_NAME } from '../../../lib/csrf';
import { profileLabelKey } from '../../../lib/candidate-profile';
import type { FieldError, RawField } from '../../../lib/affidavit-form';
import type { QueueItemDetail } from '../../../lib/curator';
import type { WardOption } from '../../../lib/curator-fix';

interface Props {
  lang: Lang;
  csrfToken: string;
  item: QueueItemDetail;
  /** Every ward, for the ward select; empty unless this is a ward flag. */
  wards: WardOption[];
  message?: { kind: 'notice' | 'error'; key: string };
  fixError?: FieldError;
  /** What was posted, after a refused field fix. */
  fixRaw?: RawField;
}

const { lang, csrfToken, item, wards, message, fixError, fixRaw } = Astro.props;
const messageText = message ? t(lang, message.key) : undefined;

const BADGE_VARIANT: Record<QueueItemDetail['status'], BadgeVariant> = {
  pending: 'flag-pending',
  accepted: 'flag-accepted',
  rejected: 'flag-rejected',
};

/** A citizen's source is whatever they typed: only a web address becomes a link, anything else is shown as text. */
const WEB_ADDRESS = /^https?:\/\//i;

const { candidate, fix } = item;
const isPending = item.status === 'pending';
const confirmPath = `/ward/${item.wardId}`;
const editorPath = candidate ? `/curator/candidate/${candidate.id}` : null;
// Ward names are stored with their number in front ("11 - Old Baiyappanahalli"); the line shows the name alone.
const candidateWard = candidate ? (lang === 'kn' ? candidate.wardNameKn : candidate.wardNameEn).replace(/^\d+\s*-\s*/, '') : null;
// Rows older than the eight-field rule name something that has no label: show the reference as stored.
const labelKey = profileLabelKey(item.fieldKey);
const fieldLabel = labelKey ? t(lang, labelKey) : item.targetRef;

const field = fix.kind === 'field' ? fix.field : null;
const publishedText = field
  ? (field.valueEn ??
    (field.status === 'not_declared'
      ? t(lang, 'common.notDeclared')
      : field.status === 'unreadable'
        ? t(lang, 'common.unreadable')
        : t(lang, 'curator.queueItem.published.none')))
  : null;
---

<CuratorLayout lang={lang} title={t(lang, 'curator.queueItem.meta.title')} description={t(lang, 'curator.queueItem.meta.description')}>
  <CuratorSplit lang={lang} pdfUrl={candidate?.pdfUrl ?? null}>
    <p class="back"><a href="/curator/queue">{t(lang, 'curator.queueItem.backToQueue')}</a></p>
    <h1>{t(lang, 'curator.queueItem.heading', { ward: lang === 'kn' ? item.wardNameKn : item.wardNameEn })}</h1>

    <p class="target-line">
      <Badge variant={BADGE_VARIANT[item.status]} lang={lang} />
      {candidate && <span>{t(lang, 'curator.queueItem.candidateLine', { name: candidate.nameEn, ward: candidateWard! })}</span>}
      <strong class="target-field">{fieldLabel}</strong>
    </p>
    {
      editorPath && (
        <p class="back">
          <a href={editorPath}>{t(lang, 'curator.queueItem.editCandidate')}</a>
        </p>
      )
    }

    {
      messageText && (
        <Banner kind={message!.kind === 'error' ? 'error' : 'notice'} lang={lang}>
          {messageText}
        </Banner>
      )
    }

    {
      !isPending && item.resolutionReason && (
        <Banner kind="notice" lang={lang}>
          {t(lang, 'curator.queueItem.resolutionReason', { reason: item.resolutionReason })}
        </Banner>
      )
    }

    <Card>
      <h2>{t(lang, 'curator.queueItem.submissions.heading')}</h2>
      <ul class="submissions-list">
        {item.submissions.map((submission) => (
          <li class="submission-card">
            <p class="detail">{submission.detail}</p>
            {submission.suggestedValue && (
              <p class="meta">
                {t(lang, 'curator.queueItem.submissions.suggestedValueLabel')}: {submission.suggestedValue}
              </p>
            )}
            {submission.sourceUrl && (
              <p class="meta">
                {t(lang, 'curator.queueItem.submissions.sourceLabel')}:{' '}
                {WEB_ADDRESS.test(submission.sourceUrl) ? (
                  <a href={submission.sourceUrl} target="_blank" rel="noopener noreferrer">
                    {submission.sourceUrl}
                  </a>
                ) : (
                  submission.sourceUrl
                )}
              </p>
            )}
            <p class="meta">{submission.createdAt.toISOString()}</p>
          </li>
        ))}
      </ul>
    </Card>

    {
      field && (
        <Card>
          <h2>{t(lang, 'curator.queueItem.published.heading')}</h2>
          <p class="published">{publishedText}</p>
          {(field.aiExtracted || field.checked) && (
            <p class="meta">{t(lang, field.checked ? 'curator.fix.badge.checked' : 'curator.fix.badge.ai')}</p>
          )}
        </Card>
      )
    }

    {
      isPending && fix.kind === 'field' && (
        <Card>
          <h2>{t(lang, 'curator.fix.heading')}</h2>
          <CuratorFieldForm
            lang={lang}
            csrfToken={csrfToken}
            formAction="fix"
            field={fix.field}
            label={fieldLabel}
            confirmPath={confirmPath}
            submitLabel={t(lang, 'curator.fix.submit')}
            error={fixError}
            raw={fixRaw}
          />
        </Card>
      )
    }

    {
      isPending && fix.kind === 'ward' && (
        <Card>
          <h2>{t(lang, 'curator.fix.wardHeading')}</h2>
          <CuratorWardForm
            lang={lang}
            csrfToken={csrfToken}
            formAction="fix"
            wards={wards}
            wardId={fix.wardId}
            confirmPath={confirmPath}
            submitLabel={t(lang, 'curator.fix.wardSubmit')}
          />
        </Card>
      )
    }

    {
      isPending && fix.kind === 'none' && (
        <Card>
          {candidate && candidate.waitingAffidavitId !== null ? (
            <>
              <p class="note">{t(lang, 'curator.fix.affidavitWaiting')}</p>
              <p class="note">
                <a href={`/curator/matching/${candidate.waitingAffidavitId}`}>{t(lang, 'curator.fix.affidavitWaitingLink')}</a>
              </p>
            </>
          ) : candidate && candidate.pdfUrl === null ? (
            <>
              <p class="note">{t(lang, 'curator.fix.noAffidavit')}</p>
              <p class="note">
                <a href={editorPath}>{t(lang, 'curator.fix.noAffidavitLink')}</a>
              </p>
            </>
          ) : (
            <p class="note">{t(lang, 'curator.fix.dismissOnly')}</p>
          )}
        </Card>
      )
    }

    {
      isPending && (
        <Card>
          <h2>{t(lang, 'curator.queueItem.reject.heading')}</h2>
          <form method="post" class="reject-form">
            <input type="hidden" name={CSRF_FIELD_NAME} value={csrfToken} />
            <input type="hidden" name="formAction" value="reject" />
            <div class="form-field">
              <label class="form-label" for="reject-reason">
                {t(lang, 'curator.queueItem.reject.reasonLabel')}
              </label>
              <textarea id="reject-reason" class="form-input" name="reason" required rows={3} />
            </div>
            <div>
              <Button type="submit" variant="destructive" lang={lang}>
                {t(lang, 'curator.queueItem.reject.submit')}
              </Button>
            </div>
          </form>
        </Card>
      )
    }
  </CuratorSplit>
</CuratorLayout>

<style>
  /* The page's column, its width and its scrolling belong to CuratorSplit;
     these are the pieces this page puts inside it. */
  h1 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0;
  }

  h2 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
  }

  .back {
    margin: 0;
  }

  .target-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .submissions-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .submission-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    overflow-wrap: anywhere;
  }

  .detail {
    margin: 0 0 var(--space-1);
  }

  .meta {
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .published {
    margin: 0 0 var(--space-1);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .note {
    margin: 0;
  }

  .note + .note {
    margin-top: var(--space-2);
  }

  .reject-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .form-input {
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
</style>
