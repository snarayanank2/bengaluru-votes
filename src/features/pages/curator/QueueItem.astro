---
/**
 * `/curator/queue/{id}` — one flag, seen against the affidavit. The stored
 * PDF is on the left and stays in view (`CuratorSplit`, which lets the
 * curator hide it); on the right, top to bottom: what was flagged, what is
 * published now, what each citizen said (numbered by position, never by
 * database id, each with its own "Mark as spam" tick), the fix, the
 * dismissal, and last the spam action for the ticked reports. The spam
 * button is enabled only while at least one report is ticked.
 *
 * THE FIX depends on the flagged field (`item.fix`): one of the seven
 * affidavit fields gets that field's structured inputs, the ward gets a
 * select of every ward, and anything else (a candidate with no stored
 * affidavit) can only be dismissed.
 * A candidate whose affidavit a transcriber sent back has none published:
 * the page points to it in Matching instead of asking for it again.
 * Dismissal is always offered on a pending item.
 *
 * CONFIRMATION (design-system.md §7.13: "destructive and publish actions
 * get confirmation dialogs stating scope"): both fix forms carry a required
 * checkbox naming the public path the change appears on — a no-JS
 * confirmation step, checked again server-side.
 *
 * After a refused fix the route twin passes `fixRaw` — exactly what was
 * posted — and the form shows that instead of the published value.
 */
import CuratorLayout from '../../../layouts/CuratorLayout.astro';
import Card from '../../../components/Card.astro';
import Badge from '../../../components/Badge.astro';
import type { BadgeVariant } from '../../../components/Badge.astro';
import Banner from '../../../components/Banner.astro';
import Button from '../../../components/Button.astro';
import CuratorSplit from '../../../components/CuratorSplit.astro';
import CuratorFieldForm from '../../../components/CuratorFieldForm.astro';
import CuratorWardForm from '../../../components/CuratorWardForm.astro';
import VerificationLabel from '../../../components/VerificationLabel.astro';
import { t, type Lang } from '../../../i18n';
import { CSRF_FIELD_NAME } from '../../../lib/csrf';
import { formatDateTime } from '../../../lib/format-datetime';
import { profileLabelKey } from '../../../lib/candidate-profile';
import { wardLabel } from '../../../lib/ward-label';
import type { FieldError, RawField } from '../../../lib/affidavit-form';
import type { QueueItemDetail } from '../../../lib/curator';
import type { WardOption } from '../../../lib/curator-fix';

interface Props {
  lang: Lang;
  csrfToken: string;
  item: QueueItemDetail;
  /** Every ward, for the ward select; empty unless this is a ward flag. */
  wards: WardOption[];
  message?: { kind: 'notice' | 'error'; key: string };
  fixError?: FieldError;
  /** What was posted, after a refused field fix. */
  fixRaw?: RawField;
}

const { lang, csrfToken, item, wards, message, fixError, fixRaw } = Astro.props;
const messageText = message ? t(lang, message.key) : undefined;

const BADGE_VARIANT: Record<QueueItemDetail['status'], BadgeVariant> = {
  pending: 'flag-pending',
  accepted: 'flag-accepted',
  rejected: 'flag-rejected',
};

/** A citizen's source is whatever they typed: only a web address becomes a link, anything else is shown as text. */
const WEB_ADDRESS = /^https?:\/\//i;

const { candidate, fix } = item;
// Reports are numbered by position in the whole list (20 to a page), never by database id.
const REPORTS_PER_PAGE = 20;
const firstReportNumber = (item.page - 1) * REPORTS_PER_PAGE + 1;
const hasSpamTargets = item.submissions.some((row) => !row.isSpam);
const isPending = item.status === 'pending';
const confirmPath = `/ward/${item.wardId}`;
const editorPath = candidate ? `/curator/candidate/${candidate.id}` : null;
const candidateWard = candidate ? wardLabel(lang, { id: candidate.wardId, nameEn: candidate.wardNameEn, nameKn: candidate.wardNameKn }) : null;
// A flag on "Other" reads with its own label; a key with no label (a row older than the eight-field rule) reads "Other", never the stored reference.
const isOther = item.targetType === 'candidate_other';
const labelKey = isOther ? 'flag.modal.otherLabel' : profileLabelKey(item.fieldKey);
const fieldLabel = labelKey ? t(lang, labelKey) : t(lang, 'curator.queue.fieldOther');

const field = fix.kind === 'field' ? fix.field : null;
const publishedText = field
  ? (field.valueEn ??
    (field.status === 'not_declared'
      ? t(lang, 'common.notDeclared')
      : field.status === 'unreadable'
        ? t(lang, 'common.unreadable')
        : t(lang, 'curator.queueItem.published.none')))
  : null;
---

<CuratorLayout lang={lang} title={t(lang, 'curator.queueItem.meta.title')} description={t(lang, 'curator.queueItem.meta.description')}>
  <CuratorSplit lang={lang} pdfUrl={candidate?.pdfUrl ?? null} collapsible>
    <header class="context">
      <a class="body-link" href="/curator/queue">{t(lang, 'curator.queueItem.backToQueue')}</a>
      <h1>{t(lang, 'curator.queueItem.heading', { ward: wardLabel(lang, { id: item.wardId, nameEn: item.wardNameEn, nameKn: item.wardNameKn }) })}</h1>
      <p class="target-line">
        <Badge variant={BADGE_VARIANT[item.status]} lang={lang} />
        {candidate && <span>{t(lang, 'curator.queueItem.candidateLine', { name: candidate.nameEn, ward: candidateWard! })}</span>}
        <strong class="target-field">{fieldLabel}</strong>
      </p>
      {editorPath && <a class="body-link" href={editorPath}>{t(lang, 'curator.queueItem.editCandidate')}</a>}
    </header>

    {
      messageText && (
        <Banner kind={message!.kind === 'error' ? 'error' : 'notice'} lang={lang}>
          {messageText}
        </Banner>
      )
    }

    {
      !isPending && item.resolutionReason && (
        <Banner kind="notice" lang={lang}>
          {t(lang, 'curator.queueItem.resolutionReason', { reason: item.resolutionReason })}
        </Banner>
      )
    }

    {
      field && (
        <Card>
          <h2>{t(lang, 'curator.queueItem.published.heading')}</h2>
          <p class="published">{publishedText}</p>
          {(field.aiExtracted || field.checked) && <VerificationLabel lang={lang} aiExtracted={!field.checked} presentation="text" />}
        </Card>
      )
    }

    <Card>
      <h2>{t(lang, 'flag.review.reports.heading')}</h2>
      {isPending && hasSpamTargets && <p class="meta">{t(lang, 'flag.review.reports.help')}</p>}
      <ul class="submissions-list">
        {item.submissions.map((submission, index) => (
          <li class="submission-card">
            <p class="report-head">
              <strong>{t(lang, 'flag.review.reportPosition', { n: firstReportNumber + index, total: item.totalSubmissions })}</strong>
              <span class="meta-inline">{formatDateTime(lang, submission.createdAt)}</span>
            </p>
            <p class="detail">{submission.detail}</p>
            {submission.suggestedValue && (
              <p class="meta">
                {t(lang, 'curator.queueItem.submissions.suggestedValueLabel')}: {submission.suggestedValue}
              </p>
            )}
            {submission.sourceUrl && (
              <p class="meta">
                {t(lang, 'curator.queueItem.submissions.sourceLabel')}:{' '}
                {WEB_ADDRESS.test(submission.sourceUrl) ? (
                  <a class="body-link" href={submission.sourceUrl} target="_blank" rel="noopener noreferrer">
                    {submission.sourceUrl}
                  </a>
                ) : (
                  submission.sourceUrl
                )}
              </p>
            )}
            {submission.isSpam ? (
              <p class="meta">{t(lang, 'flag.review.spam')}</p>
            ) : (
              isPending && (
                <label class="spam-tick">
                  <input type="checkbox" name="submissionId" value={submission.id} form="flag-spam-form" data-spam-tick />
                  <span>{t(lang, 'flag.review.markReportSpam')}</span>
                </label>
              )
            )}
          </li>
        ))}
      </ul>
      {
        (item.page > 1 || item.hasMore) && (
          <nav class="link-group report-pages" aria-label={t(lang, 'flag.review.pages')}>
            {item.page > 1 && <a href={`?page=${item.page - 1}`}>{t(lang, 'flag.review.previous')}</a>}
            {item.hasMore && <a href={`?page=${item.page + 1}`}>{t(lang, 'flag.review.next')}</a>}
          </nav>
        )
      }
    </Card>

    {
      (item.priorResolutions ?? []).length > 0 && (
        <Card>
          <h2>{t(lang, 'flag.review.previousResolutions')}</h2>
          <ul class="prior-list">
            {item.priorResolutions.map((previous) => (
              <li>
                <a class="body-link" href={`/curator/queue/${previous.id}`}>
                  {t(lang, previous.status === 'accepted' ? 'common.badge.flagAccepted' : 'common.badge.flagRejected')} · {previous.resolvedAt?.toISOString().slice(0, 10)}
                </a>
              </li>
            ))}
          </ul>
        </Card>
      )
    }
    {
      isPending && fix.kind === 'field' && (
        <Card>
          <h2>{t(lang, 'curator.fix.heading')}</h2>
          <CuratorFieldForm
            lang={lang}
            csrfToken={csrfToken}
            formAction="fix"
            field={fix.field}
            label={fieldLabel}
            confirmPath={confirmPath}
            submitLabel={t(lang, 'curator.fix.submit')}
            error={fixError}
            raw={fixRaw}
          />
        </Card>
      )
    }

    {
      isPending && fix.kind === 'ward' && (
        <Card>
          <h2>{t(lang, 'curator.fix.wardHeading')}</h2>
          <CuratorWardForm
            lang={lang}
            csrfToken={csrfToken}
            formAction="fix"
            wards={wards}
            wardId={fix.wardId}
            confirmPath={confirmPath}
            submitLabel={t(lang, 'curator.fix.wardSubmit')}
          />
        </Card>
      )
    }

    {
      isPending && fix.kind === 'none' && (
        <Card>
          {isOther ? (
            <>
              <p class="note">{t(lang, 'curator.fix.otherDismissOnly')}</p>
              {editorPath && (
                <p class="note">
                  <a class="body-link" href={editorPath}>{t(lang, 'curator.fix.otherEditorLink')}</a>
                </p>
              )}
            </>
          ) : candidate && candidate.waitingAffidavitId !== null ? (
            <>
              <p class="note">{t(lang, 'curator.fix.affidavitWaiting')}</p>
              <p class="note">
                <a class="body-link" href={`/curator/matching/${candidate.waitingAffidavitId}`}>{t(lang, 'curator.fix.affidavitWaitingLink')}</a>
              </p>
            </>
          ) : candidate && candidate.pdfUrl === null ? (
            <>
              <p class="note">{t(lang, 'curator.fix.noAffidavit')}</p>
              <p class="note">
                <a class="body-link" href={editorPath}>{t(lang, 'curator.fix.noAffidavitLink')}</a>
              </p>
            </>
          ) : (
            <p class="note">{t(lang, 'curator.fix.dismissOnly')}</p>
          )}
        </Card>
      )
    }

    {
      isPending && (
        <Card>
          <h2>{t(lang, 'curator.queueItem.reject.heading')}</h2>
          <form method="post" class="reject-form">
            <input type="hidden" name={CSRF_FIELD_NAME} value={csrfToken} />
            <input type="hidden" name="formAction" value="reject" />
            <div class="form-field">
              <label class="form-label" for="reject-reason">
                {t(lang, 'curator.queueItem.reject.reasonLabel')}
              </label>
              <textarea id="reject-reason" class="form-input" name="reason" required rows={3} />
            </div>
            <div>
              <Button type="submit" variant="destructive" lang={lang}>
                {t(lang, 'curator.queueItem.reject.submit')}
              </Button>
            </div>
          </form>
        </Card>
      )
    }

    {
      isPending && hasSpamTargets && (
        <Card>
          <h2>{t(lang, 'flag.review.spamSection.heading')}</h2>
          <form id="flag-spam-form" class="spam-form" method="post" data-spam-form>
            <input type="hidden" name={CSRF_FIELD_NAME} value={csrfToken} />
            <input type="hidden" name="formAction" value="spam" />
            <p class="meta">{t(lang, 'flag.review.spamSection.help')}</p>
            <div class="form-field">
              <label for="spam-reason" class="form-label">{t(lang, 'flag.review.spamReason')}</label>
              <input id="spam-reason" class="form-input" name="reason" required maxlength="1000" />
            </div>
            <div class="spam-action">
              <Button type="submit" variant="destructive" lang={lang} data-spam-submit>{t(lang, 'flag.review.markSpam')}</Button>
              <span class="meta" data-spam-hint hidden>{t(lang, 'flag.review.spamSection.needsSelection')}</span>
            </div>
          </form>
        </Card>
      )
    }
  </CuratorSplit>

  <script>
    import { initSpamSelection } from '../../../islands/SpamSelection';
    initSpamSelection();
  </script>
</CuratorLayout>

<style>
  .report-pages { margin-top: var(--space-4); }
  /* The page's column, its width and its scrolling belong to CuratorSplit;
     these are the pieces this page puts inside it. */
  h1 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0;
  }

  h2 {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-3);
  }

  .context {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .prior-list {
    margin: 0;
    padding-left: var(--space-4);
  }

  .report-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    margin: 0 0 var(--space-2);
  }

  .meta-inline {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* The whole row is the target (design-system §10). */
  .spam-tick {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 44px;
    margin-top: var(--space-2);
    font-weight: 700;
    cursor: pointer;
  }

  .spam-tick input {
    width: 22px;
    height: 22px;
    flex: none;
    margin: 0;
    accent-color: var(--color-primary);
  }

  .spam-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
  }

  .spam-action {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .target-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    overflow-wrap: anywhere;
  }

  .submissions-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .submission-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--space-3);
    overflow-wrap: anywhere;
  }

  .detail {
    margin: 0 0 var(--space-1);
  }

  .meta {
    margin: 0 0 var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .published {
    margin: 0 0 var(--space-1);
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .note {
    margin: 0;
  }

  .note + .note {
    margin-top: var(--space-2);
  }

  .reject-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 32rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .form-label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .form-input {
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-family: var(--font-body);
    color: var(--color-text);
    background: var(--color-bg);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-sm);
  }
</style>
