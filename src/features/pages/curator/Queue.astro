---
/**
 * `/curator/queue` (Task 34) — PENDING
 * flag_items, city-wide; this component just renders whatever
 * src/lib/curator.ts's `loadQueueList` hands it. See src/features/pages/curator/Dashboard.astro's docstring
 * for the language/noindex rationale shared by every curator page.
 */
import CuratorLayout from '../../../layouts/CuratorLayout.astro';
import { t, type Lang } from '../../../i18n';
import Banner from '../../../components/Banner.astro';
import { formatDateTime } from '../../../lib/format-datetime';
import { profileLabelKey } from '../../../lib/candidate-profile';
import type { QueueListItem, QueueSort } from '../../../lib/curator';

interface Props {
  lang: Lang;
  items: QueueListItem[];
  sort: QueueSort;
  page?: number;
  /** Set when the curator has just resolved a flag (`?resolved=`); shown as a confirmation. */
  resolved?: 'accepted' | 'rejected';
}

const { lang, items, sort, page = 1, resolved } = Astro.props;

/** "{candidate} — {field}" for a flag on a candidate's field; the reference as stored for anything older or orphaned. */
function targetLabel(item: QueueListItem): string {
  const labelKey = item.targetType === 'candidate_other' ? 'flag.modal.otherLabel' : profileLabelKey(item.fieldKey);
  return item.candidateNameEn && labelKey ? `${item.candidateNameEn} — ${t(lang, labelKey)}` : item.targetRef;
}
---

<CuratorLayout lang={lang} title={t(lang, 'curator.queue.meta.title')} description={t(lang, 'curator.queue.meta.description')}>
  <div class="curator-page">
    <h1>{t(lang, 'curator.queue.heading')}</h1>
    {
      resolved && (
        <Banner kind="notice" lang={lang}>
          {t(lang, resolved === 'accepted' ? 'curator.queue.resolved.accepted' : 'curator.queue.resolved.rejected')}
        </Banner>
      )
    }
    <p><a href="/curator">{t(lang, 'curator.queue.backToDashboard')}</a></p>

    <nav class="sort-nav" aria-label={t(lang, 'curator.queue.sort.label')}>
      <a href="?sort=recent" aria-current={sort === 'recent' ? 'true' : undefined}>
        {t(lang, 'curator.queue.sort.recent')}
      </a>
      <a href="?sort=ward" aria-current={sort === 'ward' ? 'true' : undefined}>
        {t(lang, 'curator.queue.sort.ward')}
      </a>
    </nav>

    {
      items.length === 0 ? (
        <p>{t(lang, 'curator.queue.empty')}</p>
      ) : (
        <table class="queue-table">
          <thead>
            <tr>
              <th>{t(lang, 'curator.queue.colWard')}</th>
              <th>{t(lang, 'curator.queue.colTarget')}</th>
              <th>{t(lang, 'curator.queue.colCount')}</th>
              <th>{t(lang, 'curator.queue.colCreated')}</th>
              <th />
            </tr>
          </thead>
          <tbody>
            {items.map((item) => (
              <tr>
                <td>{lang === 'kn' ? item.wardNameKn : item.wardNameEn}</td>
                <td>{targetLabel(item)}</td>
                <td>{item.submissionCount} · {t(lang, 'flag.review.spamCount', {count:item.spamCount ?? 0})}</td>
                <td>{formatDateTime(lang, item.createdAt)}</td>
                <td>
                  <a href={`/curator/queue/${item.id}`}>{t(lang, 'curator.queue.viewLink')}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
    <nav class="sort-nav" aria-label={t(lang,'flag.review.pages')}>
      {page>1 && <a href={`?sort=${sort}&page=${page-1}`}>{t(lang,'flag.review.previous')}</a>}
      {items.length===50 && <a href={`?sort=${sort}&page=${page+1}`}>{t(lang,'flag.review.next')}</a>}
    </nav>
  </div>
</CuratorLayout>

<style>
  .curator-page {
    max-width: var(--container-wide, 64rem);
    margin-inline: auto;
    padding-block: var(--space-8);
    padding-inline: var(--container-pad-x);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .curator-page h1 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0;
  }

  .sort-nav {
    display: flex;
    gap: var(--space-4);
  }

  .queue-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .queue-table th,
  .queue-table td {
    text-align: left;
    padding: var(--space-2);
    border-bottom: 1px solid var(--color-border);
  }

  .queue-table tbody tr:nth-child(odd) {
    background: var(--color-surface);
  }

  /* A raw target reference ("candidate:12:some_key") has no spaces to wrap at. */
  .queue-table td:nth-child(2) {
    overflow-wrap: anywhere;
  }

  /* On a phone the table is wider than the screen with the timestamp in it;
     the list is already in the chosen order, so that column is dropped. */
  @media (max-width: 599px) {
    .queue-table th:nth-child(4),
    .queue-table td:nth-child(4) {
      display: none;
    }
  }
</style>
