---
/**
 * `/curator/queue` (Task 34) — PENDING
 * flag_items, city-wide; this component just renders whatever
 * src/lib/curator.ts's `loadQueueList` hands it. See src/features/pages/curator/Dashboard.astro's docstring
 * for the language/noindex rationale shared by every curator page.
 */
import CuratorLayout from '../../../layouts/CuratorLayout.astro';
import { t, type Lang } from '../../../i18n';
import Banner from '../../../components/Banner.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { formatDateTime } from '../../../lib/format-datetime';
import { profileLabelKey } from '../../../lib/candidate-profile';
import { wardLabel } from '../../../lib/ward-label';
import type { QueueListItem, QueueSort } from '../../../lib/curator';

interface Props {
  lang: Lang;
  items: QueueListItem[];
  sort: QueueSort;
  page?: number;
  /** Set when the curator has just resolved a flag (`?resolved=`); shown as a confirmation. */
  resolved?: 'accepted' | 'rejected';
}

const { lang, items, sort, page = 1, resolved } = Astro.props;

/**
 * "{candidate} — {field}" for a flag on a candidate's field. A key with no
 * label (a flag on "Other", or a row older than the eight-field rule) is
 * shown as "Other", never as the stored reference.
 */
function targetLabel(item: QueueListItem): string {
  const labelKey = item.targetType === 'candidate_other' ? 'flag.modal.otherLabel' : profileLabelKey(item.fieldKey);
  const field = labelKey ? t(lang, labelKey) : t(lang, 'curator.queue.fieldOther');
  return item.candidateNameEn ? `${item.candidateNameEn} — ${field}` : field;
}
---

<CuratorLayout lang={lang} title={t(lang, 'curator.queue.meta.title')} description={t(lang, 'curator.queue.meta.description')}>
  <div class="curator-page">
    <h1>{t(lang, 'curator.queue.heading')}</h1>
    {
      resolved && (
        <Banner kind="notice" lang={lang}>
          {t(lang, resolved === 'accepted' ? 'curator.queue.resolved.accepted' : 'curator.queue.resolved.rejected')}
        </Banner>
      )
    }
    <p><a class="body-link" href="/curator">{t(lang, 'curator.queue.backToDashboard')}</a></p>

    <nav class="link-group" aria-label={t(lang, 'curator.queue.sort.label')}>
      <a href="?sort=recent" aria-current={sort === 'recent' ? 'true' : undefined}>
        {t(lang, 'curator.queue.sort.recent')}
      </a>
      <a href="?sort=ward" aria-current={sort === 'ward' ? 'true' : undefined}>
        {t(lang, 'curator.queue.sort.ward')}
      </a>
    </nav>

    {
      items.length === 0 ? (
        <EmptyState fact={t(lang, 'curator.queue.empty')} />
      ) : (
        <table class="staff-table queue-table">
          <caption class="sr-only">{t(lang, 'curator.queue.table.label')}</caption>
          <thead>
            <tr>
              <th scope="col">{t(lang, 'curator.queue.colWard')}</th>
              <th scope="col">{t(lang, 'curator.queue.colTarget')}</th>
              <th scope="col" class="num">{t(lang, 'curator.queue.colCount')}</th>
              <th scope="col">{t(lang, 'curator.queue.colCreated')}</th>
              <th scope="col"><span class="sr-only">{t(lang, 'curator.queue.colAction')}</span></th>
            </tr>
          </thead>
          <tbody>
            {items.map((item) => (
              <tr>
                <td>{wardLabel(lang, { id: item.wardId, nameEn: item.wardNameEn, nameKn: item.wardNameKn })}</td>
                <td>
                  {targetLabel(item)}
                  <span class="queue-when">{formatDateTime(lang, item.createdAt)}</span>
                </td>
                <td class="num">{item.submissionCount}<span class="queue-spam"><span class="queue-sep"> · </span>{t(lang, 'flag.review.spamCount', { count: item.spamCount ?? 0 })}</span></td>
                <td>{formatDateTime(lang, item.createdAt)}</td>
                <td>
                  <a class="body-link" href={`/curator/queue/${item.id}`}>{t(lang, 'curator.queue.viewLink')}</a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }
    {
      (page > 1 || items.length === 50) && (
        <nav class="link-group" aria-label={t(lang, 'flag.review.pages')}>
          {page > 1 && <a href={`?sort=${sort}&page=${page - 1}`}>{t(lang, 'flag.review.previous')}</a>}
          {items.length === 50 && <a href={`?sort=${sort}&page=${page + 1}`}>{t(lang, 'flag.review.next')}</a>}
        </nav>
      )
    }
  </div>
</CuratorLayout>

<style>
  .curator-page {
    max-width: var(--container-wide, 64rem);
    margin-inline: auto;
    padding-block: var(--space-8);
    padding-inline: var(--container-pad-x);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .curator-page h1 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0;
  }

  .queue-table td:nth-child(2) {
    overflow-wrap: anywhere;
  }

  /* On a phone the timestamp column is dropped to save width and the date
     moves under the flagged item instead, so no information is lost. */
  .queue-when {
    display: none;
  }

  /* Narrow screens: the table fits the viewport (Kannada labels are longer),
     every cell wraps, and the action column keeps a 44px target. */
  @media (max-width: 599px) {
    .queue-table {
      table-layout: fixed;
    }

    .queue-table td,
    .queue-table th {
      overflow-wrap: anywhere;
      padding-inline: var(--space-1);
    }

    .queue-table th:nth-child(3),
    .queue-table td:nth-child(3) {
      width: 6rem;
      white-space: normal;
    }

    /* The spam label drops under the count and wraps inside its cell, without the separator. */
    .queue-sep {
      display: none;
    }

    .queue-spam {
      display: block;
      color: var(--color-text-muted);
      font-weight: 400;
    }

    .queue-table th:nth-child(5),
    .queue-table td:nth-child(5) {
      width: 4rem;
    }

    .queue-table th:nth-child(4),
    .queue-table td:nth-child(4) {
      display: none;
    }

    .queue-when {
      display: block;
      color: var(--color-text-muted);
    }
  }
</style>
