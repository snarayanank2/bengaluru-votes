---
/**
 * `/curator/matching` — every affidavit the worker read but could not
 * publish, or a transcriber sent back, oldest first: why it waits, and the
 * name, ward and confidence as the AI read them. The name is the link to the
 * affidavit's own page (MatchItem.astro), where it is compared with the PDF
 * and confirmed.
 *
 * The table sits in its own focusable, named, horizontally scrolling region
 * (`ScrollRegion`), with a hint while it overflows, so on a phone the table
 * scrolls and the page does not. See Dashboard.astro's docstring
 * for the language and noindex rationale shared by every curator page.
 */
import CuratorLayout from '../../../layouts/CuratorLayout.astro';
import Badge from '../../../components/Badge.astro';
import Banner from '../../../components/Banner.astro';
import EmptyState from '../../../components/EmptyState.astro';
import ScrollRegion from '../../../components/ScrollRegion.astro';
import { t, type Lang } from '../../../i18n';
import type { MatchRow } from '../../../lib/affidavit-queue';

interface Props {
  lang: Lang;
  rows: MatchRow[];
  message?: { kind: 'notice' | 'error'; key: string };
}

const { lang, rows, message } = Astro.props;
---

<CuratorLayout lang={lang} title={t(lang, 'curator.matching.meta.title')} description={t(lang, 'curator.matching.meta.description')}>
  <div class="curator-page">
    <h1>{t(lang, 'curator.matching.heading')}</h1>
    <p class="intro">{t(lang, 'curator.matching.intro')}</p>

    {
      message && (
        <Banner kind={message.kind} lang={lang}>
          {t(lang, message.key)}
        </Banner>
      )
    }

    {
      rows.length === 0 ? (
        <EmptyState fact={t(lang, 'curator.matching.none')} />
      ) : (
        <ScrollRegion lang={lang} id="match-scroll" label={t(lang, 'curator.matching.table.label')}>
          <table class="staff-table match-table">
            <caption class="sr-only">{t(lang, 'curator.matching.table.label')}</caption>
            <thead>
              <tr>
                <th scope="col">{t(lang, 'curator.matching.colReason')}</th>
                <th scope="col">{t(lang, 'curator.matching.colName')}</th>
                <th scope="col">{t(lang, 'curator.matching.colWard')}</th>
                <th scope="col" class="num">{t(lang, 'curator.matching.colConfidence')}</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <td>
                    <Badge variant="flag-pending" lang={lang}>{t(lang, `curator.matching.reason.${row.reason}`)}</Badge>
                    {row.note && (
                      <p class="row-note">
                        <strong>{t(lang, 'admin.affidavits.match.transcriberNote')}</strong> {row.note}
                      </p>
                    )}
                  </td>
                  <td><a class="body-link" href={`/curator/matching/${row.id}`}>{row.nameRead ?? '—'}</a></td>
                  <td>{row.wardRead ?? t(lang, 'admin.affidavits.match.wardNotRead')}</td>
                  <td class="num">{row.confidence === null ? '—' : `${row.confidence}%`}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </ScrollRegion>
      )
    }
  </div>
</CuratorLayout>

<style>
  .curator-page {
    max-width: var(--container-app);
    margin-inline: auto;
    padding-block: var(--space-8);
    padding-inline: var(--container-pad-x);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .curator-page h1 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: 0;
  }

  .intro {
    margin: 0;
    max-width: var(--container-prose);
  }

  .match-table {
    min-width: 36rem;
  }

  .row-note {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }
</style>
