---
/**
 * `/curator/guide` — what a curator is asked to do and the standard they
 * work to. Read once before the first shift and again when a case is unclear.
 * Sections are short and listed in a contents list at the top. The rules for
 * entering a value (`FieldEntryRules`) and the account notes
 * (`StaffGuideBasics`) are shared with the transcriber guide, since both use
 * the same form. The screen's own verbs are used throughout: Reject, Fix and
 * publish, Move and publish, Confirm and publish, Save correction.
 */
import CuratorLayout from '../../../layouts/CuratorLayout.astro';
import FieldEntryRules from '../../../components/FieldEntryRules.astro';
import GuideContents from '../../../components/GuideContents.astro';
import StaffGuideBasics from '../../../components/StaffGuideBasics.astro';
import { t, type Lang } from '../../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const STEPS = ['1', '2', '3', '4', '5', '6'];
const MATCHING = ['1', '2', '3', '4', '5', '6'];
const contents = [
  { id: 'flags', label: t(lang, 'curator.guide.flags.heading') },
  { id: 'reason', label: t(lang, 'curator.guide.reason.heading') },
  { id: 'entering', label: t(lang, 'staff.entry.heading') },
  { id: 'ward', label: t(lang, 'curator.guide.ward.heading') },
  { id: 'matching', label: t(lang, 'curator.guide.matching.heading') },
  { id: 'profile', label: t(lang, 'curator.guide.profile.heading') },
  { id: 'notYours', label: t(lang, 'curator.guide.notYours.heading') },
  { id: 'contact', label: t(lang, 'curator.guide.contact.heading') },
  { id: 'basics', label: t(lang, 'staff.basics.heading') },
];
---

<CuratorLayout lang={lang} title={t(lang, 'curator.guide.meta.title')} description={t(lang, 'curator.guide.meta.description')}>
  <article class="guide">
    <p><a class="body-link" href="/curator">{t(lang, 'curator.guide.back')}</a></p>
    <h1>{t(lang, 'curator.guide.heading')}</h1>
    <p class="lead">{t(lang, 'curator.guide.lead')}</p>

    <GuideContents lang={lang} items={contents} />

    <section id="flags">
      <h2>{t(lang, 'curator.guide.flags.heading')}</h2>
      <ol>
        {STEPS.map((step) => <li>{t(lang, `curator.guide.flags.${step}`)}</li>)}
      </ol>
      <p>{t(lang, 'flag.review.guide')}</p>
    </section>

    <section id="reason">
      <h2>{t(lang, 'curator.guide.reason.heading')}</h2>
      <p>{t(lang, 'curator.guide.reason.body')}</p>
    </section>

    <FieldEntryRules lang={lang} />

    <section id="ward">
      <h2>{t(lang, 'curator.guide.ward.heading')}</h2>
      <p>{t(lang, 'curator.guide.ward.body')}</p>
    </section>

    <section id="matching">
      <h2>{t(lang, 'curator.guide.matching.heading')}</h2>
      <p>{t(lang, 'curator.guide.matching.intro')}</p>
      <ul>
        {MATCHING.map((item) => <li>{t(lang, `curator.guide.matching.${item}`)}</li>)}
      </ul>
    </section>

    <section id="profile">
      <h2>{t(lang, 'curator.guide.profile.heading')}</h2>
      <p>{t(lang, 'curator.guide.profile.body')}</p>
      <p>{t(lang, 'curator.guide.profile.fixUnreadable')}</p>
      <p>{t(lang, 'curator.guide.profile.limits')}</p>
    </section>

    <section id="notYours">
      <h2>{t(lang, 'curator.guide.notYours.heading')}</h2>
      <p>{t(lang, 'curator.guide.notYours.body')}</p>
    </section>

    <section id="contact">
      <h2>{t(lang, 'curator.guide.contact.heading')}</h2>
      <p>{t(lang, 'curator.guide.contact.body')}</p>
    </section>

    <StaffGuideBasics lang={lang} role="curator" />
  </article>
</CuratorLayout>

<style>
  .guide {
    max-width: 44rem;
    margin-inline: auto;
    padding-block: var(--space-8);
    padding-inline: var(--container-pad-x);
  }

  .guide h1 {
    font-size: var(--text-2xl);
    line-height: var(--leading-2xl);
    margin: var(--space-2) 0 0;
  }

  .guide :global(h2) {
    font-size: var(--text-lg);
    margin: var(--space-8) 0 var(--space-2);
    scroll-margin-top: var(--space-4);
  }

  .lead {
    margin-top: var(--space-3);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .guide :global(li + li) {
    margin-top: var(--space-2);
  }
</style>
